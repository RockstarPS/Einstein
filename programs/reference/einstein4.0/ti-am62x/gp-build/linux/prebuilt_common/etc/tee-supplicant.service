[Unit]
Description=TEE Supplicant

[Service]
Type=simple
EnvironmentFile=-/etc/default/tee-supplicant
ExecStart=/usr/sbin/tee-supplicant
Restart=always
StartLimitInterval=5min
StartLimitBurst=4
User=root
Group=root
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS2

[Install]
WantedBy=multi-user.target
