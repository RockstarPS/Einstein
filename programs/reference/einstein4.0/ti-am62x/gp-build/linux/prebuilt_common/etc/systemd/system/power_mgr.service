[Unit]
Description=Power manager
Before=ucl_proxy_vmf.service
After=vmf.service
Wants=vmf.service
DefaultDependencies=no

ConditionKernelCommandLine=|BOOT_MODE=PRI

[Service]
Type=simple
Environment="LD_LIBRARY_PATH=/usr/lib:$LD_LIBRARY_PATH"
ExecStart=/usr/bin/power_mgr
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target