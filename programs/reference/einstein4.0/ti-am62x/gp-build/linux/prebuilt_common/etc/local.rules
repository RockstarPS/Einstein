# There are a number of modifiers that are allowed to be used in some
# of the different fields. They provide the following subsitutions:
#
# %n the "kernel number" of the device.
#    For example, 'sda3' has a "kernel number" of '3'
# %e the smallest number for that name which does not matches an existing node
# %k the kernel name for the device
# %M the kernel major number for the device
# %m the kernel minor number for the device
# %b the bus id for the device
# %c the string returned by the PROGRAM
# %s{filename} the content of a sysfs attribute
# %% the '%' char itself
#

# Try and modprobe for drivers for new hardware
ACTION=="add", DEVPATH=="/devices/*", ENV{MODALIAS}=="?*", RUN{builtin}+="kmod load $env{MODALIAS}"

# 00-automotive-weston.rules
# Minimal udev rules for AM62P: Weston + Axiom touchscreen + serial getty

# --- DRM / GPU (Weston needs these)
SUBSYSTEM=="drm", KERNEL=="card*", MODE="0660", GROUP="video", TAG+="systemd", TAG+="seat"

# --- I2C for touch controllers / sensors (group for access)
KERNEL=="i2c-[0-9]*", MODE="0660", GROUP="i2c"

# --- GPIO character device (if used by HMI)
SUBSYSTEM=="gpio", MODE="0660", GROUP="gpio"

# --- Serial: GNSS UART / console getty
# keep serial device accessible to dialout and tagged for systemd
SUBSYSTEM=="tty", KERNEL=="ttyS*", MODE="0620", GROUP="dialout", TAG+="systemd"

# --- MMC: allow mmcblk* (boot + rootfs). No by-uuid/by-label probing here.
KERNEL=="mmcblk0*", MODE="0600", GROUP="disk", TAG+="systemd"

# --- Networking: preserve kernel-assigned names (do not rename)
SUBSYSTEM=="net", ACTION=="add", NAME="$name", TAG+="systemd"

# --- SPI
SUBSYSTEM=="spidev", KERNEL=="spidev[0-9]*.[0-9]*", MODE="0660", GROUP="spi"


