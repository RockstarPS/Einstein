			<_modifiedTimeWeak type="a">12.5.2023::6:14:47</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Sleep Manager component should be responsible for sending ready/refuse to sleep request from application perspective.</_text>
