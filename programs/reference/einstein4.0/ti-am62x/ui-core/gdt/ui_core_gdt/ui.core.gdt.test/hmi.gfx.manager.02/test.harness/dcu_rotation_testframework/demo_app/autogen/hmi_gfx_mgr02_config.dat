      /* pivot       */ {0.00000f,16.00000f}
   #endif
   }
   /* GFX_IMG_1BPP_ALPHANANIM_1*/
  ,{
      /* alpha                */ 255,
      /* base_id              */ 0,
      /* coord                */ {69,107},
      /* fg_color             */ 0xFF000000,
   #if defined(GFX_MGR02_OPEN_VG) || defined(GFX_MGR02_OPEN_GL) || defined(GFX_MGR02_FUJITSU) || defined(GFX_MGR02_AMBER) || defined(GFX_MGR02_AMBER_IRIS)
