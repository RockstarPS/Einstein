#if GFX_TOUCH_SCREEN_ENABLED > 0
      7                                                               , /* No of screen touch points      */
      lc_scr_call_active_tinfo_table_SA                               , /* Pointer to screen touch        */
#endif
   }
   /* GFX_SCR_BROWSE */
  ,{
      1                                                               , /* Priority of the screen        */
      {
         (GFX_WIDGET_CLIP_NONE|GFX_WIDGET_ALIGN_NONE)                 , /* Alignment type & Clip Mode */
         0                                                            , /* Inter element Space in Pixels */
         {
            24                                                        , /* number of elements in list    */
            lc_scr_browse_S                                             /* pointer to element list       */
         }
      },
#if GFX_TOUCH_SCREEN_ENABLED > 0
      20                                                              , /* No of screen touch points      */
      lc_scr_browse_tinfo_table_SA                                    , /* Pointer to screen touch        */
#endif
   }
};

/*                                                                             
** This data-structure will contain information about the layer configuration  
*/                                                                             

static COORDINATE_DEF_T lc_layer_0_coord;
static UINT8 l_layer_0_alpha_U8;
static SCREEN_ID_T l_layer_0_prio_A[NB_LAYER_0_SCREEN_PRIORITY];

LAYER_TABLE_T const lc_layer_table_S[NB_LAYERS] = 
{
   /* GFX_LAYER_0 */
   {
      400                                                             , /* Width of the layer            */
      240                                                             , /* Height of the layer           */
      3                                                               , /* Number of priorities in layer */
      GFX_ARGB8888                                                    , /* Pixel format of layer         */
      &lc_layer_0_coord                                               , /* Layer co-ordinate             */
      &l_layer_0_alpha_U8                                             , /* Pointer to layer alpha        */
      l_layer_0_prio_A                                                  /* Pointer to layer priority screen list */
   }
};

