#!gbuild
[Subproject]
	-I./driver/include
	-I./driver/include/autosar
	-I./driver/include/hweb/iar
	-I./driver/include/registers
	-I./driver/src
	-I./driver/utilities
	-I./utilities
	-Ospeed
	-OI
	-Olink
	-Ointerproc
	-Omax
	-Oiponesiteinlining
	-Onoiplimitinlining
	-DIRIS_REGISTER_BASE=0xB0100000
./driver/src/iris_cmdseq.c
./driver/src/iris_debug.c
./driver/src/iris_generic.c
./driver/src/iris_interrupt.c
./driver/src/iris_math.c
./driver/src/iris_sig.c
./driver/src/mml_gdc_display.c
./driver/src/mml_gdc_pixeng_ex.c
./driver/src/mml_gdc_pixeng_if.c
./driver/src/mml_gdc_surfman.c
./driver/src/util.c
./utilities/util_os/util_os.c
