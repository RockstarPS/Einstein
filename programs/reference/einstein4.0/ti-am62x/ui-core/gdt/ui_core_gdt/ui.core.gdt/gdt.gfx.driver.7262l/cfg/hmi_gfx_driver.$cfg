#ifdef HMI_GFX_DRIVER_C
/*
** Allocate the frame buffer memory and create the framebuffer pointer table
** static GFX_COLOR_T * const l_layer1_buffers_U8[NB_LAYERS][1] if double 
** buffering is disabled.
** static GFX_COLOR_T * const l_layer1_buffers_U8[NB_LAYERS][2] if double 
** buffering is enabled.
** NOTE!!!! Make sure the allocation happens with in #ifdef HMI_GFX_DRIVER_C
**          to prevent multiple memory allocations. Below allocation is for 
**			sample only. Modify this as necessary.
*/
#ifndef WIN32
  #pragma section _FrameBuffer_1
#endif
  /*
  ** Last four bits shall be zero per the address alignment requirement for the VDC
  */
  #define BUFFER0_ALIGNED_SIZE ((GFX_LAYER_0_MAX_W_LENGTH*GFX_LAYER_0_MAX_H_LENGTH) + \
                                (8-((GFX_LAYER_0_MAX_W_LENGTH*GFX_LAYER_0_MAX_H_LENGTH) & 0x03)))
  #define BUFFER1_ALIGNED_SIZE ((GFX_LAYER_1_MAX_W_LENGTH*GFX_LAYER_1_MAX_H_LENGTH) + \
                                (8-((GFX_LAYER_1_MAX_W_LENGTH*GFX_LAYER_1_MAX_H_LENGTH) & 0x03)))

  static GFX_COLOR_T l_l0_fb1_U8A[BUFFER0_ALIGNED_SIZE];
  static GFX_COLOR_T l_l0_fb2_U8A[BUFFER0_ALIGNED_SIZE];
  static GFX_COLOR_T l_l1_fb1_U8A[BUFFER1_ALIGNED_SIZE];
  static GFX_COLOR_T l_l1_fb2_U8A[BUFFER1_ALIGNED_SIZE];
#ifndef WIN32
  #pragma section
#endif

static GFX_COLOR_T * const l_layer_fb_pointer_table[NB_LAYERS][2] = 
{
   {l_l0_fb1_U8A , l_l0_fb2_U8A},
   {l_l1_fb1_U8A , l_l1_fb2_U8A}
};

#endif

