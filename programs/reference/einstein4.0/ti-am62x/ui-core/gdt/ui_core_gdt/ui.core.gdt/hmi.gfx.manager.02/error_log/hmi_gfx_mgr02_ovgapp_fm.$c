 **==========================================================================*/

/****************************************************************************
Function Name     : hmi_gfx_mgr02_fm_get_trials
Description       : Gives the status about whether sw trial count exceeds
                    or not.
Invocation	      : --
Parameters        : None
Return Type       : None.
******************************************************************************/
UINT16 hmi_gfx_mgr02_fm_get_trials(void)
{
  return l_sw_trial_limit_exceeds;
}
/****************************************************************************
Function Name     : hmi_gfx_mgr02_fm_init
Description       : OVG software recovery process initialization.
Invocation	      : Display init sequence handler
Parameters        : None
Return Type       : None.
******************************************************************************/
void hmi_gfx_mgr02_fm_init(void)
{
  l_sw_trial_limit_exceeds = FALSE;
  l_retry_count       = GFX_RETRY_COUNT; /* Try to do software recovery 3 times */
  l_g_OpenVG_state    = OPENVG_STATE_BAD;
  l_context_init_done = FALSE;
  hmi_gfx_mgr02_fault_cold_init();
}
/****************************************************************************
Function Name     : hmi_gfx_mgr02_fm_task
Description       : Context init and Graphicstask should call from the routine
                    It will handle the sw reovery feature when there is any
					OVG api's get failed.
Invocation	      : Graphics schedular task
Parameters        : None
Return Type       : None.
******************************************************************************/
void hmi_gfx_mgr02_fm_build_screen(void)
{  
   UINT8 fl_error_status;

#ifdef HMI_GFX_MGR02_FM_NP_OS
   if((l_retry_count > (UINT16)0) && (l_context_init_done == (UINT16)FALSE))
#else
   while((l_retry_count > (UINT16)0) && (l_context_init_done == (UINT16)FALSE))
#endif
   {
     l_retry_count--;
     hmi_gfx_mgr02_layout_ctx_init();
	 fl_error_status = hmi_gfx_mgr02_fault_check_critical_error();
	 if(fl_error_status != FALSE)
	 {
	   /* Something went wrong during "init" or "run" state hence shutdown the context.
	    * In this phase try to release as much memory as possible
	    * In other words keep note of error but don't prevent release routines from executing
	   */
       hmi_gfx_mgr02_layout_shutdown();
	   hmi_gfx_mgr02_fault_clearall();
	  #ifndef HMI_GFX_MGR02_FM_NP_OS
	    HMI_GFX_MGR02_FM_OS_SLEEP(50);  /* wait here for some time before trying for another trial to recover sw */
	  #endif
	 }
	 else
	 {
	   l_context_init_done      = TRUE;
	   l_g_OpenVG_state         = OPENVG_STATE_GOOD;
	 }
   }
   if(l_g_OpenVG_state == OPENVG_STATE_GOOD)
   {
	  hmi_gfx_mgr02_layout_build_screen();
	  fl_error_status = hmi_gfx_mgr02_fault_check_critical_error();
	  if(fl_error_status != FALSE)
	  {
	    l_context_init_done      = FALSE;
	    l_g_OpenVG_state         = OPENVG_STATE_BAD;
	    /* Something went wrong during "init" or "run" state hence shutdown the context.
	     * In this phase try to release as much memory as possible
	     * In other words keep note of error but don't prevent release routines from executing
	    */
        hmi_gfx_mgr02_layout_shutdown();
		hmi_gfx_mgr02_fault_clearall();
		#ifndef HMI_GFX_MGR02_FM_NP_OS
	      HMI_GFX_MGR02_FM_OS_SLEEP(50);  /* wait here for some time before trying for another trial to recover sw */
		#endif
	  }
	  else
	  {
	    l_retry_count	           = GFX_RETRY_COUNT;
	    l_sw_trial_limit_exceeds = FALSE;
	  }
   }
   if((l_retry_count == (UINT16)0) && (l_g_OpenVG_state == (UINT16)OPENVG_STATE_BAD))
   {
     /* set this flag when sw is still not recovered within limit count */
     /* There is no further recover possible except A5 reset */
     l_sw_trial_limit_exceeds = TRUE;
   }
}


