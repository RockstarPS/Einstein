/****************************************************************************
Function Name        : hmi_gfx_mgr02_imxrt_mem_mgmt_malloc()
Description          : Initializes internal data for first tme use
Invocation           : When ever generic context needs to be initialized
Return Value         : void * on sucess and NULL if can't able to allocate requested memory.
Critical Section     : None
Parameters           : IrisMemInfo
******************************************************************************/
void * hmi_gfx_mgr02_imxrt_mem_mgmt_malloc(PixEngMemInfo * p_meminfo)
{
    void * fl_ret_ptr = NULL;
    
    if (p_meminfo != NULL)
    {
        switch(p_meminfo->MemCateg)
        {
#ifdef GFX_MGR02_MEM_MGMT_STATIC_ALLOCATION
            /* Below Memory is allocated Statically at Compile time. 
            ** Below sample code is for HMI reference. Application
            ** team can allocates memory statically as per requirement and return its pointer value
            ** by checking p_meminfo->MemCateg (Refer enum IMXRT_MEM_CATEGORY)
            */
            case IMXRT_WIDGET_FRONT_RENDER_BUFFER:
            case IMXRT_WIDGET_BACK_RENDER_BUFFER:
            {
                fl_ret_ptr = hmi_gfx_mgr02_imxrt_mem_mgmt_get_idle_fb_ptr(p_meminfo);
            }
            break;
            case IMXRT_VGLITE_PATH_CMD_BUFFER:
            {
                fl_ret_ptr = (void*)&l_vglite_path_cmd[0];
            }
            break;
            case IMXRT_VGLITE_DRIVER_HEAP_MEM:
            {
                fl_ret_ptr = (void*)&l_vglite_driver_heap[0];
            }
            break;
#else
            /* Below Memory is Allocated Dynamically from heap at Runtime */
            case IMXRT_WIDGET_FRONT_RENDER_BUFFER:
            case IMXRT_WIDGET_BACK_RENDER_BUFFER:
            case IMXRT_VGLITE_PATH_CMD_BUFFER:
            case IMXRT_VGLITE_DRIVER_HEAP_MEM:
#endif    
            case IMXRT_LAYER_FRONT_RENDER_BUFFER:
            case IMXRT_LAYER_BACK_RENDER_BUFFER:
            case IMXRT_STRING_CACHE_BUFFER:
            case IMXRT_STRING_RENDER_BUFFER:
            case IMXRT_VGLITE_OS_HEAP_MEM:
            case IMXRT_VGLITE_FT2_HEAP_MEM:
            default:
            {
                #ifdef GFX_MGR02_USE_EXT_MEMORY_MANAGER
                fl_ret_ptr = hmi_gfx_mgr02_mem_config_alloc(p_meminfo->Size, p_meminfo->Alignment);
                #else 
                fl_ret_ptr = SDK_Malloc(p_meminfo->Size, p_meminfo->Alignment);
                #endif
            }    
            break;
        }
        
        if (fl_ret_ptr != NULL)
        {	
            memset(fl_ret_ptr, 0, p_meminfo->Size);
        }
    }
    return fl_ret_ptr;
}

/****************************************************************************
Function Name        : hmi_gfx_mgr02_imxrt_mem_mgmt_free
Description          : 
Invocation           : 
Return Value         : None
Critical Section     : None
Parameters           : None
******************************************************************************/
void hmi_gfx_mgr02_imxrt_mem_mgmt_free(void* pAddr)
{
    if(pAddr != NULL)
    {
        #ifdef GFX_MGR02_MEM_MGMT_STATIC_ALLOCATION
        if(GFX_MGR02_IS_MEM_ALLOC_FROM_HEAP(pAddr))
        #endif    
        {
            #ifdef GFX_MGR02_USE_EXT_MEMORY_MANAGER
            hmi_gfx_mgr02_mem_config_free(pAddr);
            #else
            SDK_Free(pAddr);
            #endif
        }
    }
}

#ifdef GFX_MGR02_MEM_MGMT_STATIC_ALLOCATION
/****************************************************************************
Function Name        : hmi_gfx_mgr02_imxrt_mem_mgmt_get_idle_fb_ptr
Description          : 
Invocation           : 
Return Value         : None
Critical Section     : None
Parameters           : None
******************************************************************************/
static void * hmi_gfx_mgr02_imxrt_mem_mgmt_get_idle_fb_ptr(PixEngMemInfo * p_meminfo)
{
    void *   fl_ret_ptr = NULL;
    uint8_t  fl_fb_group_id = p_meminfo->WidgetFBGroupId;
    
    if (fl_fb_group_id < GFX_NUM_OF_FB_GROUPS)
    {
        uint16_t fl_last_used_client_id = l_fb_groups_SA[fl_fb_group_id].lastUsedClientID;
            
        if (fl_last_used_client_id != GFX_MGR02_INVALID_CLIENT_ID)
        {
            void * fl_alloc_fb_ptr = hmi_gfx_mgr02_layout_get_front_fb(fl_last_used_client_id);
            if (fl_alloc_fb_ptr != NULL)
            {   
                if (fl_alloc_fb_ptr == l_fb_groups_SA[fl_fb_group_id].fb[1])
                {
                    fl_ret_ptr = (void*)l_fb_groups_SA[fl_fb_group_id].fb[0];
                }
                else if (fl_alloc_fb_ptr == l_fb_groups_SA[fl_fb_group_id].fb[0])
                {
                    fl_ret_ptr = (void*)l_fb_groups_SA[fl_fb_group_id].fb[1];
                }
                else
                {
                    /* To Avoid MISRA Warning */
                }
            }
        }    
        
        if (fl_ret_ptr == NULL)
        {
            if (p_meminfo->MemCateg == IMXRT_WIDGET_FRONT_RENDER_BUFFER)
            {
                fl_ret_ptr = (void*)l_fb_groups_SA[fl_fb_group_id].fb[1];
            }
            else /* (p_meminfo->MemCateg == IMXRT_WIDGET_BACK_RENDER_BUFFER) */
            {
                fl_ret_ptr = (void*)l_fb_groups_SA[fl_fb_group_id].fb[0];
            }
        }
        
        if (fl_ret_ptr != NULL)
        {
            l_fb_groups_SA[fl_fb_group_id].lastUsedClientID = (uint16_t)p_meminfo->WidgetClientId;
        }
    }
    return fl_ret_ptr;
}
#endif

