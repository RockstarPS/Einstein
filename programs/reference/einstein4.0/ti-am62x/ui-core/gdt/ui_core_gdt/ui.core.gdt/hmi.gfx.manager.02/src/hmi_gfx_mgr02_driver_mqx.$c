static LWEVENT_STRUCT l_buffer_swapped_ev;
static LWEVENT_STRUCT l_dma_pre_copy_ev;
static UINT32 l_swap_ev = 0;
static Dcu_Buffer_t dcu;
static void * l_cur_fb_ptr;
static UINT32 l_dma_channel;
