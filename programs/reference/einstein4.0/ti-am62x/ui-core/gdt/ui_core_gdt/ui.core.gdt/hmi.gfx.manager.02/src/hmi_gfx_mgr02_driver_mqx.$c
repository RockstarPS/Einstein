/*============================================================================
** Function Name:       void hmi_gfx_mgr02_driver_mqx_dcu_isr_event(void)
** Visibility:          Static function.
** Description:         Handler for the DCU vsync ISR event. During this event
**                      We execute the new buffer swapping to DCU layer
** Invocation:          By DCU driver
** Inputs/Outputs:      Swaps the buffer
** Critical Section:    None
** Created:             13/Nov/2015 EMANOJ1
** Updated:             13/Nov/2015 EMANOJ1
**==========================================================================*/
static void hmi_gfx_mgr02_driver_mqx_dcu_isr_event(Dcu_CallbackPara_t aPara)
{
	if(l_swap_ev != 0)
	{
       l_swap_ev = 0;
       if(l_cur_fb_ptr != 0)
       {
          Dcu_LayerSet(0, 1, DCU_FNC_LAYER_ADDRESS, (uint_32)l_cur_fb_ptr);
		  DCU_LayerEnable(1);
       }
       _lwevent_set(&l_buffer_swapped_ev, 1);
	}
}

/*============================================================================
** Function Name:       void hmi_gfx_mgr02_driver_mqx_dcu_init(void)
** Visibility:          Static function.
** Description:         DCU setup function
** Invocation:          By Graphics manager during initialization
** Inputs/Outputs:      Initialises the DCU and layer 0
** Critical Section:    None
** Created:             13/Nov/2015 EMANOJ1
** Updated:             21/Jan/2016 CSAKTHIV
**==========================================================================*/
void hmi_gfx_mgr02_driver_mqx_dcu_init(void)
{
    l_cur_fb_ptr = 0;
	l_dma_channel = 0;
    dcu.mWidth       = GFX_MGR02_LAYERS_MAX_WIDTH;
    dcu.mHeight      = GFX_MGR02_LAYERS_MAX_HEIGHT;
    dcu.mPixelFormat = DCU_BPP_32;
    dcu.mIsConst     = 0;
    dcu.mStride      = dcu.mWidth * 4;
    dcu.mAllocSize   = dcu.mHeight * dcu.mStride;
    dcu.mpByte       = 0;

    initDCU(0, GFX_MGR02_LAYERS_MAX_WIDTH, GFX_MGR02_LAYERS_MAX_HEIGHT);
    Dcu_Set(0, DCU_BLEND_ITER, 2);
    DCU_Enable();
	/* layer changed to 1 from o due to video*/
    DCU_LayerInit(&dcu, 1, 0, 0);
    Dcu_InstallInt(0, (Dcu_Event_t)0);
    _lwevent_create(&l_buffer_swapped_ev, LWEVENT_AUTO_CLEAR);
    _lwevent_create(&l_dma_pre_copy_ev, LWEVENT_AUTO_CLEAR);
    Dcu_EventCallbackSet(0, DCU_EVENT_VBLANK, hmi_gfx_mgr02_driver_mqx_dcu_isr_event, (Dcu_CallbackPara_t)0);
    Dcu_EnableInt(0, DCU_EVENT_VBLANK);
    (void)edma_channel_create(&l_dma_channel, DMA_REQ_NULL);
    (void)edma_channel_set_callback(l_dma_channel,hmi_gfx_mgr02_ovglib_pre_copy_fb_dma_callback, 0);
}

/*============================================================================
** Function Name:       void hmi_gfx_mgr02_driver_mqx_dcu_shutdown(void)
** Visibility:          Static function.
** Description:         DCU shutdown function
** Invocation:          By Graphics manager during shutdown
** Inputs/Outputs:      Deinitialises the DCU and layer 0
** Critical Section:    None
** Created:             13/Nov/2015 EMANOJ1
** Updated:             13/Nov/2015 EMANOJ1
**==========================================================================*/
void hmi_gfx_mgr02_driver_mqx_dcu_shutdown(void)
{
   _lwevent_destroy(&l_buffer_swapped_ev);
   _lwevent_destroy(&l_dma_pre_copy_ev);
   (void)edma_channel_stop(l_dma_channel);
   (void)edma_channel_destroy(l_dma_channel);
}

/*============================================================================
** Function Name:       void hmi_gfx_mgr02_driver_mqx_dcu_swap_layer(void)
** Visibility:          Static function.
** Description:         Triggers a swap layer operation and waits until its 
**                      completion or timeout has elapsed.  
** Invocation:          By Graphics manager during buffer swap
** Inputs/Outputs:      None
** Critical Section:    None
** Created:             13/Nov/2015 EMANOJ1
** Updated:             13/Nov/2015 EMANOJ1
**==========================================================================*/
void hmi_gfx_mgr02_driver_mqx_dcu_swap_layer(void)
{
   TIME_STRUCT     tm;
   MQX_TICK_STRUCT to;
   
   l_cur_fb_ptr = (void *)hmi_gfx_mgr02_context_swap_layer(0x00u);
   memset(&to, 0, sizeof(to));
   _time_get(&tm);
   tm.MILLISECONDS += (16 * 3); /* wait for 3 vsync period maximum */
   _time_to_ticks(&tm, &to);

   l_swap_ev = 1;
   if(_lwevent_wait_for(&l_buffer_swapped_ev, 1, TRUE, &to) != MQX_OK)
   {
      /*
      ** Swap event failed..
      */
      l_swap_ev = 0;
   }
}
/*============================================================================
**
** Function Name:       hmi_gfx_mgr02_driver_mqx_request_dma_trasnfer
** Visibility:          Global
** Description:         Interface to trigger DMA transfer using MQX dma driver.
** Invocation:          
** Inputs/Outputs:      src address,dst address,no of bytes
** Critical Section:    None
** Created:             15/MAR/2016 CSAKTHIV
** Updated:             
**
**==========================================================================*/
void hmi_gfx_mgr02_driver_mqx_request_dma_trasnfer(UINT32 fl_dma_dst,UINT32 fl_dma_src,UINT32 fl_nbytes)
{

   DMA_CONFIG_STRUCT   fl_pre_copy_dma_config;
   DMA_PACKET_STRUCT   fl_pre_copy_packet;
   TIME_STRUCT         tm;
   MQX_TICK_STRUCT     to;

      
   edma_channel_get_config(l_dma_channel, &fl_pre_copy_dma_config);

   fl_pre_copy_dma_config.transfer_direction = DMA_DIRECTION_MEM_TO_MEM;
   fl_pre_copy_dma_config.read_width         = DMA_ACCESS_WIDTH_32BIT;
   fl_pre_copy_dma_config.write_width        = DMA_ACCESS_WIDTH_32BIT;
   fl_pre_copy_dma_config.src_periph_addr    = 0;
   fl_pre_copy_dma_config.dst_periph_addr    = 0;
      
   edma_channel_quick_config(l_dma_channel, fl_pre_copy_dma_config);

   fl_pre_copy_packet.src = (UINT32)fl_dma_src;
   fl_pre_copy_packet.dst = (UINT32)fl_dma_dst;
   fl_pre_copy_packet.size_per_request = fl_nbytes;		/* Minor count */
   fl_pre_copy_packet.count = 1;   /* Major count */
   fl_pre_copy_packet.usr_private = (UINT32)fl_dma_dst;

   edma_channel_push_transfer_packet(l_dma_channel, fl_pre_copy_packet);
   memset(&to, 0, sizeof(to));
   _time_get(&tm);
   tm.MILLISECONDS += (3 * 100); /* wait for 1 vsync period maximum */
   _time_to_ticks(&tm, &to);

   edma_channel_start(l_dma_channel);

   _lwevent_wait_for(&l_dma_pre_copy_ev, 1, TRUE, &to);

}
/*============================================================================
**
** Function Name:       hmi_gfx_mgr02_ovglib_pre_copy_fb_dma_callback
** Visibility:          Static function.
** Description:         callback for DMA transfer
** Invocation:          
** Inputs/Outputs:      
** Critical Section:    None
** Created:             15/MAR/2016 CSAKTHIV
** Updated:             
**
**==========================================================================*/
static void hmi_gfx_mgr02_ovglib_pre_copy_fb_dma_callback(void *arg, UINT32 dwparam, UINT16 status)
{
    switch (status)
    {
    case DMA_EVENT_TRANSFER_ONE:
        break;
    case DMA_EVENT_TRANSFER_DONE:
        _lwevent_set(&l_dma_pre_copy_ev, 1);
        break;
    case DMA_EVENT_ERROR:
    default:
        break;
    }
}

