/* ===========================================================================
** Name:            GFX_DRIVER_USE_DOUBLE_BUFFERING
** Description:     Enable or Disable double buffering by setting GFX_DRIVER_USE_DOUBLE_BUFFERING
**                  to YES or NO respectively.
** Template:        #define GFX_DRIVER_USE_DOUBLE_BUFFERING  'NO or YES to disable or enable'
** =========================================================================*/
#define GFX_DRIVER_USE_DOUBLE_BUFFERING   (NO)

/* ===========================================================================
** Name:            GFX_DRIVER_START_LCD_UPDATE
** Description:     Assign a handler function to transfer the frame buffer for 
**                  the passed layer to LCD display. Use the "layer" parameter 
**                  only if NB_LAYERS > 1
** Template:        #define GFX_DRIVER_START_LCD_UPDATE  'handler function'
** =========================================================================*/
#define GFX_DRIVER_START_LCD_UPDATE(layer, fb_pointer)	hmi_disp_drv_data_update(fb_pointer)

/* ===========================================================================
** Name:            GFX_DRIVER_CUSTOM_TEXT_RENDERING
** Description:     Define this macro to > 0 to override default font rendering
**                  of the driver.
** Template:        #define GFX_DRIVER_CUSTOM_TEXT_RENDERING  'NO or YES'
** =========================================================================*/
#define GFX_DRIVER_CUSTOM_TEXT_RENDERING  (NO)

/* ===========================================================================
** Name:            GFX_DRIVER_WAIT_SCHEDULING
**					GFX_DRIVER_WAIT_THRESHOLD_COUNT and
**					GFX_DRIVER_EXECUTE_EVENT_WAIT
** Description:     Enable or disable wait implementation. This allows the 
**                  operating system to service other task while the driver
**                  is building the frame buffer. Since frame buffer building 
** 					can take longer time (in milliseconds), it can affect the 
**                  system performance if the display building is done using a 
**                  blocking task. The wait implementation can run a loop counter
**                  and once reaching a set threshold (GFX_DRIVER_WAIT_THRESHOLD_COUNT)
**                  it can make a call to appropriate os_wait 
**                  (HMI_GFX_DRIVER_EXECUTE_EVENT_WAIT) function to transfer 
**                  control to OS to schedule other tasks. 
** Template:        #define GFX_DRIVER_WAIT_SCHEDULING        'NO or YES'
**                  #define GFX_DRIVER_WAIT_THRESHOLD_COUNT   <number of counts>
					#define GFX_DRIVER_EXECUTE_EVENT_WAIT     <os wait handler function>
** =========================================================================*/
#define GFX_DRIVER_WAIT_SCHEDULING		(NO)
#define GFX_DRIVER_WAIT_THRESHOLD_COUNT	(500)
#define GFX_DRIVER_EXECUTE_EVENT_WAIT   (os_wait)

/* Define the below macro only if buffer locking is to be done after DriverEndUpdate */s
//#define DISABLE_BUFFER_LOCK NO

/* ===========================================================================
** Name:            GFX_DRIVER_NEED_BMP_CLIPPING
** Description:     Enable or Disable support for clipping of 
**                  images. This is required to perform clipping and scrolling
**                  functionality for text display.
** Template:        #define GFX_DRIVER_NEED_BMP_CLIPPING 'NO or YES'
** =========================================================================*/
#define GFX_DRIVER_NEED_BMP_CLIPPING (NO)


/* ===========================================================================
** Horizontal scan is supported for 4BPP only.  
** This configuration is not supported for RLE compressed images.
GFX_DRIVER_NEED_HORIZONTAL_SCAN macro will be defined in tool generated files.
If the GFX_HOR_SCAN_BUILD_TEXT macro value is YES, then gfx core will build the
text. If the value is NO, then gfx core will not build the text.  Open vg driver
need to build the text.                                                     */
** =========================================================================*/
#ifdef GFX_DRIVER_NEED_HORIZONTAL_SCAN
#define GFX_HOR_SCAN_BUILD_TEXT(pc_text_prop_SP,pc_dyn_text_def_SP)       YES          
#endif

