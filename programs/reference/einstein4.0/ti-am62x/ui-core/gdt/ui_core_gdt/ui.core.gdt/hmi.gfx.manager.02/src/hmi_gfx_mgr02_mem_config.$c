extern char gfx_heap_begin_addr[];
extern char gfx_heap_end_addr[];

static GFX_MGR02_MEM_MGMT_HEAP_HANDLE g_heapHandle = NULL;

/*============================================================================
 ** F U N C T I O N  D E F I N I T I O N S
 **==========================================================================*/
 
GFX_ERROR hmi_gfx_mgr02_mem_config_init(void)
{
    GFX_ERROR ret = GFX_OK;
    UINT32 dynamic_heap_Size = GFX_MGR02_HEAP_SIZE;
    UINT32 dynamic_baseAddress = (UINT32)gfx_heap_begin_addr;

    if(dynamic_heap_Size > (UINT32)0)
    {
        if(g_heapHandle != NULL)
        {
           (void)hmi_gfx_mgr02_mem_mgmt_destroy_heap(g_heapHandle);
           g_heapHandle = NULL;
        }
        ret = hmi_gfx_mgr02_mem_mgmt_create_heap(&g_heapHandle, dynamic_heap_Size, dynamic_baseAddress );
    }
    return ret;
}

void * hmi_gfx_mgr02_mem_config_alloc(UINT32 size, UINT32 alignment)
{
    UINT32 ulRet = 0;
    GFX_ERROR ret;

    ret = hmi_gfx_mgr02_mem_mgmt_heap_alloc(g_heapHandle, size, alignment, &ulRet);
    
    if(ret != GFX_OK)
    {
        #ifdef GFX02_DEBUG_INFO
        printf("[ERROR] hmi_gfx_mgr02_mem_config_alloc(): failed to allocate %d bytes\n", size);
        #endif
        ulRet = (UINT32)0;
    }
    
    return (void *)ulRet;
}

void * hmi_gfx_mgr02_mem_config_calloc( UINT32 size, UINT32 alignment )
{
    UINT32 ulRet = 0;
    GFX_ERROR ret;

    ret = hmi_gfx_mgr02_mem_mgmt_heap_alloc(g_heapHandle, size, alignment, &ulRet);
  
    if (GFX_OK == ret)
    {
        if (ulRet != (UINT32)0)
        {
            /* calloc has to initialize the memory with zeros */
            (void)memset((void *)ulRet, 0, size);
        }
    }
    else
    {
        #ifdef GFX02_DEBUG_INFO
        printf("[ERROR] hmi_gfx_mgr02_mem_config_calloc(): failed to allocate %d bytes\n", size);
        #endif
        ulRet = (UINT32)0;
    }

    return (void *)ulRet;
}

void hmi_gfx_mgr02_mem_config_free(void* addr)
{
    GFX_ERROR ret;
    ret = hmi_gfx_mgr02_mem_mgmt_heap_free(g_heapHandle, addr);
    if (ret != GFX_OK)
    {
        #ifdef GFX02_DEBUG_INFO
        (void)printf("[ERROR] hmi_gfx_mgr02_mem_config_free(): failed to free memory at %p!\n", addr);
        #endif
    }
}

void * hmi_gfx_mgr02_mem_config_realloc( UINT32 size, UINT32 alignment, UINT32 *pAddr )
{
    UINT32 ulRet = 0;
    GFX_ERROR ret;
    ret = hmi_gfx_mgr02_mem_mgmt_heap_realloc(g_heapHandle, size, alignment, &ulRet, pAddr);
    
    if (GFX_OK != ret)
    {
        #ifdef GFX02_DEBUG_INFO
        (void)printf("[ERROR] hmi_gfx_mgr02_mem_config_realloc(): failed to allocate %d bytes\n", size);
        #endif
        ulRet = (UINT32)0;
    }

    return (void *)ulRet;
}

