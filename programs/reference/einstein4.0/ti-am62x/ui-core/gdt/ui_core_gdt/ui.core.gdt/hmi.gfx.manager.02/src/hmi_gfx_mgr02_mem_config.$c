static MML_MMAN_HEAP_HANDLE g_heapHandle = NULL;
/*============================================================================
 ** E N T R Y   P O I N T S  /  D A T A   A C C E S S   S E R V I C E S
 **==========================================================================*/
static MM_U32 utGetMemHeapSize(void)
{
   return ((MM_U32)ghsend_extfonteng_HEAP -  (MM_U32)ghsbegin_extfonteng_HEAP);
}

MM_ERROR utMmanInit(void)
{
    MM_ERROR ret = MML_OK;
    MM_U32 dynamic_VRAM_Size = utGetMemHeapSize();
    MM_U32 dynamic_baseAddress = (MM_U32)ghsbegin_extfonteng_HEAP;

    if(dynamic_VRAM_Size>(MM_U32)0)
    {
        if(g_heapHandle != NULL)
        {
          (void)utMmanDestroyHeap(g_heapHandle);
          g_heapHandle = NULL;
        }
        ret = utMmanCreateHeap(&g_heapHandle, dynamic_VRAM_Size, dynamic_baseAddress );
    }
    return ret;
}
static MM_ERROR utMmanHeapRealloc(MML_MMAN_HEAP_HANDLE hdlmem, MM_U32 size, MM_U32 alignment, MM_ADDR *newaddr, MM_ADDR *oldaddr)
{
  /*
  1. Allocate the New memory as per newly requested size
  2. Copy the old memory content to newly allocated memory.
  3. Free the old memory.
  4. Return the new memory
  */

  MM_ADDR utRet;
  MM_ERROR ret;
  BlockInfo *block;
  HeapInfo* heap = (HeapInfo*)hdlmem;
  block = s_obtainBlock(oldaddr, heap);

  ret = utMmanHeapAlloc(hdlmem, size, alignment, &utRet);
  if(ret == MML_OK)
  {
    if(utRet != (MM_ADDR)0)
    {
      if((NULL != block ) && (size > block->size))
      {
        (void)memcpy((void *)utRet, oldaddr, block->size);
      }
      else
      {
        (void)memcpy((void *)utRet, oldaddr, size);
      }
    }
    ret = utMmanHeapFree(hdlmem, oldaddr);
    if (ret != MML_OK)
    {
#ifdef GFX02_DEBUG_INFO
      printf("[ERROR] mmlGdcVideoFree: failed to free memory at %p!\n", oldaddr);
#endif
    }
    *newaddr = utRet;
  }
  return ret;
}

static BlockInfo* s_obtainBlock(void const *addr, HeapInfo* heap)
{
    BlockInfo *block = heap->startBlock;

    while (NULL != block )
    {
        if (block->offset == ((MM_U32)addr - heap->baseAddress))
        {
            return block;
        }
        block = block->nextBlock;
    }
    return 0;
}

static void * mmlGdcMemVideoAlloc( MM_U32 size, MM_U32 alignment, MM_ADDR *pAddr )
{
    MM_ADDR ulRet = 0;
    MM_ERROR ret;

    ret = utMmanHeapAlloc(g_heapHandle, size, alignment, &ulRet);
    if(ret != MML_OK)
    {
     #ifdef GFX02_DEBUG_INFO
      printf("[ERROR] mmlGdcVideoAlloc: failed to allocate %d bytes\n", size);
     #endif
      ulRet = 0;
    }
    GFX_MGR02_UNUSED_PTR(pAddr);

    return (void *)ulRet;
}

static void * mmlGdcMemVideoCalloc( MM_U32 size, MM_U32 alignment, MM_ADDR *pAddr )
{
  MM_ADDR ulRet = 0;
  MM_ERROR ret;

  ret = utMmanHeapAlloc(g_heapHandle, size, alignment, &ulRet);
  if (MML_OK == ret)
  {
    if (ulRet != (MM_ADDR)0)
    {
      /* calloc has to initialize the memory with zeros */
      (void)memset((void *)ulRet, 0, size);
    }
  }
  else
  {
    #ifdef GFX02_DEBUG_INFO
    printf("[ERROR] mmlGdcVideoCalloc: failed to allocate %d bytes\n", size);
    #endif
    ulRet = 0;
  }
  GFX_MGR02_UNUSED_PTR(pAddr);
  return (void *)ulRet;
}

static void mmlGdcMemVideoFree(void* addr)
{
    MM_ERROR ret;
    ret = utMmanHeapFree(g_heapHandle, addr);
    if (ret != MML_OK)
    {
        #ifdef GFX02_DEBUG_INFO
        (void)printf("[ERROR] mmlGdcVideoFree: failed to free memory at %p!\n", addr);
        #endif
    }
}

static void * mmlGdcMemVideoRealloc( MM_U32 size, MM_U32 alignment, MM_ADDR *pAddr )
{
    MM_ADDR ulRet = 0;
    MM_ERROR ret;
    ret = utMmanHeapRealloc(g_heapHandle, size, alignment, &ulRet,pAddr);
    if (MML_OK != ret)
    {
        #ifdef GFX02_DEBUG_INFO
        (void)printf("[ERROR] mmlGdcVideoRealloc: failed to allocate %d bytes\n", size);
        #endif
        ulRet = 0;
    }

    return (void *)ulRet;
}

