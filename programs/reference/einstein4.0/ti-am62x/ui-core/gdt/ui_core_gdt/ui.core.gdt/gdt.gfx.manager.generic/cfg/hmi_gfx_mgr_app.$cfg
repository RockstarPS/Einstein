** Define GFX_MGR_APPEND_BASEDON_APP_IP if the text needs to be clipped from Right/Left
** based on the value returned from application.
** Example configuration :-
** #define GFX_MGR_APPEND_BASEDON_APP_IP
*/

#ifdef GFX_MGR_APPEND_BASEDON_APP_IP
/* Application has to return the "GFX_CLIP_INFO" value whether text needs to be clipped from RIGHT/LEFT */
#define GFX_MGR_GET_CLIP_INFO(string_input, string_length, truncation_status)     app_callback_function(string_input, string_length, truncation_status)
#endif


