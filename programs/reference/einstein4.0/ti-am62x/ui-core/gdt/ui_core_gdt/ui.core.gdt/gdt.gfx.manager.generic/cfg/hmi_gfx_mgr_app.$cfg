/*
** Define GFX_MGR_USE_INT_RGB if the text and fillscreen draw color needs to be
** generated as RGB integer values. Otherwise it will be generated as float
** values. Valid only for a OpenVg build.
** Example configuration :-
** #define GFX_MGR_USE_INT_RGB
*/

/*
** Define GFX_MGR_NEED_INTERFACE_LAYER if an interface layer is being used to
** buffer the request to graphics manager. In this case manager invokes the
** init functions for the interface layer as part of its entry and exit
** sequence.
** Example configuration :-
** #define GFX_MGR_NEED_INTERFACE_LAYER
*/

/*
** Define GFX_TOUCH_SCREEN_ENABLED to 1 if touchscreen support is needed
** otherwise set this to 0
** When the touch screen support is enabled, set the size of the touch
** screen event queue with GFX_TOUCH_EVENT_Q_SIZE
** Configure an application function to GFX_TOUCH_SCREEN_EVENT_DISPATCH
** to receive the touch screen events. The applicatoi handler will receive
** the element id which has captured the touch in "elem_id", the current
** selected state of the element in "cur_state" and the detected touch
** event in "touch_event". The touch event can be any of the following
**   GFX_MOUSE_DOWN_EV   - A touch is sensed
**   GFX_MOUSE_MOVE_EV   - After the GFX_MOUSE_DOWN_EV if the touch moves
**   GFX_MOUSE_CANCEL_EV - After the GFX_MOUSE_DOWN_EV if the touch moves
**                         away from the element.
**   GFX_MOUSE_UP_EV     - If the touch is released with in the element
**                         If a GFX_MOUSE_CANCEL_EV is delivered, a
**                         GFX_MOUSE_UP_EV will not follow.
** Example configuration :-
** extern void GfxTouchEventHandler(UINT32 p_btn_id, UINT32 p_button_state, UINT32 p_btn_ev);
** #define GFX_TOUCH_SCREEN_ENABLED 1
** #define GFX_TOUCH_EVENT_Q_SIZE   20
** #define GFX_TOUCH_SCREEN_EVENT_DISPATCH(elem_id, cur_state, touch_event) GfxTouchEventHandler(elem_id, cur_state, touch_event)
*/
#define GFX_TOUCH_SCREEN_ENABLED 0

/*
** Normally in double buffered display manager expects that the the
** just built frame buffer content is copied to the next buffer so that
** it just need to rework only on the changed sections. In such cases if the
** user wants to control the post copy in cases where the display is taking
** a transition such as an animation sequence, where user knows that every display
** is going to be new, he would want the post copy to be disabled.
** By setting the GFX_MANAGER_NEED_POST_COPY_USER_CONTROL to 1 will enable the
** GfxManagerBuildScreen to accept a parameter with bit encoding such as Bit0
** represents Layer 0, Bit 1 represents layer 1 etc. If the correcponding bit is
** set then only the post copy will be initiated for that layer.
** Set GFX_MANAGER_NEED_POST_COPY_USER_CONTROL to 0 if the display is not double
** buffered or the user control is not necessary.
*/
#define GFX_MANAGER_NEED_POST_COPY_USER_CONTROL      (0)

/*
** Set GFX_MANAGER_NEED_BEGIN_UPDATE_NOTIFICATION to 1 if the user want a
** notification from the manager before start of a layer build. The manager
** will invoke GfxDriverBeginUpdate() prior to start of building the layer.
** For multipayer display the first parameter will indicate the layer id.
** Set GFX_MANAGER_NEED_BEGIN_UPDATE_NOTIFICATION to 0 if no prior notification
** is needed.
*/
#define GFX_MANAGER_NEED_BEGIN_UPDATE_NOTIFICATION   (0)

/*
** Set GFX_MANAGER_LOW_PRIORITY_SCREEN_UPDATE to one of the following to
** control how the higher priority screen need to behave if a content
** change happens in lower priority screens.
** GFX_BLOCK         - if the user wants to block all updates to a lower
**                     priority screen while a higher priority screen is active
**                     on the display use this setting. This will make the low
**                     priority screen content freezed until the higher priority
**                     screen is active.
** GFX_PAINT_CHANGED - if the user wants to update the low priority screen
**                     while a higher priority screen is active by repainting
**                     only the low priority screen area/s which are updated.
**                     This gives better refresh timing since we are building
**                     only changed areas. Note that this is supported only for
**                     the Yukawa GDT and not supported for 1BPP version.
** GFX_REPAINT       - if the user wants to update the low priority screen
**                     while a higher priority screen is active by repainting
**                     whole of the high priority screens. The refresh timing
**                     will be more compared to GFX_PAINT_CHANGED. This is not
**                     suitable if the high priority screens has alpha blending
**                     area with low priority screens (in such cases only
**                     GFX_BLOCK or GFX_PAINT_CHANGED can only be used).
** GFX_NONE			 - None of the above are applied. If a low priority screen
**					   changes it will be refreshed and will not cause any paint
**					   or repaint of high priority screens. This setting will only
**                     be useful if the low/high priority screens don't overlap.
**                     if there are overlaps, then this setting will cause a
**                     corrupted display if any low priority screen changes in the
**                     overlapped area.
*/
#define GFX_MANAGER_LOW_PRIORITY_SCREEN_UPDATE       (GFX_BLOCK)

/*
** Set GFX_MANAGER_NEED_INITIALIZED_DYN_TEXT to 1 if the user wants
** to initialize all the dynamic text to the sample text entered in the xml design.
** This will require ROM space to generate the initialization data.
** Leave it at 0 if the dynamic text need not be initialized.
*/
#define GFX_MANAGER_NEED_INITIALIZED_DYN_TEXT        (0)

/*
** Set GFX_MANAGER_NEED_INITIALIZED_DYN_WIDGET to 1 if the user wants
** to initialize all the dynamic widgets to the default index entered in the xml design.
** This will require ROM space to generate the initialization data.
** Leave it at 0 if the dynamic widgets need not be initialized.
*/
#define GFX_MANAGER_NEED_INITIALIZED_DYN_WIDGET      (0)

/*
** Set GFX_MANAGER_NEED_INITIALIZED_DYN_IMAGE to 1 if the user wants
** to initialize all the dynamic images to the default index entered in the xml design.
** This will require ROM space to generate the initialization data.
** Leave it at 0 if the dynamic widgets need not be initialized.
*/
#define GFX_MANAGER_NEED_INITIALIZED_DYN_IMAGE       (0)

/*
** Set GFX_NEED_NESTED_DYNAMIC_WIDGET_SUPPORT to 1 if the user wants
** nested dynamic widget building support. If enabled and then if user
** adds a dynamic widget inside a dynamic widget, the manager will correctly
** build it. Manager uses recursive function call to resolve the widget.
** If disabled, then if the user adds a dynamic widget inside dynamic widget
** it will not be built by the manager.	Manager also doesn't use recursive
** calls to resolve dynamic widget.
*/
#define GFX_NEED_NESTED_DYNAMIC_WIDGET_SUPPORT		 (0)

/* maximum text length supported for dynamic text */
#define MAX_TEXT_LENGTH   30

