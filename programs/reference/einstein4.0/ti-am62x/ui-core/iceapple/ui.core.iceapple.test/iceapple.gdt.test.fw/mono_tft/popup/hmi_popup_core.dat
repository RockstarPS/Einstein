/* Release label major version 4 */
/* Release label minor version 13 */
#define HMI_POPUP_CORETOOL_LABEL "POPUPTOOL_LABEL: rel-UI-CORE-ICEAPPLE-4.13"
#define HMI_POPUP_CORE_TOOL_MAJOR_VERSION	4
#define HMI_POPUP_CORE_TOOL_MINOR_VERSION	13
#define HMI_POPUP_CORETOOL_VERSION     ((HMI_POPUP_CORE_TOOL_MAJOR_VERSION * 100) + HMI_POPUP_CORE_TOOL_MINOR_VERSION)
#if HMI_POPUP_CORE_VERSION != HMI_POPUP_CORETOOL_VERSION
#pragma message (HMI_POPUP_CORETOOL_LABEL)
#pragma message (HMI_POPUP_CORE_LABEL)
#error  The above Popup core and its tool version are mismatched. Please verify.
#endif

#define POPUP_APP_DEFINED_ANIM_FUNCTION(anim_id,popup_id) (anim_id)

/***************************************************/
/*                  Timer Interface                */
/***************************************************/
#define  HMI_POPUP_START_TIMER(timer_id, timeout, evt)  ( hmi_popup_core_support_timer_start((timer_id), (timeout), (evt)))
#define  HMI_POPUP_STOP_TIMER(timer_id)                 ( hmi_popup_core_support_timer_stop(timer_id))
#define  HMI_POPUP_CHECK_TIMER(timer_id)                ( hmi_popup_core_support_timer_check(timer_id))

#define  POPUP_TMR_RUNNING               ( HMI_TIMER_RUNNING)
#define  POPUP_TMR_EXPIRED               ( HMI_TIMER_EXPIRED)
#define  POPUP_TMR_CLEARED               ( HMI_TIMER_CLEAR)
#define  POPUP_MAX_TIMER                 (0x0FFFF)


/***************************************************/
/*           Animation Configuration               */
/***************************************************/
#define  HMI_DEFAULT_POPUP_CLOSE_ANIM					( ANIM_MAX_ID)
#define  HMI_POPUP_REMOVE_MINTIMEOUT_ANIM				( ANIM_MAX_ID)
#define  HMI_POPUP_REMOVE_LOWPRIO_ACTIVE_ANIM			( ANIM_MAX_ID)
#define  HMI_POPUP_REMOVE_TIMEOUT_ANIM					( ANIM_MAX_ID)
#define  HMI_POPUP_ADD_MINTIME_ANIM						( ANIM_MAX_ID)
#define  HMI_POPUP_ADD_TIMEOUT_ANIM						( ANIM_MAX_ID)
#define  HMI_POPUP_REMOVE_PROG_TIMEOUT_ANIM				( ANIM_MAX_ID)
#define  HMI_DEFAULT_POPUP_ADD_ANIM						( ANIM_MAX_ID)
#define  HMI_POPUP_REMOVE_ACK_ANIM						( ANIM_MAX_ID)

#define POPUP_IGNORE_MIN_TIME_ON_HIGH_PRIO_POPUP      (1)

#define POPUP_LSH_ADD_STATE_EXT(state, anim, client)	LSH_ADD_STATE_EXT(state, anim, client)
#define POPUP_LSH_REM_STATE_EXT(state, anim, client)	LSH_REM_STATE_EXT(state, anim, client)

