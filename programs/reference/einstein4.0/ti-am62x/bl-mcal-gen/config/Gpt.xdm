<?xml version='1.0'?>
<datamodel version="6.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/14/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/14/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="Gpt" type="AR-PACKAGE">
        <d:lst type="ELEMENTS">
          <d:chc name="Gpt" type="AR-ELEMENT" value="MODULE-CONFIGURATION">
            <d:ctr type="MODULE-CONFIGURATION">
              <a:a name="DEF" value="ASPath:/TI_AM62PX/Gpt"/>
              <a:a name="IMPORTER_INFO" value="@REC"/>
              <d:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION" 
                     value="VariantPostBuild">
                <a:a name="IMPORTER_INFO" value="@REC"/>
              </d:var>
              <d:ctr name="GptChannelConfigSet" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:lst name="GptChannelConfiguration" type="MAP">
                  <d:ctr name="MCU_TIMER1" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:var name="GptChannelId" type="INTEGER" value="1"/>
                    <d:var name="GptChannelMode" type="ENUMERATION" 
                           value="GPT_CH_MODE_CONTINUOUS">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                    <d:var name="GptChannelTickFrequency" type="FLOAT" 
                           value="0.0">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                    <d:var name="GptChannelTickValueMax" type="INTEGER" 
                           value="4294967295"/>
                    <d:var name="GptEnableWakeup" type="BOOLEAN" value="true">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                    <d:lst name="GptNotification">
                      <d:var type="FUNCTION-NAME" value="Mcu_Gpt1Notify"/>
                    </d:lst>
                    <d:ref name="GptChannelClkSrcRef" type="REFERENCE" 
                           value="ASPath:/Gpt/Gpt/GptDriverConfiguration/TIMER2_CLKSEL">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:ref>
                    <d:lst name="GptWakeupConfiguration" type="MAP">
                      <d:ctr name="GptWakeupConfiguration_0" 
                             type="IDENTIFIABLE">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                        <d:ref name="GptWakeupSourceRef" type="REFERENCE" 
                               value="ASPath:/EcuM/EcuM/EcuMConfiguration/EcuMCommonConfiguration/MCU_TIMER1">
                          <a:a name="IMPORTER_INFO" value="@REC"/>
                        </d:ref>
                      </d:ctr>
                    </d:lst>
                    <d:var name="GptChannelPrescale" type="ENUMERATION" 
                           value="GPT_PRESCALER_NO_PRESCALE">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                  </d:ctr>
                  <d:ctr name="Gpt_ExtWdg_Win" type="IDENTIFIABLE">
                    <d:var name="GptChannelId" type="INTEGER" value="2"/>
                    <d:var name="GptChannelMode" type="ENUMERATION" 
                           value="GPT_CH_MODE_CONTINUOUS"/>
                    <d:var name="GptChannelTickFrequency" type="FLOAT" 
                           value="0.0"/>
                    <d:var name="GptChannelTickValueMax" type="INTEGER" 
                           value="4294967295"/>
                    <d:var name="GptEnableWakeup" type="BOOLEAN" value="false">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:lst name="GptNotification">
                      <d:var type="FUNCTION-NAME" value="Gpt_ExtWDNotify"/>
                    </d:lst>
                    <d:ref name="GptChannelClkSrcRef" type="REFERENCE" 
                           value="ASPath:/Gpt/Gpt/GptDriverConfiguration/TIMER1_CLKSEL"/>
                    <d:lst name="GptWakeupConfiguration" type="MAP"/>
                    <d:var name="GptChannelPrescale" type="ENUMERATION" 
                           value="GPT_PRESCALER_NO_PRESCALE">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                  </d:ctr>
                  <d:ctr name="Gpt_ExtWdg_Trigger" type="IDENTIFIABLE">
                    <d:var name="GptChannelId" type="INTEGER" value="3"/>
                    <d:var name="GptChannelMode" type="ENUMERATION" 
                           value="GPT_CH_MODE_CONTINUOUS"/>
                    <d:var name="GptChannelTickFrequency" type="FLOAT" 
                           value="0.0">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="GptChannelTickValueMax" type="INTEGER" 
                           value="4026531840">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:var name="GptEnableWakeup" type="BOOLEAN" value="false">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                    <d:lst name="GptNotification">
                      <d:var type="FUNCTION-NAME" value="Gpt_ExtTriggerNotify"/>
                    </d:lst>
                    <d:ref name="GptChannelClkSrcRef" type="REFERENCE" >
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:ref>
                    <d:lst name="GptWakeupConfiguration" type="MAP"/>
                    <d:var name="GptChannelPrescale" type="ENUMERATION" 
                           value="GPT_PRESCALER_NO_PRESCALE">
                      <a:a name="IMPORTER_INFO" value="@DEF"/>
                    </d:var>
                  </d:ctr>
                </d:lst>
              </d:ctr>
              <d:ctr name="GptConfigurationOfOptApiServices" 
                     type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="GptDeinitApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptEnableDisableNotificationApi" type="BOOLEAN" 
                       value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptTimeElapsedApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptTimeRemainingApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptVersionInfoApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptWakeupFunctionalityApi" type="BOOLEAN" 
                       value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptRegisterReadbackApi" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
              </d:ctr>
              <d:ctr name="GptDriverConfiguration" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:var name="GptDeviceVariant" type="ENUMERATION" value="AM62PX">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptDevErrorDetect" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptPredefTimer100us32bitEnable" type="BOOLEAN" 
                       value="false">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptPredefTimer1usEnablingGrade" type="ENUMERATION" 
                       value="GPT_PREDEF_TIMER_1US_DISABLED">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:var name="GptReportWakeupSource" type="BOOLEAN" value="true">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:lst name="GptClockReferencePoint" type="MAP">
                  <d:ctr name="TIMER1_CLKSEL" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:ref name="GptClockReference" type="REFERENCE" >
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:ref>
                  </d:ctr>
                  <d:ctr name="TIMER2_CLKSEL" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:ref name="GptClockReference" type="REFERENCE" >
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:ref>
                  </d:ctr>
                  <d:ctr name="TIMER3_CLKSEL" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:ref name="GptClockReference" type="REFERENCE" >
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:ref>
                  </d:ctr>
                  <d:ctr name="TIMER4_CLKSEL" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:ref name="GptClockReference" type="REFERENCE" >
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:ref>
                  </d:ctr>
                </d:lst>
                <d:var name="GptCategoryOfIsr" type="ENUMERATION" 
                       value="GPT_ISR_CAT2"/>
                <d:var name="GptDefaultOSCounterId" type="INTEGER" value="0">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:ref name="GptOsCounterRef" type="REFERENCE" 
                       value="ASPath:/Os/Os/OsCounter_0">
                  <a:a name="ENABLE" value="true"/>
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:ref>
                <d:var name="GptTimeoutDuration" type="INTEGER" value="32000">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
                <d:ctr name="GptDemEventParameterRefs" type="IDENTIFIABLE">
                  <a:a name="ENABLE" value="true"/>
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                  <d:ref name="GPT_E_HARDWARE_ERROR" type="REFERENCE" 
                         value="ASPath:/Dem/Dem/DemConfigSet/GPT_E_HARDWARE_ERROR">
                    <a:a name="ENABLE" value="true"/>
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                  </d:ref>
                </d:ctr>
              </d:ctr>
            </d:ctr>
          </d:chc>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
