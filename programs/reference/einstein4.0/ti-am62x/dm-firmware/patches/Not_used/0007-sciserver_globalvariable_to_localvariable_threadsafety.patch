From 292511764d766d3c00bbe7e11c6e791ed0369c6e Mon Sep 17 00:00:00 2001
From: Sebin Francis <sebin.francis@ti.com>
Date: Mon, 1 Sep 2025 18:40:44 +0530
Subject: [PATCH 2/3] allsocs: sciclient: Fix contextId upper boundary check in
 Sciclient_ISR

Update the conditional check in Sciclient_ISR to properly verify the
upper boundary of contextId. Previous implementation had an incorrect
boundary condition that could allow invalid values to pass validation.

This change ensures contextId is always within valid range before use,
preventing potential memory access issues across all SoCs.

Fixes: SITSW-8061

Signed-off-by: Sebin Francis <sebin.francis@ti.com>
---
 source/drivers/device_manager/sciclient_direct/sciclient.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/source/drivers/device_manager/sciclient_direct/sciclient.c b/source/drivers/device_manager/sciclient_direct/sciclient.c
index 7fa4f56e1b0..83ca047a778 100755
--- a/source/drivers/device_manager/sciclient_direct/sciclient.c
+++ b/source/drivers/device_manager/sciclient_direct/sciclient.c
@@ -1119,7 +1119,7 @@ static void Sciclient_ISR(uintptr_t arg)
 {
     int32_t contextId = (int32_t )(arg);
 
-    if(contextId  >= 0)
+    if((contextId >=0) && (contextId  < SCICLIENT_CONTEXT_MAX_NUM))
     {
         uint32_t rxThread = gSciclientMap[contextId].respThreadId;
         uint8_t secHeaderSizeWords =0U;
-- 
2.42.2


From 8723b8a61f3509da3c3c5276445fbfd2f31c8123 Mon Sep 17 00:00:00 2001
From: Sebin Francis <sebin.francis@ti.com>
Date: Mon, 1 Sep 2025 18:49:03 +0530
Subject: [PATCH 3/3] allsoc: sciclient: Fix thread safety issue in sequence ID
 handling

Prevent race condition by modifying sequence of operations to ensure
gSciclientHandle.currSeqId isn't updated between variable assignments.
Use first variable to directly populate the second variable, eliminating
the potential timing window.

Fixes: SITSW-8060

Signed-off-by: Sebin Francis <sebin.francis@ti.com>
---
 source/drivers/device_manager/sciclient_direct/sciclient.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/source/drivers/device_manager/sciclient_direct/sciclient.c b/source/drivers/device_manager/sciclient_direct/sciclient.c
index 83ca047a778..d42dc0e68d5 100755
--- a/source/drivers/device_manager/sciclient_direct/sciclient.c
+++ b/source/drivers/device_manager/sciclient_direct/sciclient.c
@@ -625,7 +625,7 @@ int32_t Sciclient_servicePrepareHeader(const Sciclient_ReqPrm_t *pReqPrm,
                                sizeof(pReqPrm->messageType));
 
         (*header)->seq = (uint8_t) gSciclientHandle.currSeqId;
-        *localSeqId = (uint8_t) gSciclientHandle.currSeqId;
+        *localSeqId = (*header)->seq;
         /* This is done in such a fashion as the C66x does not honor a non word aligned
          * write.
          */
-- 
2.42.2
