###########################################################################
## Infrastructure Configurations
###########################################################################
#ifdef SECURE_FS
[search=${BSP_INSTALL_DIR}/etc] /etc/qtd.conf = secure-qtd.conf
#else
[search=${BSP_INSTALL_DIR}/etc] /etc/qtd.conf = qtd.conf
#endif

#if IFS_TYPE == IFS_TYPE_PRIMARY
#ifdef SECURE_MAC
[search=${BSP_INSTALL_DIR}/etc] /etc/slm.xml = slm-primary-secure.xml
#else
[search=${BSP_INSTALL_DIR}/etc] /etc/slm.xml = slm-primary.xml
#endif
#elif IFS_TYPE == IFS_TYPE_REFLASH
[search=${BSP_INSTALL_DIR}/etc] /etc/slm.xml = slm-reflash.xml
#elif IFS_TYPE == IFS_TYPE_RECOVERY
[search=${BSP_INSTALL_DIR}/etc] /etc/slm.xml = slm-recovery.xml
#endif

