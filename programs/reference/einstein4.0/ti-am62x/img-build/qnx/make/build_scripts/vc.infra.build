[type=link] /usr/lib/liblzma.so = /system/usr/lib/liblzma.so.5
[perms=0777 search=${QNX_TARGET}/${PLATFORM}/usr/lib]         /usr/lib/libiconv.so.1=libiconv.so.1
[type=link] /usr/lib/libiconv.so= /system/usr/lib/libiconv.so.1
