
###########################################################################
## Visteon DLT Build File
###########################################################################

[perms=0777 search=${BSP_INSTALL_DIR}/${PLATFORM}/bin]             /bin/dlt-daemon=dlt-daemon
[perms=0777 search=${BSP_INSTALL_DIR}/${PLATFORM}/bin]             /bin/dlt-qnx-system=dlt-qnx-system
[perms=0777 search=${BSP_INSTALL_DIR}/${PLATFORM}/usr/lib]         /usr/lib/libdlt.so.2=libdlt.so.2.18.10
[perms=0644 search=${BSP_INSTALL_DIR}/etc]                         /etc/dlt.conf=dlt.conf
[perms=0644 search=${BSP_INSTALL_DIR}/etc] 						   /etc/dlt_logstorage.conf=dlt_logstorage.conf
[perms=0644 search=${BSP_INSTALL_DIR}/etc]                         /etc/dlt-qnx-system.conf=dlt-qnx-system.conf
[perms=0644 search=${BSP_INSTALL_DIR}/etc]                         /etc/dlt-slog2ctxt.json=dlt-slog2ctxt.json

