[uid=0 gid=0 perms=0755]/usr/sbin/start_usb_ethernet.sh = {
#!/bin/sh
random
waitfor /dev/random 4
io-usb-otg -d dwc3-xhci ioport=0x31000000,irq=220
waitfor /dev/usb/io-usb-otg 4
io-sock -m phy -m usb -d axe
if_up -p axe0
ifconfig axe0 192.168.1.10 netmask 255.255.255.0
qconn port=8000
}


[uid=0 gid=0 perms=0755]/usr/sbin/start_automotive_ethernet.sh = {
#!/bin/sh
random
waitfor /dev/random 4
io-sock -m fdt -m phy -m phy_fdt -d cpsw-am62p
}