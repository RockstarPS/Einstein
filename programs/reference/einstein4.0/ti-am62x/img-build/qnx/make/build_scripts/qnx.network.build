[perms=0777 search=${QNX_TARGET}/${PLATFORM}/sbin]        /sbin/devc-pty=devc-pty
[perms=0777 search=${QNX_TARGET}/${PLATFORM}/usr/sbin]    /usr/sbin/qconn=qconn
