<?xml version="1.0" encoding="UTF-8"?>
<project>
	<name>vPlatform</name>
	<modules>
		<module>
			<name>EcuBatteryM</name>
    		<periodicity>10</periodicity>
			<validation>enable</validation>
    		<gen-path>..\gen-files</gen-path>
			<dev-error>STD_ON</dev-error>
			<verbose>2</verbose>
