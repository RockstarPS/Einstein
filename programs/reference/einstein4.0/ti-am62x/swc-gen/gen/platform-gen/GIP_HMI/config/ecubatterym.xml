					<initial_state>FALSE</initial_state>
					<on-threshold>2428</on-threshold>
					<off-threshold>2031</off-threshold>
					<on-to-off-debounce>500</on-to-off-debounce>
					<off-to-on-debounce>500</off-to-on-debounce>
