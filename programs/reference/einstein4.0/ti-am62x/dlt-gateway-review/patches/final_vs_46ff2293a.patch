+void DltGatewayComponent::sendAck(uint8_t status0, uint8_t status1)
+{
+    DLTMessageReadAck ack{};
+    ack.status[0] = status0;
+    ack.status[1] = status1;
+
+    std::lock_guard<std::mutex> lk(mAckMTX);
+    DK_RTE_Send_DLTMessageReadAck(ack);
+}
+
+void DltGatewayComponent::startupAckLoop()
+{
+    int32_t sent = 0;
+
+    while (mRunning && !mVipResponded)
+    {
+        sendAck(DLT_GW_STARTUP_ACK_STATUS, 0u);
+        ++sent;
+        LOGI(&gDLTGWLogContext, "Startup ready ACK sent to VIP (default status=", DLT_GW_STARTUP_ACK_STATUS, ") attempt ", sent);
+
+        if ((mDltGateWayConfig.StartupAckMaxRetries > 0) &&
+            (sent >= mDltGateWayConfig.StartupAckMaxRetries))
+        {
+            LOGI(&gDLTGWLogContext, "Startup ready ACK sent ", sent,
+                 " time(s) - not repeating, waiting for first DLTMessageReadRequest");
+            break;
+        }
+
+        // Sleep in slices to react quickly to stop / VIP response
+        const auto deadline = std::chrono::steady_clock::now() +
+                              std::chrono::milliseconds(mDltGateWayConfig.StartupAckIntervalMs);
+        while (mRunning && !mVipResponded && (std::chrono::steady_clock::now() < deadline))
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
+    }
 }
 
