                    <CLIENT-SERVER-OPERATION UUID="855a7d9a-f0f0-49de-9b53-473a6cfb6d80">
                      <SHORT-NAME>GetShutdownCause</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL">Returns the selected shutdown cause as set by the operation SelectShutdownCause.</L-2>
                      </DESC>
                      <ARGUMENTS>
                        <ARGUMENT-DATA-PROTOTYPE UUID="fe83727a-3df4-478c-8dad-1afcd3193a2d">
