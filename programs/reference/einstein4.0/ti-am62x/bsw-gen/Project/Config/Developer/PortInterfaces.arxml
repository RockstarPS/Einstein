                      <SHORT-NAME>GetStateWrapper</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL">Returns the current module state of the ECUM.</L-2>
                      </DESC>
                      <ARGUMENTS>
                        <ARGUMENT-DATA-PROTOTYPE UUID="3c3eea1a-14d0-4da5-b09f-a1be7387c001">
                          <SHORT-NAME>state</SHORT-NAME>
                          <DESC>
