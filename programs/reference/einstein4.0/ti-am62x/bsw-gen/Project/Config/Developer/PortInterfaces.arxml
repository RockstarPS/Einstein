                      <SHORT-NAME>E_NOT_OK</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL">The new shutdown target was not set</L-2>
                      </DESC>
                      <ERROR-CODE>1</ERROR-CODE>
                    </APPLICATION-ERROR>
                  </POSSIBLE-ERRORS>
                </CLIENT-SERVER-INTERFACE>
