                <CLIENT-SERVER-INTERFACE UUID="99d13a82-d9f2-4347-bd06-185e4951e245">
                  <SHORT-NAME>EcuM_StateRequest</SHORT-NAME>
                  <DESC>
                    <L-2 L="FOR-ALL">A SW-C which wants to keep the ECU alive shall require the client-server interface EcuM_StateRequest.</L-2>
                  </DESC>
                  <IS-SERVICE>true</IS-SERVICE>
                  <SERVICE-KIND>ECU-MANAGER</SERVICE-KIND>
                  <OPERATIONS>
