                            <a:a name="IMPORTER_INFO" value="@REC"/>
                          </d:var>
                        </d:ctr>
                      </d:lst>
                      <d:var name="Domain" type="ENUMERATION" value="MCU">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="ModuleName" type="ENUMERATION" value="Rti">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="McuClockModuleId" type="ENUMERATION" 
