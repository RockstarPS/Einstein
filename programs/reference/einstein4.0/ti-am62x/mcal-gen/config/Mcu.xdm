                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                    </d:ctr>
                    <d:ctr name="MCU_MCAN1" type="IDENTIFIABLE">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                      <d:var name="McuClockSettingId" type="INTEGER" value="2">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:lst name="McuClockReferencePoint" type="MAP">
                        <d:ctr name="McuClockReferencePoint_0" 
                               type="IDENTIFIABLE">
                          <a:a name="IMPORTER_INFO" value="@REC"/>
                          <d:var name="McuClockReferencePointFrequency" 
                                 type="FLOAT" value="8.0E7">
                            <a:a name="IMPORTER_INFO" value="@REC"/>
                          </d:var>
                        </d:ctr>
                      </d:lst>
                      <d:var name="Domain" type="ENUMERATION" value="MCU">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="ModuleName" type="ENUMERATION" value="Mcan">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="McuClockModuleId" type="ENUMERATION" 
                             value="MCU_CLKSRC_MODULE_ID_MCU_MCAN1">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                      <d:var name="McuClockSourceId" type="ENUMERATION" 
