                        </d:ctr>
                      </d:lst>
                      <d:var name="Domain" type="ENUMERATION" value="MCU">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="ModuleName" type="ENUMERATION" value="Gpt"/>
                      <d:var name="McuClockModuleId" type="ENUMERATION" 
