                </d:var>
                <d:var name="McuDeviceVariant" type="ENUMERATION" value="AM62PX">
                  <a:a name="IMPORTER_INFO" value="@REC"/>
                </d:var>
              </d:ctr>
              <d:lst name="McuModuleConfiguration" type="MAP">
