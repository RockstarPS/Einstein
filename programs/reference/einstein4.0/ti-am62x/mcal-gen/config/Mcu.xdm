                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                    </d:ctr>
                    <d:ctr name="Main_EPWM1" type="IDENTIFIABLE">
                      <d:var name="McuClockSettingId" type="INTEGER" value="5"/>
                      <d:lst name="McuClockReferencePoint" type="MAP">
                        <d:ctr name="McuClockReferencePoint_0" 
                               type="IDENTIFIABLE">
                          <d:var name="McuClockReferencePointFrequency" 
                                 type="FLOAT" value="2.5E8"/>
                        </d:ctr>
                      </d:lst>
                      <d:var name="Domain" type="ENUMERATION" value="MAIN"/>
                      <d:var name="ModuleName" type="ENUMERATION" value="Epwm"/>
                      <d:var name="McuClockModuleId" type="ENUMERATION" 
                             value="MCU_CLKSRC_MODULE_ID_EPWM1"/>
                      <d:var name="McuClockSourceId" type="ENUMERATION" 
                             value="MCU_CLKSRC_0"/>
                      <d:var name="McuClockInitializationConfigFlag" 
                             type="BOOLEAN" value="true">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                    </d:ctr>
                    <d:ctr name="Main_EPWM0" type="IDENTIFIABLE">
                      <d:var name="McuClockSettingId" type="INTEGER" value="6"/>
                      <d:lst name="McuClockReferencePoint" type="MAP">
                        <d:ctr name="McuClockReferencePoint_0" 
                               type="IDENTIFIABLE">
                          <d:var name="McuClockReferencePointFrequency" 
                                 type="FLOAT" value="2.5E8"/>
                        </d:ctr>
                      </d:lst>
                      <d:var name="Domain" type="ENUMERATION" value="MAIN"/>
                      <d:var name="ModuleName" type="ENUMERATION" value="Epwm"/>
                      <d:var name="McuClockModuleId" type="ENUMERATION" 
                             value="MCU_CLKSRC_MODULE_ID_EPWM0"/>
                      <d:var name="McuClockSourceId" type="ENUMERATION" 
                             value="MCU_CLKSRC_0">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                      <d:var name="McuClockInitializationConfigFlag" 
                             type="BOOLEAN" value="true">
                        <a:a name="IMPORTER_INFO" value="@DEF"/>
                      </d:var>
                    </d:ctr>
                  </d:lst>
                  <d:ctr name="McuDemEventParameterRefs" type="IDENTIFIABLE">
                    <a:a name="ENABLE" value="false"/>
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:ref name="MCU_E_CLOCK_FAILURE" type="REFERENCE" 
                           value="ASPath:/Dem/Dem/DemConfigSet/MCU_E_CLOCK_FAILURE">
                      <a:a name="ENABLE" value="false"/>
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:ref>
                  </d:ctr>
                  <d:lst name="McuModeSettingConf" type="MAP">
                    <d:ctr name="McuModeSettingConf_0" type="IDENTIFIABLE">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                      <d:var name="McuMode" type="INTEGER" value="0">
                        <a:a name="IMPORTER_INFO" value="@REC"/>
                      </d:var>
                    </d:ctr>
                  </d:lst>
                  <d:lst name="McuRamSectorSettingConf" type="MAP"/>
                </d:ctr>
              </d:lst>
              <d:ctr name="McuPublishedInformation" type="IDENTIFIABLE">
                <a:a name="IMPORTER_INFO" value="@REC"/>
                <d:lst name="McuResetReasonConf" type="MAP">
                  <d:ctr name="MCU_POWER_ON_RESET" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:var name="McuResetReason" type="INTEGER" value="0">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                  </d:ctr>
                  <d:ctr name="MCU_WATCHDOG_RESET" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:var name="McuResetReason" type="INTEGER" value="1">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                  </d:ctr>
                  <d:ctr name="MCU_SW_RESET" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:var name="McuResetReason" type="INTEGER" value="2">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
                    </d:var>
                  </d:ctr>
                  <d:ctr name="MCU_RESET_UNDEFINED" type="IDENTIFIABLE">
                    <a:a name="IMPORTER_INFO" value="@REC"/>
                    <d:var name="McuResetReason" type="INTEGER" value="3">
                      <a:a name="IMPORTER_INFO" value="@REC"/>
