			<m_name type="p">
				<CGIText type="e">
					<m_str type="a">Multi Master scenario where we Tv II is not the master and still the bus is busy after timeout due to some external master. So a timeout notification will only be executed. HwStatus -&gt; internal master status.</m_str>
					<m_style type="a">Arial; 10 0 0 0 1 </m_style>
					<m_color type="p">
						<IColor type="e">
