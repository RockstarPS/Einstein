			<_modifiedTimeWeak type="a">2.3.2026::7:21:1</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">typedef enum%0D
{%0D
    I2C_SEQ_OK        = 0, // Sequence transmission was successful.%0D
    I2C_SEQ_PENDING   = 1, // Sequence is queued, still waiting.%0D
    I2C_SEQ_QUEUED    = 2, // Internal state. %0D
    I2C_SEQ_NACK      = 3, // Sequence could not address a device.%0D
    I2C_SEQ_FAILED    = 4, // Sequence transmission was not successful.%0D
    I2C_SEQ_CANCELLED = 5  // Sequence was cancelled by user request.%0D
} I2c_SeqResultType;</_text>
			</IDescription>
