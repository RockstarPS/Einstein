/*****************************************************************************
*                            Include files                                   *
******************************************************************************/

#include "SciDrv_Types.h"
#include "Std_Types.h"
#include "Platform_Types.h"



/*****************************************************************************
*                                 Macro Definitions                          *
*----------------------------------------------------------------------------*
* Definition of macro shall be followed by a comment that explains the       *
* purpose of the macro.                                                      *
******************************************************************************/





// SCI Driver Maximum Channels
#define SCIDRV_MAX_CHANNELS                (1u)

// SCI Driver Bus Clock Frequence in MHZ
#define SCIDRV_INPUT_CLOCK_FREQ_MHZ          (48000000U)

//Timeout value for ASynchronous Receive
#define SCIDRV_ASYNC_RECEIVE_TIMEOUT          (3000U)

//Timeout value for Synchronous Transmit
#define SCIDRV_SYNC_TRANSMIT_TIMEOUT          (3000U)

/*****************************************************************************
*                                 Type Declarations                          *
******************************************************************************/
/* End Notification for Transmit */
typedef void (*SciDrv_TransmitEndNotificationCallbackType)(ESciDrvChnResult TransmitResult);
/* End Notification for Receive */
typedef void (*SciDrv_ReceiveEndNotificationCallbackType)(ESciDrvChnResult ReceiveResult,  uint32 SciBytesReceived, uint32 SciExtraBytesReceived);

typedef struct SSciDrvChnCfgType {
	//Peripheral Base Address
	uint32 SciDrvBaseAddr;
	//Module input clock frequency
	uint32 SciDrvInputClkFreq;
    // Transmit Callback
	SciDrv_TransmitEndNotificationCallbackType pSciDrvTransmitNotificationCbk;
    // Receive Callback
	SciDrv_ReceiveEndNotificationCallbackType pSciDrvReceiveNotificationCbk;
    //SCI Channel No
    uint8 SciDrvHwChnId;
    // Channel Baudrate
    uint32 SciDrvBaudRate;
    // Number of bits per frame
	uint8 SciDrvDataLength;
    // No of Stops Bits Per Frame
	uint8 SciDrvStopBitsLength;
    // Channel Parity Setting
	uint8 SciDrvEnableParity;
	//Operational mode Setting
	uint16 SciDrvOperMode;
	//Rx Trigger level Setting
	uint8 SciDrvRxTrigLvl;
	//Tx Trigger level Setting
	uint8 SciDrvTxTrigLvl;
	//Enable or Diable Hw Flow Control
	uint8 SciDrvHwFlowControl;

} SSciDrvChnCfg;

typedef struct SSciDrvCfgType {
	// No of configured SCI channels
	uint8 SciDrvMaxChn;
	// SCI Channel Configurations
	const SSciDrvChnCfg *pSciDrvChnCfg;
} SSciDrvCfg;

// Export the Configuration Structure
extern const SSciDrvCfg* pSciDrvCfg;

#define CallBack
// Client Callbacks
#ifdef CallBack
extern void Client_PhyTransmitCallback(ESciDrvChnResult TransmitResult);
extern void Client_PhyReceiveCallback(ESciDrvChnResult ReceiveResult,  uint32 SciBytesReceived, uint32 SciExtraBytesReceived);
#endif /*CallBack*/

#endif /* SCIDRV_CFG_H_ */

