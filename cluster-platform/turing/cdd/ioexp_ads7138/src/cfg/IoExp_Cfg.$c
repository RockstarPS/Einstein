void IoExp_Det_ReportError(uint16 ModuleId,
                               uint8  InstanceId,
                               uint8  ApiId,
                               uint8  ErrorId)
{
    if(IOEXP_MAINFUNC_ID == ApiId)
    {
        /* Do Nothing */
    }
    else
    {
        Det_ReportError(ModuleId, InstanceId, ApiId, ErrorId);
        while(1){};
    }
}

