**====================================================================================================================*/
static Std_ReturnType Cybersecdiag_JtagPasswordLocking_Write(uint8 *Data,uint8 *ErrorCode)
{
    Std_ReturnType ret = E_NOT_OK;
	uint8 idx = 0U;
