#ifdef CYBERSECDIAG_JTAG_PASSWORD_ROUTINE_LOCK_ENABLE
/*=====================================================================================================================
**
** Function Name    :  Cybersecdiag_JtagPswdLockRoutine_Start
**
** Visibility       :  Private
**
** Description      :  Start Jtag lock lifecycle
**
** Invocation       :  Cybersec.diagcdd , Function:Cybersecdiag_JtagPasswordLock_RCStart
**
** Inputs           :  uint8 *Data, uint8 *ErrorCode
**
** Outputs          :  Std_ReturnType E_OK - Pass; E_NOT_OK - Fail
**
** Critical Section :  No
**
**====================================================================================================================*/
static Std_ReturnType Cybersecdiag_JtagPswdLockRoutine_Start(uint8 *Data, uint8 *ErrorCode)
{
    Std_ReturnType ret = E_NOT_OK;

    // Read jtag password status
    ret = Cybersecdiag_JtagPasswordLocking_Status(Data, ErrorCode);

    // If jtag is unlocked then proceed for locking otherwise provide NRC
    if ((ret == (uint8)E_OK) && (Data[0U] == JTAG_UNLOCKED))
    {
        // Intimation of jtag password lock has triggered via RID
        Cybersecdiag_JtagPswdLockState = eJTAG_LOCK;
    }
    else if((ret == (uint8)E_OK) && (Data[0U] == JTAG_LOCKED))
    {
        // Jtage already locked
        Cybersecdiag_JtagPswdLockState = eJTAG_LOCK_FINISH;
    }
    else
    {
        *ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
    }
    
    return ret;
}
/*=====================================================================================================================
**
** Function Name    :  Cybersecdiag_JtagPswdLockRoutine_Task
**
** Visibility       :  Private
**
** Description      :  Jtag lock lifecycle
**
** Invocation       :  Cybersec.diagcdd , Function: meetcdd-->cmpActive
**
** Inputs           :  void
**
** Outputs          :  void
**
** Critical Section :  No
**
**====================================================================================================================*/
void Cybersecdiag_JtagPswdLockRoutine_Task(void)
{
    Csm_ReturnType Ret_Cry_HSM = CSM_E_NOT_OK;

    switch (Cybersecdiag_JtagPswdLockState)
    {
    case eJTAG_LOCK:
        JtagPassword_SecureDebug_CBK = JTAG_CBK_NOT_RECEIVED;
        JtagPassword_SecureDebug_CBK_Result = CSM_E_NOT_OK;

        //Ret_Cry_HSM = Cry_Hsm_Lock_JTAG();

        if (CSM_E_OK == Ret_Cry_HSM)
        {
            Cybersecdiag_JtagPswdLockState = eJTAG_LOCK_WAIT;
        }
        else
        {
            Cybersecdiag_JtagPswdLockState = eJTAG_LOCK_ERROR;
        }
        break;

    case eJTAG_LOCK_WAIT:
        if (JTAG_CBK_RECEIVED == JtagPassword_SecureDebug_CBK)
        {
            if (JtagPassword_SecureDebug_CBK_Result == CSM_E_OK)
            {
                Cybersecdiag_JtagPswdLockState = eJTAG_LOCK_FINISH;
            }
            else
            {
                Cybersecdiag_JtagPswdLockState = eJTAG_LOCK_ERROR;
            }
        }
        else
        {
            //(void)Cry_Hsm_SecureDebugMainFunction();
            //(void)vHsmIpc_HostManager_PeriodicCheck();
            //(void)CySldIpc_Isr_IpcDrv_Cat2();
        }
        break;

    default:
        // Do Nothing
        break;
    }

}
