#ifdef CYBERSECDIAG_SHESLOTS_READ
/*=====================================================================================================================
**
** Function Name    :  CybersecDiagCfg_SHESlots_Read
**
** Visibility       :  Public
**
** Description      :  This function reads the M4/M5 of SlotX(*1).
** 					   This shall be used to confirm the written key when the record of its keys is lost.
**
** Invocation       :  Cybersecdiagcdd.c , Function: CybersecDiag_SHESlots_Read
**
** Inputs           :  Data[In]: M4/M5 slot number
**
** Outputs          :  Data[Out]: Read key
**
** Critical Section :  Yes/No
**
**====================================================================================================================*/
static Std_ReturnType CybersecDiagCfg_SHESlots_Read(uint8 *Data,uint8 *ErrorCode)
{
    Std_ReturnType ret = E_NOT_OK;
	uint8 idx;
    uint32 keyId, keyElementId, keyLengthPtr;

	/*On pending request CSM interface should not be called again*/
	if (CybersecDiag_FlagReadSHESlot == FALSE)
	{
		/*Clearing buffer*/
		for (idx = 0U; idx < CYBERSECDIAG_M4M5_SLOTLENGTH; idx++)
		{
			Data[idx] = 0U;
		}

		/*If read request is for SafeKey Number*/
		if (CybersecDiag_FlagReadSafeKeyNum == TRUE)
		{
			keyId = SAFE_KEY_ID;
			keyElementId = SAFE_KEY_ELEMENT_ID;
			keyLengthPtr = SAFE_KEY_LENGTH;

			/*This interface will trigger call-back interface which will provide Safekey number from slot-7*/
			//ret = Crypto_KeyElementGet(keyId, keyElementId, Data, &keyLengthPtr);
		}
		else
		{
			keyId = (uint32)Data[0U];
			keyElementId = (CYBERSECDIAG_KEYMASK | keyId);
			keyLengthPtr = CYBERSECDIAG_WRITTENKEY_LENGTH;

			/*This interface will trigger call-back interface which will provide M4M5 values of requested slot*/
			//ret = Csm_KeyElementGet(keyId, keyElementId, Data, &keyLengthPtr);
		}

		if(ret == (uint8)E_NOT_OK)
		{
			/*If failure on SafeKey number read then clear its flag*/
			CybersecDiag_FlagReadSafeKeyNum = FALSE;
			*ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
		}
		else if(ret == (uint8)E_KEYNOT_AVAILABLE)
		{
			/*Key is not available in required slot*/
			/*Data values will be shown as 0*/
			ret = E_OK;
		}
		else if(ret == (uint8)E_OK)
		{
			/* One time successfully trigered CSM get function
			 * Wait for M4M5 values from call-back function*/
			CybersecDiag_FlagReadSHESlot = TRUE;
			ret = DCM_E_PENDING;
		}
		else
		{
			ret = DCM_E_PENDING;
		}
	}
	else
	{
		/*Result is available from call-back function*/
		if (CybersecDiag_FlagResultPtr == TRUE)
		{
			if (CybersecDiag_FlagReadSafeKeyNum == TRUE)
			{
				/*Copy SafeKey number from global variable to CAN data bufer*/
				for (idx = 0U; idx < SAFE_KEY_LENGTH; idx++)
				{
					Data[idx] = CybersecDiag_ResultPtr[idx];
				}
			}
			else
			{
				/*Copy M4M5 values from global variable to CAN data bufer*/
				for (idx = 0U; idx < CYBERSECDIAG_M4M5_SLOTLENGTH; idx++)
				{
					Data[idx] = CybersecDiag_ResultPtr[idx];
				}
			}

			/*Clear flags to take new read request*/
			CybersecDiag_FlagReadSHESlot = FALSE;
			CybersecDiag_FlagReadSafeKeyNum = FALSE;
			
			/*Since result is available clear result flag*/
			CybersecDiag_FlagResultPtr = FALSE;

			ret = E_OK;
		}
		else
		{
			/*Result still not availabe from call-back function*/
			ret = DCM_E_PENDING;
		}
	}

	return ret;
}

