#ifdef CYBERSECDIAG_SECURE_FUSE_PROGRAMMING
/*=====================================================================================================================
**
** Function Name    :  Cybersecdiag_SecureFuse_programming   .done
**
** Visibility       :  Private
**
** Description      :  calls API to write Secure Fuse Key
**
** Invocation       :  Cybersec.diagcdd , Function:Cybersecdiag_SecureFuseProgramming_RCStart
**
** Inputs           :  Data[In]:Data
**
** Outputs          :    	DCM_E_PENDING - 10
                            DIAG_POSITIVERESPONSE - 0
                            DIAG_CONDITIONSNOTCORRECT - 34
                            DIAG_INCORRECTMESSAGELENGTHORINVALIDFORMAT - 19
                            
**
** Critical Section : Yes/No
**
**====================================================================================================================*/
static Std_ReturnType Cybersecdiag_SecureFuse_programming(uint8 *Data,uint8 *ErrorCode)
{
	Std_ReturnType ret = E_NOT_OK;
	#if defined (MEET_GIP_ENABLED) && defined(MEET_GIP_ENABLED_CRYPTO)
	{
	    DiagReqType DiagReq;
		Std_ReturnType DataP_idx;
		uint8 Data_idx = 0u;

	    DiagReq.ActionP = DiagActionType_RoutineCtrl;
	    DiagReq.ServiceId = cROUTINE_SECURE_FUSE_PROGRAMMING;
	    DiagReq.LengthP = SecureFuse_Programming_Length + 1u;
	    DiagReq.DataP[0] = DIAGRC_STARTROUTINE;
	    for(DataP_idx=1u;DataP_idx < DiagReq.LengthP;DataP_idx++)
	    {
	        DiagReq.DataP[DataP_idx] = Data[Data_idx];
			Data_idx++;	   
	    }
	    switch(Cybersecdiag_GIPDataReqState)
	    {
	        case eGIP_InitiateRequest:
	            ret = Meet_Process_Gip_Diag_Request_Crypto(Cybersecdiag_GIPDataReqState, &DiagReq, ErrorCode);
			    Cybersecdiag_GIPDataReqState = eGIP_WaitForResponse;
	            break;
	        case eGIP_WaitForResponse:
	            ret = Meet_Process_Gip_Diag_Request_Crypto(Cybersecdiag_GIPDataReqState, &DiagReq, ErrorCode);
				if(ret != DCM_E_PENDING)	
	            {
	                Cybersecdiag_GIPDataReqState = eGIP_InitiateRequest;	
					DiagReq.ActionP = 255U;
					Diag_TIGIP_SendDiagRequest(&DiagReq);					
	            }
				
	            break;
	        default:
					/*NULL*/
	            break;
	    }
    }
    #endif        
    return ret;		
}
/*=====================================================================================================================
**
** Function Name    :  Cybersecdiag_SecureFuse_Reading
**
** Visibility       :  Private
**
** Description      :  calls API to read status of Secure Fuse Key
**
** Invocation       :  Cybersec.diagcdd , Function:Cybersecdiag_SecureFuse_Reading_RCStart
**
** Inputs           :  Data[In]:Data
**
** Outputs          :    	DCM_E_PENDING - 10
                            DIAG_POSITIVERESPONSE - 0
                            DIAG_CONDITIONSNOTCORRECT - 34
                            DIAG_INCORRECTMESSAGELENGTHORINVALIDFORMAT - 19
**
** Critical Section : Yes/No
**
**====================================================================================================================*/

static Std_ReturnType Cybersecdiag_SecureFuse_Reading(uint8 *Data,uint8 *ErrorCode)
{
	Std_ReturnType ret = E_NOT_OK;
    #if defined (MEET_GIP_ENABLED) && defined(MEET_GIP_ENABLED_CRYPTO)
	{
	   	DiagReqType DiagReq;
		SDiagResponse_t DiagResp;
		Std_ReturnType DataP_idx;
		uint8 Data_idx = 0u;
	    DiagReq.ActionP = DiagActionType_RoutineCtrl;
	    DiagReq.ServiceId = cROUTINE_SECURE_FUSE_READING;
	    DiagReq.LengthP = SecureFuse_reading_Length+1u;
		DiagReq.DataP[0] = DIAGRC_STARTROUTINE;
		for(DataP_idx=1u;DataP_idx < DiagReq.LengthP;DataP_idx++)
	    {
	        DiagReq.DataP[DataP_idx] = Data[Data_idx];
			Data_idx++;	   
	    }
	    switch(Cybersecdiag_GIPDataReqState)
	    {
	        case eGIP_InitiateRequest:
	            ret = Meet_Process_Gip_Diag_Request_Crypto(Cybersecdiag_GIPDataReqState, &DiagReq, ErrorCode);
				Cybersecdiag_GIPDataReqState = eGIP_WaitForResponse;
	            break;
	        case eGIP_WaitForResponse:
	            ret = Meet_Process_Gip_Diag_Request_Crypto(Cybersecdiag_GIPDataReqState, &DiagReq, ErrorCode);
				if(ret != DCM_E_PENDING)
	            {
	                Cybersecdiag_GIPDataReqState = eGIP_InitiateRequest;	
					DiagReq.ActionP = 255U;
					Diag_TIGIP_SendDiagRequest(&DiagReq);					
	            }
	            break;
	        default:
					/*NULL*/
	            break;
	    }
		if(DCM_E_OK == ret)
		{
			DiagResp = *Diag_TIGIP_GetDiagResponse();
			if(4u == DiagResp.Length)
			{
				Data[DATA_BYTE_1] = DiagResp.DiagRespBuffer[DATA_BYTE_0];
				Data[DATA_BYTE_2] = DiagResp.DiagRespBuffer[DATA_BYTE_1];
				Data[DATA_BYTE_3] = DiagResp.DiagRespBuffer[DATA_BYTE_2];
				Data[DATA_BYTE_4] = DiagResp.DiagRespBuffer[DATA_BYTE_3];
			
			}
			else
			{
				//Size mismatch or i/p KeyID's out of range
				ret = DCM_E_NOT_OK;
				Data[DATA_BYTE_1] = 0u;
				Data[DATA_BYTE_2] = 0u;
				Data[DATA_BYTE_3] = 0u;
				Data[DATA_BYTE_4] = 0u;
			}
		}
	}
	#endif 
    return ret;  
}
