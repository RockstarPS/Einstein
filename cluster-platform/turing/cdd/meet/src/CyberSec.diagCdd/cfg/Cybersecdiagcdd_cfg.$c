/*=====================================================================================================================
**
** Function Name    :  Cybersecdiag_JtagPasswordLocking_Status
**
** Visibility       :  Private
**
** Description      :  calls API to write Symmetric Key
**
** Invocation       :  Cybersec.diagcdd , Function:Cybersecdiag_JTAG_passwordProtection_Status
**
** Inputs           :  Data[In]:
**
** Outputs          :  0x00 (locked) - success case.
**					   0x01 (unlocked) - need to execute JTAG password protection again
**					   other than above (unknown status) - need to execute JTAG password protection again.
**
**====================================================================================================================*/
static Std_ReturnType Cybersecdiag_JtagPasswordLocking_Status(uint8 *Data, uint8 *ErrorCode)
{
    Std_ReturnType ret = E_NOT_OK;
    uint8 jtagResult = JTAG_DECRYPT_KEY_SIZE;

    //ret = Cry_Hsm_CheckJtag_Password(DecryptJTAG, &jtagResult);

    if (ret == (uint8)E_NOT_OK)
    {
        *ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
    }
    else
    {
        /* Unlocked -  0 - if keys are not matching, key is registered, protection context is normal
         * Unlocked -  1 - if no key is registered
         * Locked   -  2 - if key is registered and protection context is secure
         * Unlocked - 16 - if keys are matching and registered, protection context is normal
         * Locked   - 18 - if keys are matching and registered, protection context is secure
         */

        switch (jtagResult)
        {
        case PASSWORD_PRESENT:
        case PASSWORD_NOT_PRESENT:
        case PASSWORD_MATCHED:
            Data[0U] = JTAG_UNLOCKED;
            break;

        case PASSWORD_PRESENT_LIFECYCLED:
        case PASSWORD_MATCH_LIFECYCLED:
            Data[0U] = JTAG_LOCKED;
            break;

        default:
            Data[0U] = JTAG_UNLOCKED;
            break;
        }
    }

    return ret;
}
