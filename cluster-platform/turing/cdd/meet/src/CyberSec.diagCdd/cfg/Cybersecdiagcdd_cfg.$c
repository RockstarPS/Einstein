/*=====================================================================================================================
**
** Function Name    :  Cybersecdiag_JtagPasswordLocking_VerifySafeKeyNumber
**
** Visibility       :  Private
**
** Description      :  calls API to verify input SafeKey number with SafeKey number stored in M0
**
** Invocation       :  Cybersec.diagcdd , Function:Cybersecdiag_JTAG_passwordProtection_Write
**
** Inputs           :  uint8 *Data
**
** Outputs          :  Std_ReturnType E_OK - SAME; E_NOT_OK - Different
**
** Critical Section :  No
**
**====================================================================================================================*/
Std_ReturnType Cybersecdiag_JtagPasswordLocking_VerifySafeKeyNumber(uint8 *Data, uint8 *ErrorCode)
{
	Std_ReturnType ret = E_NOT_OK;
	uint8 SafekeyNumber_Stored[CYBERSECDIAG_M4M5_SLOTLENGTH] = {0U};
	uint8 SafekeyNumber_Provided[JTAG_SAFE_KEY_LENGTH] = {0U};
	boolean compareRes = FALSE;
	uint8 idx = 0U;

	//ret = Cybersecdiag_SafeKeyNumber_Read(SafekeyNumber_Stored, ErrorCode);
	
	if(ret == (uint8)E_NOT_OK)
	{
		*ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
		ret = E_NOT_OK;
	}
	else if(ret == (uint8)E_OK)
	{
		for (idx = 0U; idx < JTAG_SAFE_KEY_LENGTH; idx++)
		{
			SafekeyNumber_Provided[idx] = Data[idx];
		}

		/* Compare Safe Key already stored with input Data */
		compareRes = MemLib_MemCmp((uint8 *)SafekeyNumber_Stored, (uint8 *)SafekeyNumber_Provided, (uint32)JTAG_SAFE_KEY_LENGTH);
		
		if(TRUE == compareRes)
		{
			/* Input Safe Key number is same as already stored Safe key number */
			ret = E_OK;
		}
		else
		{
			/* Input Safe Key number is different from already stored Safe key number */
			*ErrorCode = DCM_E_GENERALPROGRAMMINGFAILURE;
			ret = E_NOT_OK;
		}
	}
	else
	{
		ret = DCM_E_PENDING;
	}

	return ret;
}
