		key_start_idx++;
	}		
		
	//ret = VisteonObfuscateLib_DecryptItem_v2(Jtag_Enc_Key_array, JTAG_ENCRYPT_BLOB_LENGTH, Jtag_Dec_Key_array, JTAG_DECRYPT_KEY_SIZE);
			
	if((uint8)E_NOT_OK == ret)
