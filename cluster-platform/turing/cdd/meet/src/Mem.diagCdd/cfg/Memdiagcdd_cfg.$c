static Std_ReturnType MemDiag_NANDFlash_ChecksumStart(uint8 *Data,uint8 *ErrorCode)
{

    Std_ReturnType ret = E_NOT_OK;
#ifdef MEET_GIP_ENABLED
    Std_ReturnType Data_idx;
    DiagReqType DiagReq;

    DiagReq.ActionP = DiagActionType_RoutineCtrl;
    DiagReq.ServiceId = cROUTINE_CHECKSUMTEST;
    DiagReq.LengthP = flashmemoryChksumTestStart_Length+1;
    DiagReq.DataP[0] = MGRDIAGCDD_ROC_START_ACTION;
    for(Data_idx=1;Data_idx < DiagReq.LengthP;Data_idx++)
    {
       DiagReq.DataP[Data_idx] = Data[Data_idx];
    }
    switch(Memdiag_GIPDataReqState)
    {
        case eGIP_InitiateRequest:
            ret = Meet_Process_Gip_Diag_Request(Memdiag_GIPDataReqState, &DiagReq, ErrorCode);
            Memdiag_GIPDataReqState = eGIP_WaitForResponse;
            break;
        case eGIP_WaitForResponse:
            ret = Meet_Process_Gip_Diag_Request(Memdiag_GIPDataReqState, &DiagReq, ErrorCode);
            if(ret != DCM_E_PENDING)
            {
                Memdiag_GIPDataReqState = eGIP_InitiateRequest;
            }
            break;
        default:
            /*No action required in default case*/
            break;
    }
#endif
    return ret;		



}
