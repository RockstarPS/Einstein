/*=====================================================================================================================
**
** Function Name    :  MemDiag_Data_Read_By_Address
**
** Visibility       :  Private 
**
** Description      :  calls API to read Data from NVM
**                      
** Invocation       :  Mem.diagcdd , Function:MemDiag_Data_Read_By_Address
**
** Inputs           :  Data[Out]: NVM Data
**
** Outputs          :  E_OK : Success
**					   E_NOT_OK: Fail
**
** Critical Section : Yes/No
**
**====================================================================================================================*/
static Std_ReturnType MemDiag_Data_Read_By_Address(uint8 *Data)
{
	Std_ReturnType ret = E_NOT_OK;
	uint32 EepromAddress = 0U;
	uint16 Length = 0U;
	
	EepromAddress = (uint32)((Data[DATA_BYTE_1] << 16U | Data[DATA_BYTE_2] << 8U | Data[DATA_BYTE_3]) & 0xFFFFFFFF);
	Length = (uint16)(Data[DATA_BYTE_4] & 0xFFFF);
	
	MemLib_MemSet(NVM_RCRead_Data_By_Address,0U,MEMDIAG_MAX_BYTES_READ_BY_ADDRESS); /*Clear the buffer*/
	ret = NvMExt_ReadAddress(EepromAddress, &NVM_RCRead_Data_By_Address[0], Length);
	
	if(ret == E_OK)
	{
		Data[DATA_BYTE_0] = (uint8)eROUTINE_INPROGRESS; /* Cluster ACK = 1*/
		MemDiag_Data_ReadWrite_JobResult = (uint8)MEMIF_JOB_PENDING;
	}
	else
	{
		Data[DATA_BYTE_0] = (uint8)eROUTINE_FINISH_NOK; /* Cluster NACK = 0*/
		MemDiag_Data_ReadWrite_JobResult = (uint8)MEMIF_JOB_FAILED;
	}
	
	return E_OK;
}

