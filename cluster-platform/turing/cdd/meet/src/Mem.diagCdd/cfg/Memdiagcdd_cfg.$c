/*=====================================================================================================================
**
** Function Name    :  MemDiag_ReadWrite_JobResult
**
** Visibility       :  Private 
**
** Description      :  calls API to NVM Data Read Write JOB status
**                      
** Invocation       :  Mem.diagcdd , Function:MemDiag_ReadWrite_JobResult
**
** Inputs           :  Data[In]: NVM Data Read Write JOB status
**
** Outputs          :  E_OK : Success
**					   E_NOT_OK: Fail
**
** Critical Section : Yes/No
**
**====================================================================================================================*/
static void MemDiag_ReadWrite_JobResult(uint8* Data)
{
	switch(MemDiag_Data_ReadWrite_JobResult)
	{
		case MEMIF_JOB_OK:
			if(Data[DATA_BYTE_0] != MEMDIAG_WRITE_PROCESS)
			{
				MemLib_MemCpy(&Data[DATA_BYTE_1],&NVM_RCRead_Data_By_Address[0],MEMDIAG_MAX_BYTES_READ_BY_ADDRESS);
			}
			Data[DATA_BYTE_0] = (uint8)eROUTINE_FINISH_OK;
			break;
		case MEMIF_JOB_FAILED:
			Data[DATA_BYTE_0] = (uint8)eROUTINE_FINISH_NOK;
			break;
		case MEMIF_JOB_PENDING:
			Data[DATA_BYTE_0] = (uint8)eROUTINE_INPROGRESS;
			break;
		case MEMIF_JOB_CANCELED:
			Data[DATA_BYTE_0] = (uint8)eROUTINE_STOPPED;
			break;
		case MEMIF_BLOCK_INCONSISTENT:
			Data[DATA_BYTE_0] = (uint8)eROUTINE_STOPPED;
			break;
		case MEMIF_BLOCK_INVALID:
			Data[DATA_BYTE_0] = (uint8)eROUTINE_STOPPED;
			break;
			
		default:
			Data[DATA_BYTE_0] = (uint8)eROUTINE_STOPPED;
			break;
	}
}
