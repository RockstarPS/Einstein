/*=====================================================================================================================
**
** Function Name    : Read_ADC_channel_Unit_WCalib_for_CH1
**
** Visibility       :  private
**
** Description      :  ADC input reading by channel
**
** Invocation       :	Ioctrlrd_analog_Cmp_ADCReading_by_unit_WCalib
**
** Inputs           :  Input arguments - ADC voltage
**
** Outputs          :  void
**
** Critical Section : Yes/No
**
**====================================================================================================================*/
static void Read_ADC_channel_Unit_WCalib_for_CH1(uint16 *Read_adc_voltage)
{
    uint32  MeasuringTimeout = 0;
    uint16 Tmp = IOADCID_INIT;
    Std_ReturnType fl_Adc_Result_U8;

    
    TmExt_BusyWait1ns( cNanosecondsToWait );

    // Start conversion


    fl_Adc_Result_U8 =  Adc_GetGroupStatus((Adc_GroupType)AdcConf_AdcGroup_AdcGroup_MAI_FUEL_LEVEL);

    if(ADC_STREAM_COMPLETED == fl_Adc_Result_U8)
    {
       (void)Adc_ReadGroup((Adc_GroupType) AdcConf_AdcGroup_AdcGroup_MAI_FUEL_LEVEL, &Tmp);
    }
   
    if(ADC_BUSY != fl_Adc_Result_U8)
    {

        Adc_StartGroupConversion((Adc_GroupType)AdcConf_AdcGroup_AdcGroup_MAI_FUEL_LEVEL);
        //Read until result ready
        do
        {
           MeasuringTimeout++;
        }
        while( (Adc_ReadGroup(AdcConf_AdcGroup_AdcGroup_MAI_FUEL_LEVEL, &Tmp) != E_OK) &&
                    (MeasuringTimeout < MEASURING_TIME_OUT) );	
    }

    TmExt_BusyWait1ns( cNanosecondsToWait );

    *Read_adc_voltage  = (uint16)Tmp;
}

//----------------------------------------------------------------------------------------------------------------------
//FUNCTION_NAME:		Ioctrlrd_Read_ADC_channel_GetByUnit_StateMachine
//
// DESCRIPTION:         Function to compute ADC reading by state machine which needs special implementations
//
// PARAMETERS:			ADC_Val - The input adc value to be computed,index 	- ADC channel index, status - Adc completion status
//
// RETURN VALUE:		ADC_Val - Std_ReturnType: Computed ADC value in Units
//
// DESIGN INFORMATION:  None
//----------------------------------------------------------------------------------------------------------------------
uint16 Ioctrlrd_Read_ADC_channel_GetByUnit_StateMachine(uint32 nfuel)
{
	sint32 s32CurrentTemp = IOCTRLRD_ANALOG_CLR_0_WCalib ;
	sint32 s32CurrentTemp_NUM = IOCTRLRD_ANALOG_CLR_0_WCalib ;
	uint32 u32CurrentTemp_NUM1 = IOCTRLRD_ANALOG_CLR_0_WCalib ;
	uint32 u32CurrentTemp_NUM2 = IOCTRLRD_ANALOG_CLR_0_WCalib ;
	uint32 u32CurrentTemp_NV_Y_MINUS= IOCTRLRD_ANALOG_CLR_0_WCalib ;
	uint32 u32CurrentTemp2_div_res= IOCTRLRD_ANALOG_CLR_0_WCalib ;
	uint32 u32CurrentTemp2_act_res= IOCTRLRD_ANALOG_CLR_0_WCalib;
	uint32 u32CurrentTemp2_act_mul=IOCTRLRD_ANALOG_CLR_0_WCalib;

	uint32 u32CurrentTemp2_DEN = IOCTRLRD_ANALOG_CLR_0_WCalib ;
			
	uint16 NV_XFuelValue = IOCTRLRD_ANALOG_CLR_0_WCalib;
	uint16 NV_YFuelValue = IOCTRLRD_ANALOG_CLR_0_WCalib;
	
	//To be replaced with actual RTE 
	
	//Rte_Read_Meet_CDD_NV_XFuelValue_Value(&NV_XFuelValue);
	//Rte_Read_Meet_CDD_NV_YFuelValue_Value(&NV_YFuelValue);
	(void)Rte_Call_rpNV_FuelGainOffset_Get_NV_FuelGainOffset(&NV_XFuelValue,&NV_YFuelValue);

	u32CurrentTemp_NUM1  = (256 * (nfuel * 8U));
	u32CurrentTemp_NV_Y_MINUS= (NV_YFuelValue - 32512);
	u32CurrentTemp_NUM2 = (uint32)(16320*u32CurrentTemp_NV_Y_MINUS);
	s32CurrentTemp_NUM =u32CurrentTemp_NUM1 -u32CurrentTemp_NUM2;
	u32CurrentTemp2_DEN = (128000 + NV_XFuelValue) ;
	u32CurrentTemp2_div_res =s32CurrentTemp_NUM/u32CurrentTemp2_DEN;
	u32CurrentTemp2_act_mul =(u32CurrentTemp2_div_res*80);
	u32CurrentTemp2_act_res =u32CurrentTemp2_act_mul/51;
	s32CurrentTemp =u32CurrentTemp2_act_res;

	if(s32CurrentTemp  < IOCTRLRD_FUEL_INPUT_NOT_NEGETIVE_WCalib)
	{
		s32CurrentTemp  = IOCTRLRD_ANALOG_CLR_0_WCalib;
	}
	else if(s32CurrentTemp  > IOCTRLRD_FUEL_INPUT_ADC_OVERFLOW_WCalib)
	{
		s32CurrentTemp  = IOCTRLRD_FUEL_INPUT_ADC_OVERFLOW_WCalib;
	}
	else
	{
		/*No action required*/
	}

return ((uint16)(s32CurrentTemp));
}

