Std_ReturnType Ioctrld_Fuel_Sender_1_Read(uint8 *Data)
{
    Std_ReturnType Ret = E_NOT_OK;
    tConfigFuelLvlPCM fl_AVGFLPS_ConfigEnabled;
    uint32 fl_fuelAvgFlps = DIDZERO;

    Rte_Read_rp_SR_Config_Data_ConfigVar_FuelLvl_PCM(&fl_AVGFLPS_ConfigEnabled);

    if(eConfigFuelLvlPCM_FuelLvlIPC != fl_AVGFLPS_ConfigEnabled)
    {
        *Data = DCM_E_REQUESTOUTOFRANGE;
    }
    else
    {
    	Rte_Read_rp_SR_Gauges_Data_FuelFlps(&fl_fuelAvgFlps);
        Data[DIDZERO]= (uint8)((fl_fuelAvgFlps >> DIDBYTE14) & DID_U16_2LSBMASK);
        Data[DIDONE] = (uint8)((fl_fuelAvgFlps >> DIDBYTE6)  & DID_U16_U8_MASK);
        Ret = DCM_E_OK;
    }
return Ret;
}
