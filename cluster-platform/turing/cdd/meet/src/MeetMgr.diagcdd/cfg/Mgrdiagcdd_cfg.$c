Std_ReturnType Meet_Mgrdiagcdd_Get_GIP_DID_Data(uint8* Data, uint32* DID)
{
	Std_ReturnType Ret = E_NOT_OK;
	static uint8 Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index = 0U;

	for(Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index = 0; Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index < NO_OF_NON_DCM_DIDS; Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index++)
	{
		if((Meet_Cdd_NonDcm_Read_GIP_DID_Table[Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index].l_did_number == *DID) && (Meet_Cdd_NonDcm_Read_GIP_DID_Table[Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index].DID_Status != E_NOT_OK))
		{
			(void)memcpy(Data, Meet_Cdd_NonDcm_Read_GIP_DID_Table[Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index].DID_Data, Meet_Cdd_NonDcm_Read_GIP_DID_Table[Meet_Cdd_NonDcm_GIP_Read_DID_Table_Index].Data_size);
			Ret = E_OK;
			break;
		}

	}
return Ret;
}
