			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 Start GPT timer with calculated \ulwave timeout\ulnone\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">2.18.2026::6:5:38</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID 886a68bf-0e67-47fc-91b4-cfb6f61fb39e</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_64</_name>
			<_modifiedTimeWeak type="a">2.18.2026::6:54:49</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">5ms - The trigger pin will be high%0D
Pmic_IsrState = PMIC_WDG_HIGH_GAP</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">2.18.2026::6:5:39</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID 1965b9c2-69a7-437b-a094-3f2956c4b77b</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_65</_name>
			<_modifiedTimeWeak type="a">2.18.2026::6:54:49</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">WIN1 + WIN2 -5ms - The trigger pin will be low. Pmic_IsrState = PMIC_WDG_LOW_GAP</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">2.18.2026::6:5:39</_modifiedTime>
		</IComment>
