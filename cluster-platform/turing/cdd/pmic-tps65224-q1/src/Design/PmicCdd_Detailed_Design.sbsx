		</IComment>
		<IComment type="e">
			<_id type="a">GUID cf973e34-7e90-4545-a0f2-b3921a547d71</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_40</_name>
			<_modifiedTimeWeak type="a">2.18.2026::6:54:49</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 Calculate \ulwave timeout\ulnone :\par%0D
PmicWdgTimeout = (Timeout * ClockHz) / 1000\par%0D
Setup GPT Timer\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">2.18.2026::6:5:36</_modifiedTime>
		</IComment>
