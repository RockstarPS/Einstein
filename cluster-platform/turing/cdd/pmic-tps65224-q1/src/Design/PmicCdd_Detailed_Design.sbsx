			<_modifiedTime type="a">2.20.2026::8:59:43</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID 22eae41a-35b5-47cb-a4f3-702091ef2a3a</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_18</_name>
			<_modifiedTimeWeak type="a">3.9.2026::9:45:9</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\ulwave\fs20 After Fault recovered BUCK and LDOs are powered up y PMIC\ulnone , and \par%0D
corresponding BUCKx_UVOV_INT bit set\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.9.2026::9:45:9</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID 945d8a2f-6868-4888-8995-2f4bd49f4a5a</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_19</_name>
			<_modifiedTimeWeak type="a">3.6.2026::4:58:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">The [MODULE-A.13 BG_CROSSMON] is continuously enabled in mission states and is disabled when low %0D
power mode is enabled (when LPM_EN bit is set to '1').</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::4:58:0</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID babbc078-d2c9-4813-8ac4-ca1b334fb005</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_20</_name>
			<_modifiedTimeWeak type="a">3.6.2026::9:11:14</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 Once the main \ulwave bandgap\ulnone  and Safe \ulwave bandgap\ulnone  difference is less than +/- \ulwave thresold\ulnone , then system restarts\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::9:11:14</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID 2940f32c-7aac-4450-800a-fccdb0bdca71</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_21</_name>
			<_modifiedTimeWeak type="a">3.6.2026::9:32:59</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">After the CRC error is recovered, then the system restarts</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::9:32:59</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID af4fe17d-5e97-4d56-a005-aaadfe8f056c</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_22</_name>
			<_modifiedTimeWeak type="a">3.6.2026::9:4:20</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Retry the Transmit for PMICCDD_I2C_CRC_RETRYCOUNT = 3 times</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::9:4:20</_modifiedTime>
		</IComment>
