			<_modifiedTimeWeak type="a">3.6.2026::9:9:33</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">All regulators switched off withpull-down resistors and GPIOz outputs set to low immediately</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::9:9:33</_modifiedTime>
