		<IComment type="e">
			<_id type="a">GUID e13755b5-cccb-4865-9763-41f7140398d7</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_36</_name>
			<_modifiedTimeWeak type="a">2.18.2026::6:54:49</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Configure WDG registers via I2C sequences:%0D
    - PmicCdd_WdWin1Cfg (normal window)%0D
    - PmicCdd_WdWin2Cfg (recovery window)%0D
    - PmicCdd_WdLongWin_Cfg (long window)%0D
    - PmicCdd_WdThrCfg (threshold)%0D
    - PmicCdd_WdMode (set to TRIGGER mode)%0D
Enable GPT (General Purpose Timer) for watchdog timing</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">2.18.2026::6:5:35</_modifiedTime>
		</IComment>
		<IComment type="e">
			<_id type="a">GUID 3ec77cdb-63fd-4c83-8880-86495038ac69</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_37</_name>
			<_modifiedTimeWeak type="a">2.18.2026::6:54:49</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Set watching mode</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">2.18.2026::6:5:35</_modifiedTime>
		</IComment>
