		<IConstraint type="e">
			<_id type="a">GUID f270b6fb-ee64-4154-bc91-1c8b438db11a</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">ResetThresold</_name>
			<_modifiedTimeWeak type="a">3.10.2026::11:13:50</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Recovery counter limit %0D
exceeded = ORDERLY_SHUTDOWN will not happen if RECOV_CNT_THR = 0, even though RECOV_CNT continues to accumulate and increase, and eventually %0D
saturates when RECOV_CNT reaches the maximum count of 15.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.10.2026::11:13:50</_modifiedTime>
		</IConstraint>
		<IComment type="e">
			<_id type="a">GUID f8ead3dd-bc61-4e4f-847d-844bbc9aa305</_id>
			<_myState type="a">10240</_myState>
			<_name type="a">comment_31</_name>
			<_modifiedTimeWeak type="a">5.13.2026::4:32:53</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Timeout Vaue is set - PmicCdd can service that much time if PmicCdd_WdgSetTriggerCondition is not called</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">5.13.2026::4:32:53</_modifiedTime>
		</IComment>
