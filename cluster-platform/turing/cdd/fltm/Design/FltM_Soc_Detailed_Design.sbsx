			<m_pNoteText type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fbidi\fprq15\fcharset0 Tahoma;}{\f1\fmodern\fprq9\fcharset0 Tahoma;}}%0D
\viewkind4\uc1\pard\f0\fs16 FltM Soc Component handles all Fault management of the SoC like:\par%0D
1. ECC\par%0D
2. DCC\par%0D
3. OCOCLKDET\par%0D
4. PPU\par%0D
5. Flash Integrity\f1\par%0D
}%0D
</_textRTF>
			</IDescription>
			</m_pNoteText>
		</CGIAnnotation>
