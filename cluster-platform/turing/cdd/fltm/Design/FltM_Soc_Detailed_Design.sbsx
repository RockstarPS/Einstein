		<IConstraint type="e">
			<_id type="a">GUID 31f3c62b-bd81-4252-9f9c-b6f6ae033b0e</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">FltM_FlashIntegrity1</_name>
			<_modifiedTimeWeak type="a">8.8.2025::7:32:56</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Constraint: The Vector table should not be considered as part of Flash Integrity test.%0D
Rationale: Vector table is updated during runtime so the checksum will not get matched.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">8.8.2025::7:32:56</_modifiedTime>
			<_body type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20\par%0D
}%0D
</_body>
		</IConstraint>
		<IConstraint type="e">
			<_id type="a">GUID b5c6503d-6b6e-48c5-a767-8cd5749a9d04</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">FltM_FlashIntegrity2</_name>
			<_modifiedTimeWeak type="a">8.8.2025::9:7:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Constraint: Flash code integrity is performed in background hence not possible to reach safe state within FHTI.%0D
Rationale: The FltM_FlashIntegrity function is invoked every 10 ms; checksum calculation spans many cycles, so completion within FHTI is impossible.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">8.8.2025::9:7:38</_modifiedTime>
			<_body type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20\par%0D
}%0D
</_body>
		</IConstraint>
		<IConstraint type="e">
			<_id type="a">GUID 3c798243-4e91-4862-aa79-f42525be0ad2</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">FltM_PeripheralProtection1</_name>
			<_modifiedTimeWeak type="a">10.14.2025::7:39:34</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">As per SSR Requirement &quot;PE4TI29141-1832&quot;, Software shall configure firewalls to prevent erroneous accesses to hardware parts of device which are not used. According to TI, we can protect peripheral in LPSC level only. But in E4.0 platform, atleast one peripheral is used from one LPSC.. %0D
%0D
If no peripheral within the LPSC group are used in the program, then that LPSC shall be protected.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.14.2025::7:39:34</_modifiedTime>
		</IConstraint>
