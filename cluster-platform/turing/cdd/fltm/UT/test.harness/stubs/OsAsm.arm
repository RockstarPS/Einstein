.include "OsCoreDefine.inc"
.inspect "OsInternal.h"
.inspect "OsMain.h"

;-+--------------------------------------------------------------------------
; macros ;
; ** temp solution as global define is not picked by GHS assembler
;----------------------------------------------------------------------------

;#define RTM_ENABLED
;-+--------------------------------------------------------------------------
; Symbol export                                                             
;----------------------------------------------------------------------------
.export osStartOSasmArm
.export osDispatchAsm
.export osSetBitsARMCoreSCTLR
.export osClearBitsARMCoreSCTLR
;.export osGetBitsARMCoreSCTLR
