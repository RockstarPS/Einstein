RESULT.CBA.FUNCTION: RtcDrvCdd_SetAlarm
RESULT.CBA.LINE.BEGIN
RESULT.CBA.LINE: 15
RESULT.CBA.CONTEXT: if((0x00U) == RetVal
RESULT.CBA.CONTEXT_BEFORE:
  // Set current minute, hour, day alarm values
  RetVal = RtcDrvCdd_i2cWriteRegisters((0x08), &aTxBuffer[(0x08)], (3u), &I2c_CircularBuffer);
RESULT.CBA.CONTEXT_BEFORE_END
RESULT.CBA.CONTEXT_AFTER:
  {
   // Set AIE bit to make sure /INT pin gets pulled low when alarm triggers
RESULT.CBA.CONTEXT_AFTER_END
RESULT.CBA.LINE.END
