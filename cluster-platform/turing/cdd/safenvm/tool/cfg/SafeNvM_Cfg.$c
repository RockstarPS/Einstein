  (void)Rte_Write_BsConst_Compensation_Line_Slope_m_Value(pAsilRamCopy1->BsConst_Compensation_Line_Slope_m); 
  (void)Rte_Write_BsConst_Compensation_Line_Shift_b_Value(pAsilRamCopy1->BsConst_Compensation_Line_Shift_b); 
  (void)Rte_Write_BsConst_Lookup_Curve_HotSpot_Coef_X_Value(pAsilRamCopy1->BsConst_Lookup_Curve_HotSpot_Coef_X); 
  (void)Rte_Write_BsConst_Lookup_Curve_HotSpot_Coef_Y_Value(pAsilRamCopy1->BsConst_Lookup_Curve_HotSpot_Coef_Y); 
  (void)Rte_Write_BsConst_Temp_Threshold_Hysteresis_Derating_Value(pAsilRamCopy1->BsConst_Temp_Threshold_Hysteresis_Derating); 
  (void)Rte_Write_BsConst_Derating_Backlight_Disable_Value(pAsilRamCopy1->BsConst_Derating_Backlight_Disable); 
  (void)Rte_Write_BsConst_Temperature_Sensor_Conv_Value(pAsilRamCopy1->BsConst_Temperature_Sensor_Conv); 
  (void)Rte_Write_BsConst_PCB_Temperature_Sensor_Conv_Value(pAsilRamCopy1->BsConst_PCB_Temperature_Sensor_Conv); 
  (void)Rte_Write_BsConst_Display_Illum_Max_Level_Value(pAsilRamCopy1->BsConst_Display_Illum_Max_Level); 
  (void)Rte_Write_BsConst_PWM_boost_bypass_duty_Value(pAsilRamCopy1->BsConst_PWM_boost_bypass_duty); 
  (void)Rte_Write_BsConst_BsConst_Illumination_ReservedByte_Value(pAsilRamCopy1->BsConst_BsConst_Illumination_ReservedByte);
  SafeNvM_AsilData_Status = 1U;
}



void OnDre_SafeNvM_Illumination(void)
{
  NV_Data_BsConst_Illumination * pAsilRamCopy = NvMSafe_Blockconfig[0].AsilCopyPtr;
  if(SafeNvM_AsilData_Status == 0U)
  {
 
  (void)Rte_Read_BsConst_Compensation_Line_Slope_m_Value(pAsilRamCopy->BsConst_Compensation_Line_Slope_m); 
  (void)Rte_Read_BsConst_Compensation_Line_Shift_b_Value(pAsilRamCopy->BsConst_Compensation_Line_Shift_b); 
  (void)Rte_Read_BsConst_Lookup_Curve_HotSpot_Coef_X_Value(pAsilRamCopy->BsConst_Lookup_Curve_HotSpot_Coef_X); 
  (void)Rte_Read_BsConst_Lookup_Curve_HotSpot_Coef_Y_Value(pAsilRamCopy->BsConst_Lookup_Curve_HotSpot_Coef_Y); 
  (void)Rte_Read_BsConst_Temp_Threshold_Hysteresis_Derating_Value(pAsilRamCopy->BsConst_Temp_Threshold_Hysteresis_Derating); 
  (void)Rte_Read_BsConst_Derating_Backlight_Disable_Value(pAsilRamCopy->BsConst_Derating_Backlight_Disable); 
  (void)Rte_Read_BsConst_Temperature_Sensor_Conv_Value(pAsilRamCopy->BsConst_Temperature_Sensor_Conv); 
  (void)Rte_Read_BsConst_PCB_Temperature_Sensor_Conv_Value(pAsilRamCopy->BsConst_PCB_Temperature_Sensor_Conv); 
  (void)Rte_Read_BsConst_Display_Illum_Max_Level_Value(pAsilRamCopy->BsConst_Display_Illum_Max_Level); 
  (void)Rte_Read_BsConst_PWM_boost_bypass_duty_Value(pAsilRamCopy->BsConst_PWM_boost_bypass_duty); 
  (void)Rte_Read_BsConst_BsConst_Illumination_ReservedByte_Value(pAsilRamCopy->BsConst_BsConst_Illumination_ReservedByte);
  (void)SafeNvM_SetWriteBlockReq(0);
  }
  else
  {
    SafeNvM_AsilData_Status = 0U;
  }
}

