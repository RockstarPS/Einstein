<?xml version="1.0" encoding="UTF-8"?>
<project>
	<name>vPlatform</name>
	<modules>
		<module>
			<name>EcuAppM</name>
    		<periodicity>10</periodicity>
			<validation>enable</validation>
    		<gen-path>..\gen-files</gen-path>
			<verbose>1</verbose>
			<wakeup-sources>
				<wakeup-source name="BATTERY">
					<wakeup-mask     type="uint32">ECUM_WKSOURCE_POWER</wakeup-mask>
					<validation-time type="uint16">0</validation-time>
					<wakeup-reaction type="uint8">FULL</wakeup-reaction>
				</wakeup-source>
				<wakeup-source name="CAN">
					<wakeup-mask     type="uint32">ECUM_WKSOURCE_CAN</wakeup-mask>
					<validation-time type="uint16">20</validation-time>
					<wakeup-reaction type="uint8">FULL</wakeup-reaction>
				</wakeup-source>
				<wakeup-source name="RTC">
					<wakeup-mask     type="uint32">ECUM_WKSOURCE_RTC</wakeup-mask>
					<validation-time type="uint16">10</validation-time>
					<wakeup-reaction type="uint8">PARTIAL</wakeup-reaction>
				</wakeup-source>
				<wakeup-source name="MEET">
					<wakeup-mask     type="uint32">ECUM_WKSOURCE_MEET</wakeup-mask>
					<validation-time type="uint16">10</validation-time>
					<wakeup-reaction type="uint8">PARTIAL</wakeup-reaction>
				</wakeup-source>
			</wakeup-sources>
			<groups-config>
				<group-general-config>
					<activation-type    type="uint8" >ASYNCHRONUS</activation-type>
				</group-general-config>
				<group name="Power">
					<wakeup-source-mask type="uint32">0x100FF</wakeup-source-mask>
					<activation-phase   type="uint8" >PRE_GROUP0</activation-phase>
					<safety-level       type="uint8" >QM</safety-level>
					<deactivation-type  type="uint8" >SHUTDOWN</deactivation-type>
					<fail-safe-timeout  type="uint16">1000</fail-safe-timeout>
					<attributes         type="uint8" >0x00</attributes>
   		 			<components>
						<component name="power_cdd" api="standard-api">
							<rport>rp_CmpLibCmd</rport>
							<life-cycle-api>CCDD_EcuPowerM_Impl_OnCommand</life-cycle-api>
							<status-notify-api>NULL_PTR</status-notify-api>
						</component>
   		 			</components>
				</group>
				<group name="SystemControl">
					<wakeup-source-mask type="uint32">0x100FF</wakeup-source-mask>
					<activation-phase   type="uint8" >PRE_GROUP1</activation-phase>
					<safety-level       type="uint8" >QM</safety-level>
					<deactivation-type  type="uint8" >SHUTDOWN</deactivation-type>
					<fail-safe-timeout  type="uint16">1000</fail-safe-timeout>
					<attributes         type="uint8" >0x00</attributes>
   		 			<components>
						<component name="SleepManager" api="standard-api">
							<rport>rp_CmpLibCmd</rport>
							<life-cycle-api>CSleepManager_Impl_OnCommand</life-cycle-api>
							<status-notify-api>NULL_PTR</status-notify-api>
						</component>
   		 			</components>
				</group>
				<group name="Group2">
					<wakeup-source-mask type="uint32">0xFF</wakeup-source-mask>
					<activation-phase   type="uint8" >GENERIC_GROUP</activation-phase>
					<safety-level       type="uint8" >QM</safety-level>
					<deactivation-type  type="uint8" >SHUTDOWN</deactivation-type>
					<fail-safe-timeout  type="uint16">1000</fail-safe-timeout>
					<attributes         type="uint8" >0x00</attributes>
   		 			<components>
						<component name="CDisplayCdd" api="autosar-api">
							<rport>rp_CmpLibCmd</rport>
							<life-cycle-api>rp_CmpLibCmd_CDisplayCdd_Impl_OnCommand</life-cycle-api>
							<status-notify-api>NULL_PTR</status-notify-api>
						</component>
   		 			</components>
				</group>
				<group name="Group3">
					<wakeup-source-mask type="uint32">0x100FF</wakeup-source-mask>
					<activation-phase   type="uint8" >GENERIC_GROUP</activation-phase>
					<safety-level       type="uint8" >QM</safety-level>
					<deactivation-type  type="uint8" >SHUTDOWN</deactivation-type>
					<fail-safe-timeout  type="uint16">1000</fail-safe-timeout>
					<attributes         type="uint8" >0x00</attributes>
   		 			<components>
						<component name="CBacklightCdd" api="autosar-api">
							<rport>rp_CmpLibCmd</rport>
							<life-cycle-api>rp_CmpLibCmd_CBacklightCdd_Impl_OnCommand</life-cycle-api>
							<status-notify-api>NULL_PTR</status-notify-api>
						</component>
   		 			</components>
				</group>
				<group name="Group4">
					<wakeup-source-mask type="uint32">0x10000</wakeup-source-mask>
					<activation-phase   type="uint8" >GENERIC_GROUP</activation-phase>
					<safety-level       type="uint8" >QM</safety-level>
					<deactivation-type  type="uint8" >SHUTDOWN</deactivation-type>
					<fail-safe-timeout  type="uint16">1000</fail-safe-timeout>
					<attributes         type="uint8" >0x00</attributes>
   		 			<components>
						<component name="CMeetCdd" api="standard-api">
							<rport>rp_CmpLibCmd</rport>
							<life-cycle-api>CMeetCdd_Impl_OnCommand</life-cycle-api>
							<status-notify-api>NULL_PTR</status-notify-api>
						</component>
   		 			</components>
				</group>
				<group name="Group5">
					<wakeup-source-mask type="uint32">0xFF</wakeup-source-mask>
					<activation-phase   type="uint8" >GENERIC_GROUP</activation-phase>
					<safety-level       type="uint8" >QM</safety-level>
					<deactivation-type  type="uint8" >SHUTDOWN</deactivation-type>
					<fail-safe-timeout  type="uint16">1000</fail-safe-timeout>
					<attributes         type="uint8" >0x00</attributes>
   		 			<components>
						<component name="GdtCdd" api="autosar-api">
							<rport>rp_CmpLibCmd</rport>
							<life-cycle-api>rp_CmpLibCmd_CGdtCdd_Impl_OnCommand</life-cycle-api>
							<status-notify-api>NULL_PTR</status-notify-api>
						</component>
						<component name="GdtCtrl" api="autosar-api">
							<rport>rp_CmpLibCmd</rport>
							<life-cycle-api>rp_CmpLibCmd_CGdtCtrl_Impl_OnCommand</life-cycle-api>
							<status-notify-api>NULL_PTR</status-notify-api>
						</component>
   		 			</components>
				</group>
			</groups-config>
		 </module>
	 </modules>
</project>
