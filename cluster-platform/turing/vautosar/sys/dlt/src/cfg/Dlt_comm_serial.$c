#ifndef DLT_COMM_SERIAL_C
#define DLT_COMM_SERIAL_C

/*****************************************************************************
*                            Include files                                   *
******************************************************************************/
#include "Dlt_comm_serial.h"

#include "Port_Cfg.h"
#include "misc_api.h"
#include "ipc.h"

/*****************************************************************************
*                                 Locally used Variable Declarations         *
*----------------------------------------------------------------------------*
* Declaration shall be followed by a comment that gives the following info.  *
* about the variable.                                                        *
* purpose, critical section, unit, and resolution                            *
******************************************************************************/

sc_ipc_t                        ipc = 0;

/*****************************************************************************
*                               Functions                                    *
******************************************************************************/
void Dlt_StartCommunicationHook_ScuConsole(void)
{
    sc_ipc_id_t id = PORT_IPC_CHANNEL_ID;
    uint32 i = 0;
    sc_ipc_open(&ipc, id);
}

void Dlt_StopCommunicationHook_ScuConsole(void)
{
    sc_misc_debug_out(ipc, '\n');
    sc_ipc_close(ipc);
}

void Dlt_SendData_ScuConsole(uint8 data)
{
    sc_misc_debug_out(ipc, data);
}

