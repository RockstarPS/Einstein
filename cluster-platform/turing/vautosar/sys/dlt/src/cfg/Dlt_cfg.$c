#ifndef DLT_CFG_C
#define DLT_CFG_C
#include "Dlt_cfg.h"

/* Init buffer size, Max app IDs, Max context Ids, Max context ids per app ID, 
 * Message buffer size */
#define DLT_MEMORY_LIST {DLT_INIT_BUFFER_SIZE, 1, 1, 1, DLT_MESSAGE_BUFFER_SIZE}

/* Max bandwidth for communication, Max bandwidth over DCM, Time window
 * for traffic shaping */
#define DLT_BANDWIDTH_LIST {1024, 1024, 5}

/* Default Max log level, Default Trace status, Factory default max log level
 * To filter or not to filter log or trace messages */
#define DLT_MESSAGE_FILTERING_LIST \
        {DLT_LOG_VERBOSE, FALSE, DLT_LOG_VERBOSE, FALSE}

/* ECU ID, Header Payload endianess, Header to use ECU ID,
 * Header to use extended header, Header to use session ID,
 * Header to use timestamp, Max length of a Dlt log or trace message,
 * To use verbose mode */
#define DLT_PROTOCOL_LIST \
     {0x444C5400, DLT_LITTLE_ENDIAN, FALSE, TRUE, FALSE, FALSE, \
      DLT_MESSAGE_BUFFER_SIZE, TRUE}

Dlt_MemoryType Dlt_Memory = DLT_MEMORY_LIST;

Dlt_BandwidthType Dlt_Bandwidth = DLT_BANDWIDTH_LIST;

Dlt_MessageFilteringType Dlt_MessageFiltering = DLT_MESSAGE_FILTERING_LIST;

Dlt_ProtocolType Dlt_Protocol = DLT_PROTOCOL_LIST;

//Dlt_CommType Dlt_Comm = DLT_COMM_CANTP_SINGLE_FRAME;
Dlt_CommType Dlt_Comm = DLT_COMM_SCU_CONSOLE;
//Dlt_CommType Dlt_Comm = DLT_COMM_CANTP;

#endif
