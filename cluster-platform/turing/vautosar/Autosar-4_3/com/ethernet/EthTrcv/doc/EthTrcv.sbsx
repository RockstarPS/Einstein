/*! @brief Specifies the connection negotiation of the Ethernet transceiver link as Master */%0D
#define ETHTRCV_CONN_NEG_MASTER                     1u%0D
/*! @brief Specifies the connection negotiation of the Ethernet transceiver link as Slave */%0D
#define ETHTRCV_CONN_NEG_SLAVE                      2u</_text>
