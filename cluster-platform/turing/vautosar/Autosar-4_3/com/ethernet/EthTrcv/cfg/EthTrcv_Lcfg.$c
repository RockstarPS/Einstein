/*!*****************************************************************************************************************
*    @file EthTrcv_Lcfg.c
*    @ingroup EthTrcvConfiguration
*    @brief This is EthTrcv Link time configuration source file. It contains definitions of Link time configuration
*    parameters for the EthTrcv module.
********************************************************************************************************************/
/********************************************************************************************************************
*  HEADER INCLUDES                                                                                                  *
********************************************************************************************************************/
#include "EthTrcv.h"
#include "EthTrcv_Lcfg.h"
/********************************************************************************************************************
* #! GLOBAL VARIABLES                                                                                               *
********************************************************************************************************************/

/********************************************************************************************************************
* #! EthTrcv const config  data                                                                                       *
********************************************************************************************************************/
#if (ETHTRCV_WAKEUP_SUPPORT != ETHTRCV_WAKEUP_NOT_SUPPORTED)
/*! @brief the mapping of wake up reasons to wake up sources. 
*   EthTrcvWakeupReason : This parameter defines the transceiver wake up reasons.
*   EcuMWakeupSourceId  : This parameter defines the the wake-up source defined in EcuM. 
*/
extern const EthTrcv_WakeupMapType[ETHTRCV_NUM_OF_WAKEUP_SOURCE]=
{
    { ETHTRCV_WUR_GENERAL , 0U }
};
#endif

/*! @brief Configuration of the transceiver 
*   EthTrcvAutoNegotiationEnabled : Auto-Negotiation is enabled (TRUE) or disabled (FALSE) 
*   EthTrcvCtrlIdx              :  the controller used  
*   EthTrcvIdx                  : the instance ID of the configured transceiver
*   EthTrcvMiiIdx               :  the transceiver index used for MII access to the transceiver
*   EthTrcvTotalTrcvCount       : Num of Trcv configured
*   EthTrcvConnNegType          : the connection negotiation of the Ethernet transceiver link. 
*   EthTrcvDuplexMode           :  the duplex mode of the Ethernet transceiver link 
*   EthTrcvPhysLayerType        : the physical layer type of the Ethernet transceiver link.
*   EthTrcvSpeed                : the speed of the Ethernet transceiver link in [MBit/s]. 
*   EthTrcvIcuChannelId         : Reference to the IcuChannel to enable/disable the interrupts for wakeups 
*   supported if ETHTRCV_WAKEUP_SUPPORT != ETHTRCV_WAKEUP_NOT_SUPPORTED
*   pEthTrcvWakeUpCalloutFunc   : the wakeup callout function name 
*   supported if ETHTRCV_WAKEUP_SUPPORT != ETHTRCV_WAKEUP_NOT_SUPPORTED
*   pEthTrcvWakeupMap           : the mapping of wake up reasons to wake up sources.
*   supported if ETHTRCV_WAKEUP_SUPPORT != ETHTRCV_WAKEUP_NOT_SUPPORTED
*   DemEventParameterId         : the references to DemEventParameter Id.
*   supported if ETHTRCV_DEM_ERROR_DETECT == STD_ON
*/
extern const EthTrcv_ConfigType EthTrcv_Config =
{
    TRUE
    ,0u
    ,0u
    ,0u
    ,1u
    ,ETHTRCV_CONN_NEG_AUTO
    ,ETHTRCV_DUPLEX_MODE_FULL
    ,ETHTRCV_PHYS_LAYER_TYPE_BASE_T
    ,ETHTRCV_BAUD_RATE_100MBIT
    #if (ETHTRCV_WAKEUP_SUPPORT != ETHTRCV_WAKEUP_NOT_SUPPORTED)
    ,0U
    ,NULL_PTR
    ,&EthTrcv_WakeupMap
    #endif
    #if (ETHTRCV_DEM_ERROR_DETECT == STD_ON)
    ,0u
    #endif
};
