			<_description type="p"><IDescription type="e">
				<_text type="a">Defines the Com module status.%0D
typedef enum%0D
{%0D
    /*! @brief The AUTOSAR COM module is not initialized or not usable. This shall be the default value after reset */%0D
    COM_UNINIT = 0U,%0D
    /*! @brief The AUTOSAR COM module is initialized and usable. */%0D
    COM_INIT%0D
}Com_StatusType;</_text>
			</IDescription>
