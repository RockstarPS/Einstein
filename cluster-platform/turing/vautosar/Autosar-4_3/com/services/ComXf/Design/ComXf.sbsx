			<_myState type="a">8192</_myState>
			<_name type="a">ComXf_SignalConfigType</_name>
			<_modifiedTimeWeak type="a">8.20.2025::9:48:1</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">typedef struct%0D
{%0D
    /*! @brief Defines the AUTOSAR type of the signal */%0D
    ComXf_SignalType            SignalType;%0D
    /*! @brief Defines the endianness of the signal's network representation */%0D
    ComXf_SignalEndiannessType  SignalEndiannessType;%0D
    /*! @brief Defines the MS Bit position in the I-PDU data MsBytePosition */%0D
    uint8                       MsBitPosition;%0D
    /*! @brief Defines the LS Bit position in the I-PDU data LsBytePosition */%0D
    uint8                       LsBitPosition;%0D
    /*! @brief Defines the MS Byte position in the I-PDU data bytes*/%0D
    uint32                      MsBytePosition;%0D
    /*! @brief Defines the LS Byte position in the I-PDU data bytes*/%0D
    uint32                      LsBytePosition;%0D
    /*! @brief Defines the Size in bits, for integer signal types . For ComSignalType UINT8_N and UINT8_DYN the size %0D
    shall be configured by ComSignalLength.For ComSignalTypes FLOAT32 and FLOAT64 the size is already defined by the %0D
    signal type and therefore may be omitted*/%0D
    uint32                      BitSize;%0D
    /*! @brief Defines the Size in bytes */%0D
    uint32                      ByteLength;%0D
}ComXf_SignalConfigType;</_text>
			</IDescription>
			</_description>
