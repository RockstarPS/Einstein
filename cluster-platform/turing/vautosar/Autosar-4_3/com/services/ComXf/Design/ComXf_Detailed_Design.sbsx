			<_name type="a">ComXf_SignalEndiannessType</_name>
			<_modifiedTimeWeak type="a">8.20.2025::10:23:14</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the endianness of the signal's network representation as Big endian */%0D
#define COMXF_SIGNAL_ENDIANNESS_TYPE_BIG_ENDIAN 0U%0D
/*! @brief Defines the endianness of the signal's network representation as Little endian */%0D
#define COMXF_SIGNAL_ENDIANNESS_TYPE_LITTLE_ENDIAN 1U%0D
/*! @brief Defines the endianness of the signal's network representation as Opaque.%0D
 With this type , the data is interpret as a n-bytes sized signal*/%0D
#define COMXF_SIGNAL_ENDIANNESS_TYPE_LITTLE_OPAQUE 2U%0D
/*! @brief Defines the endianness of the signal's network representation */%0D
typedef uint8 ComXf_SignalEndiannessType;</_text>
