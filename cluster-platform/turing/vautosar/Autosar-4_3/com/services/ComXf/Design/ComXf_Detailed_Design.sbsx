			<_name type="a">ComXf_SignalType</_name>
			<_modifiedTimeWeak type="a">8.20.2025::10:23:14</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the AUTOSAR type as BOOLEAN*/%0D
#define COMXF_SIGNALTYPE_BOOLEAN    0U%0D
/*! @brief Defines the AUTOSAR type as IEEE754 float32*/%0D
#define COMXF_SIGNALTYPE_FLOAT32    1U%0D
/*! @brief Defines the AUTOSAR type as IEEE754 float64*/%0D
#define COMXF_SIGNALTYPE_FLOAT64    2U%0D
/*! @brief Defines the AUTOSAR type as sint16*/%0D
#define COMXF_SIGNALTYPE_SINT16     3U%0D
/*! @brief Defines the AUTOSAR type as sint32*/%0D
#define COMXF_SIGNALTYPE_SINT32     4U%0D
/*! @brief Defines the AUTOSAR type as sint64*/%0D
#define COMXF_SIGNALTYPE_SINT64     5U  %0D
/*! @brief Defines the AUTOSAR type as sint8*/%0D
#define COMXF_SIGNALTYPE_SINT8      6U%0D
/*! @brief Defines the AUTOSAR type as uint16*/%0D
#define COMXF_SIGNALTYPE_UINT16     7U%0D
/*! @brief Defines the AUTOSAR type as uint32*/%0D
#define COMXF_SIGNALTYPE_UINT32     8U%0D
/*! @brief Defines the AUTOSAR type as uint64*/%0D
#define COMXF_SIGNALTYPE_UINT64     9U%0D
/*! @brief Defines the AUTOSAR type as uint8*/%0D
#define COMXF_SIGNALTYPE_UINT8      10U%0D
/*! @brief Defines the AUTOSAR type as uint8 Dynamic array .%0D
 The maximum length of the array is defined .*/%0D
#define COMXF_SIGNALTYPE_UINT8_DYN  11U%0D
/*! @brief Defines the AUTOSAR type as uint8 array */%0D
#define COMXF_SIGNALTYPE_UINT8_N    12U%0D
/*! Defines the AUTOSAR type of the signal */%0D
typedef uint8 ComXf_SignalType;</_text>
			</IDescription>
			</_description>
