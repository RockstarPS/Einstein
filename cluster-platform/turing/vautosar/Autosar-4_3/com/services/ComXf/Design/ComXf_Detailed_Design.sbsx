			<_name type="a">ComXf_UtilBitCopyPropsType</_name>
			<_modifiedTimeWeak type="a">8.20.2025::10:23:14</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the copy util type */%0D
typedef struct%0D
{%0D
    /*! @brief Defines the source least significant bit position */%0D
    uint8               SrcLsBit;%0D
    /*! @brief Defines the source least significant byte position */%0D
    uint32              SrcLsByte;%0D
    /*! @brief Defines the destination least significant bit position */%0D
    uint8               DestLsBit;%0D
    /*! @brief Defines the destination least significant bit position */%0D
    uint32              DestLsByte;%0D
    /*! @brief Defines the maximum source buffer size */%0D
    uint32              MaxSrcBufferSize;%0D
    /*! @brief Defines the maximum destination buffer size */%0D
    uint32              MaxDestBufferSize;%0D
    /*! @brief Defines the endianess type for the source buffer */%0D
    ComXf_EndianessType SrcBufferEndianess;%0D
    /*! @brief Defines the endianess type for the destination buffer */%0D
    ComXf_EndianessType DestBufferEndianess;%0D
    /*! @brief Defines the signal length in bits */%0D
    uint32              SignalLengthInBits;%0D
    /*! @brief Defines the signal length in bytes */%0D
    uint32              SignalLengthInBytes;%0D
}ComXf_UtilBitCopyPropsType;</_text>
			</IDescription>
			</_description>
