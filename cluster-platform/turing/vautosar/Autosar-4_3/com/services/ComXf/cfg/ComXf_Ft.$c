#include "ComXf.h"
#include "ComXf_Lcfg.h"
/********************************************************************************************************************
* #! PRIVATE MACRO DEFINITIONS                                                                                      *
********************************************************************************************************************/

/********************************************************************************************************************
* #! PRIVATE TYPE DEFINITIONS                                                                                       *
********************************************************************************************************************/

/********************************************************************************************************************
* #! PRIVATE VARIABLE AND CONSTANT DECLARATION                                                                      *
********************************************************************************************************************/
static volatile int ComXf_testVar = 0;
/********************************************************************************************************************
* #! PRIVATE FUNCTION PROTOTYPES                                                                                    *
********************************************************************************************************************/
void ComXf_Test(void);
/********************************************************************************************************************
* #! PUBLIC VARIABLES                                                                                               *
********************************************************************************************************************/
void ComXf_Test(void)
{
    static uint8 MsgBuffer[8]={0,0,0,0,0,0,0,0};
    static Rte_SignalGroup1Type Rte_SignalGroup1={.Sig1 = 1U, .Sig2 = 1U};
    static uint32 MsgBufferLength=8U;
    static Std_VersionInfoType Std_VersionInfo={0};
    switch(ComXf_testVar)
    {
        case 0:
            ComXf_Init(NULL_PTR);
            ComXf_LocalInit();
            ComXf_testVar = 0xffu;
            break;

        case 1:
            ComXf_Signal1SRInterface1(&MsgBuffer[0],&MsgBufferLength,Rte_SignalGroup1);
            break;
        
        case 2:
            ComXf_Inv_Signal1SRInterface1(&MsgBuffer[0],MsgBufferLength,&Rte_SignalGroup1);
            break;
        
        case 3:
            ComXf_GetVersionInfo(&Std_VersionInfo);
            break;

        default:
            break;
    }
    
}

