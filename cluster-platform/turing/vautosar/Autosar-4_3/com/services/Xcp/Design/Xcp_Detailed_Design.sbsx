    Xcp_CmdProcessorReservedCmd,                      /* 0xD3 = ALLOC_ODT_ENTRY */%0D
#endif /* ( XCP_DAQ == STD_ON ) */%0D
#if( (XCP_PROGRAM == STD_ON) || (XCP_BOOTLOADER_DOWNLOAD == STD_ON) )%0D
    Xcp_PgmCmdProcessorProgramStart,                  /* 0xD2 = PROGRAM_START */%0D
#else%0D
