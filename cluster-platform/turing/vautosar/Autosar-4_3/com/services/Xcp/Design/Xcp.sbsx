			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the type for the XCP channel control status */%0D
typedef struct%0D
{%0D
    /*! @brief Defines the XCP channel connection state */%0D
    Xcp_ConnectionStateType                 ConnectionState;%0D
    /*! @brief Defines the XCP channel send status */%0D
    Xcp_ChannelSendStatusType               SendStatus;  %0D
    /*! @brief Defines the XCP channel session status */%0D
    Xcp_ChannelSessionStatusType            SessionStatus;  %0D
    /*! @brief Defines the XCP channel max DTO size */%0D
    Xcp_ChannelSessionStatusType            MaxDto;  %0D
    /*! @brief Defines the XCP channel max CTO size */%0D
    Xcp_ChannelSessionStatusType            MaxCto; %0D
    /*! @brief Defines the XCP channel MTA extension  */%0D
    uint8                                   MTAExtension;%0D
    /*! @brief Defines the XCP channel next data block size for download/upload  */%0D
    uint8                                   NextDataBlockSize;%0D
    /*! @brief Defines the XCP channel current active Transport layer  */%0D
    uint8                                   ActiveTl;%0D
    /*! @brief Defines the XCP channel response pending status */%0D
    boolean                                 ResponsePending;%0D
    /*! @brief Defines the XCP channel current resource protection status */%0D
    Xcp_ChannelResourceProtectionStatusype  ResourceProtectionStatus;%0D
    /*! @brief Defines the XCP channel resource protection Init status */%0D
    Xcp_ChannelResourceProtectionStatusype  ResourceProtectionInitStatus;%0D
    /*! @brief Defines the XCP channel session configuration id */%0D
    uint16                                  SessionConfigurationId;%0D
    /*! @brief Defines the XCP channel event frame length */%0D
    uint16                                  EventFrameLength;%0D
    /*! @brief Defines the XCP channel response buffer length */%0D
    uint16                                  ResponseBufferLen;%0D
    /*! @brief Defines the XCP channel current MTA  */%0D
    Xcp_AddressPtrType                      MTA;%0D
    /*! @brief Defines the XCP channel response buffer  */%0D
    uint8                                   ResponseBuffer[XCP_CTO_MAX_SIZE];%0D
    /*! @brief Defines the XCP channel event frame buffer  */%0D
    uint8                                   EventFrameBuffer[XCP_CTO_MAX_SIZE];%0D
    /*! @brief Defines the XCP channel DAQ list status  */%0D
    Xcp_DaqListStatusType                   Xcp_DaqListStatus;%0D
}Xcp_ChannelCtrlStatusType;</_text>
