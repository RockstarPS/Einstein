			<_modifiedTimeWeak type="a">11.20.2024::12:13:37</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the type for DAQ list status */%0D
typedef struct %0D
{%0D
    /*! @brief Defines the current number of Daq lists supported */%0D
    uint16  NumOfDaqLists;%0D
    /*! @brief Defines the current number of Odts supported */%0D
    uint16  NumOfOdts;%0D
    /*! @brief Defines the current number of Odt Entries supported */%0D
    uint16  NumOfOdtEntries;%0D
    /*! @brief Defines the current active Odt Entry Idx */%0D
    Xcp_OdtEntryIdxType ActiveOdtEntryIdx;%0D
    /*! @brief Defines the array containaing the first Odt id of each Daq */%0D
    Xcp_OdtIdxType FirstOdtIdxOfDaq[XCP_MAX_DAQ];%0D
    /*! @brief Defines the array containing number of odts supported for each daq */%0D
    uint8 NumOfOdtsOfDaq[XCP_MAX_DAQ];%0D
    /*! @brief Defines the array containing the first Odt entry id of each Daq */%0D
    Xcp_OdtEntryIdxType FirstOdtEntryIdxOfDaq[XCP_MAX_ODT_DAQ + XCP_MAX_ODT_STIM];%0D
    /*! @brief Defines the array containing number of odts supported for each daq */%0D
    uint8 NumOfOdtEntriesOfDaq[XCP_MAX_ODT_DAQ + XCP_MAX_ODT_STIM];%0D
    /*! @brief Defines the array containing the mapping of event channel to the Daq */%0D
    uint16 DaqToEventChannelMap[XCP_MAX_DAQ];%0D
    /*! @brief Defines the array containing the odt entries (address for the entry)*/%0D
    Xcp_AddressPtrType  OdtEntries[XCP_MAX_ODT_ENTRIES];%0D
    /*! @brief Defines the array containing the size of odt entries (odt entry element size  )*/%0D
    Xcp_AddressPtrType  OdtEntriesSize[XCP_MAX_ODT_ENTRIES];%0D
    /*! @brief Defines the array containing the Daq list mode */%0D
    uint8 DaqListMode[XCP_MAX_DAQ];%0D
    /*! @brief Defines the array containing the Daq list status */%0D
    uint8 DaqListStatus[XCP_MAX_DAQ];%0D
    /*! @brief Defines the array containing the Daq list mode */%0D
    uint8 DaqListPrescalarInitialValue[XCP_MAX_DAQ];%0D
    /*! @brief Defines the array containing the Daq list status */%0D
    uint8 DaqListPrescalarCounter[XCP_MAX_DAQ];%0D
    /*! @brief Defines the array containging the pointer reference to the STIM buffer of each daq */%0D
    P2VAR(Xcp_DtoBufferType, AUTOMATIC, XCP_VAR_NOINIT) pStimBuffer[XCP_MAX_ODT_DAQ + XCP_MAX_ODT_STIM];%0D
}Xcp_DaqListStatusType;</_text>
