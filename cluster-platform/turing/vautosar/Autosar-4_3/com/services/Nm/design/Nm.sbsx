			<_description type="p"><IDescription type="e">
				<_text type="a">/* Defines the overall configuration for the NM Coordinator */%0D
typedef struct%0D
{%0D
    /*! @brief Defines the number of clusters in the NM coordination cluster */%0D
    uint8 NmNumOfClusters;%0D
    /*! @brief Defines the pointer to the per-cluster configuration */%0D
    const Nm_PerClusterConfigType* NmPerClusterPtr;%0D
}Nm_CoordConfigType;</_text>
