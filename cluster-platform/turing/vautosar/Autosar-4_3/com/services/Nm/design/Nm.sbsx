    NM_BUSNM_UDPNM = 3U,        /*! @brief BusNm type as UDP NM */%0D
    NM_BUSNM_GENERICNM = 4U,    /*! @brief BusNm type as Generic NM */%0D
    NM_BUSNM_J1939NM = 5U,      /*! @brief BusNm type as SAE J1939 NM */%0D
