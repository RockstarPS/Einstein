			<_description type="p"><IDescription type="e">
				<_text type="a">/* Defines the per-cluster configuration for the NM Coordinator */%0D
typedef struct%0D
{%0D
#if (STD_ON == NM_COORDINATOR_SYNC_SUPPORT)%0D
    /*! @brief Indicates whether this node is the top most coordinator in the NM coordination cluster */%0D
    boolean NmTopMostCoordinator;%0D
#endif /* STD_ON == NM_COORDINATOR_SYNC_SUPPORT */%0D
    /*! @brief Indicates whether this node is a synchronizing network in the NM coordination cluster */%0D
    boolean NmSyncNetFlag;%0D
    /*! @brief Defines the cluster index */%0D
    uint8 NmCoorClusterIndex;%0D
    /*! @brief Defines the number of channels included in the NM coordination cluster */%0D
    uint8 NmClusterIncNumChannel;%0D
    /*! @brief Defines the included channels in the NM coordination cluster */%0D
    const uint8* NmClusterIncChannel;%0D
}Nm_PerClusterConfigType;</_text>
