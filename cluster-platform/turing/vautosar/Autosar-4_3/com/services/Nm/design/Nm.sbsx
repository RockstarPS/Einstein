			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the configuration for NM Channels*/%0D
typedef struct%0D
{%0D
    /*! @brief Defines the Bus specific NM configuration ID */%0D
    Nm_BusNmInterfaceConfigIdType    BusNmFunctConfigId; %0D
    /*! @brief Defines the BusNm type.*/%0D
    Nm_BusNmType                     BusNmType;%0D
    /*! @brief Defines the ComM channel reference.*/%0D
    NetworkHandleType                ComMChRef;%0D
    #if(NM_COORDINATOR_SUPPORT_ENABLED == STD_ON) %0D
    #if (NM_COORDINATOR_SYNC_SUPPORT == STD_ON)%0D
    /*! @brief This parameter indicates whether a NM channel - part of a NM Coordination cluster - will be coordinated %0D
        actively (NmActiveCoordinator = TRUE) or passively (NmActiveCoordinator = FALSE). */%0D
    boolean                          NmActiveCoordinator;%0D
    #endif%0D
    /*! @brief This parameter shall be set to indicate if the sleep of this network can be absolutely decided by the %0D
        local node only and that no other nodes can oppose that decision.*/%0D
    boolean                          NmChannelSleepMaster;%0D
    /*! @brief This parameter defines the NM coordination cluster index to which it belongs*/%0D
    uint8                            NmCoordClusterIndex;%0D
    /*! @brief If this parameter is true, then this network is a synchronizing network for the NM coordination %0D
        cluster which it belongs to. The network is expected to call Nm_SynchronizationPoint() at regular intervals.*/%0D
    boolean                          NmSynchronizingNetwork;%0D
    /*! @brief Bus specific Shutdown Time */%0D
    Nm_ShutdownTimeType              NmBusNmShutdownTime;%0D
    #endif%0D
    #if(NM_STATE_CHANGE_IND_ENABLED == STD_ON)%0D
    /*! @brief This parameter shall be set to update the Network Management State (NMS) via ComSignal*/%0D
    boolean                          NmStateReportEnabled;%0D
    /*! @brief Reference to the signal for setting the NMS by calling%0D
        Com_SendSignal for the respective channel. */%0D
    Com_SignalIdType                 NmStateReportSignalId;%0D
    #endif%0D
    #if (NM_BUSNM_GENERIC_NM_SUPPORT == STD_ON)%0D
    /*! @brief This parameter shall be used to calculate shutdown delay time in milliseconds. */%0D
    uint32                           NmGenericBusNmShutdownTime;%0D
    #endif%0D
}Nm_ChannelConfigType;</_text>
			</IDescription>
