			<_name type="a">Nm_BusNmFunctConfigType</_name>
			<_modifiedTimeWeak type="a">7.9.2025::6:44:26</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the Bus specific NM function configuration types */%0D
typedef struct %0D
{%0D
    /*! @brief Defines the function to Passive startup of the NM.*/%0D
    Nm_BusNmPassiveStartUp                      BusNmPassiveStartUpFunctPtr;  %0D
    /*! @brief Defines the function to Get the state and the mode of the network management.*/%0D
    Nm_BusNmGetStateFunctType                   BusNmGetStateFunctPtr;%0D
    #if(NM_PASSIVE_MODE_ENABLED == STD_OFF)%0D
    /*! @brief Defines the function to Request the network.*/%0D
    Nm_BusNmNetworkRequestFunctType             BusNmNetworkRequestFunctPtr;%0D
    /*! @brief Defines the function to Release the network.*/%0D
    Nm_BusNmNetworkReleaseFunctType             BusNmNetworkReleaseFunctPtr;%0D
    #endif%0D
    #if(NM_COM_CONTROL_ENABLED == STD_ON)%0D
    /*! @brief Defines the function to Disable the NM PDU transmission ability.*/%0D
    Nm_BusNmDisableCommunicationFunctType       BusNmDisableCommunicationFunctPtr;%0D
    /*! @brief Defines the function to Enable the NM PDU transmission ability.*/%0D
    Nm_BusNmEnableCommunicationFunctType        BusNmEnableCommunicationFunctPtr;%0D
    #endif%0D
    #if(NM_USER_DATA_ENABLED == STD_ON) %0D
    #if ((NM_PASSIVE_MODE_ENABLED == STD_OFF) &amp;&amp; (NM_COM_USER_DATA_SUPPORT == STD_OFF))%0D
    /*! @brief Defines the function to Set user data for NM messages transmitted next on the bus.*/%0D
    Nm_BusNmSetUserDataFunctType                BusNmSetUserDataFunctPtr;%0D
    #endif%0D
    /*! @brief Defines the function to Get user data out of the most recently received NM PDU.*/%0D
    Nm_BusNmGetUserDataFunctType                BusNmGetUserDataFunctPtr;%0D
    #endif%0D
    #if(NM_NODE_ID_ENABLED == STD_ON)%0D
    /*! @brief Defines the function Get node identifier out of the last successfully received NM-message.*/%0D
    Nm_BusNmGetNodeIdentifierFunctType          BusNmGetNodeIdentifierFunctPtr;%0D
    /*! @brief Defines the function to Get node identifier configured for the local node.*/%0D
    Nm_BusNmGetLocalNodeIdentifierFunctType     BusNmGetLocalNodeIdentifierFunctPtr;%0D
    #endif%0D
    #if(NM_NODE_DETECTION_ENABLED == STD_ON)%0D
    /*! @brief Defines the function to Request a Repeat Message Request to be transmitted next on the bus.*/%0D
    Nm_BusNmRepeatMessageRequestFunctType       BusNmRepeatMessageRequestFunctPtr;%0D
    #endif%0D
    #if ((NM_NODE_ID_ENABLED == STD_ON) || (NM_USER_DATA_ENABLED == STD_ON))%0D
    /*! @brief Defines the function Get the whole PDU data out of the most recently received NM PDU. */%0D
    Nm_BusNmGetPduDataFunctType                 BusNmGetPduDataFunctPtr;%0D
    #endif%0D
    #if(NM_PDU_RX_INDICATION_ENABLED == STD_ON)%0D
    /*! @brief Defines the function prototype for the API to notify reception of NM message.*/%0D
    Nm_BusNmPduRxIndicationCallOutFunctType     BusNmPduRxIndicationFunctPtr;%0D
    #endif%0D
    #if(NM_REMOTE_SLEEP_IND_ENABLED == STD_ON)%0D
    /*! @brief Defines the function to Check if remote sleep indication takes place or not.*/%0D
    Nm_BusNmCheckRemoteSleepIndicationFunctType BusNmCheckRemoteSleepIndicationFunctPtr;%0D
    #endif%0D
    #if(NM_COORDINATOR_SUPPORT_ENABLED == STD_ON)%0D
    /*! @brief Defines the function to Request bus synchronization.*/%0D
    Nm_BusNmRequestBusSynchronizationFunctType  BusNmRequestBusSynchronizationFunctPtr;%0D
    /*! @brief Defines the function to Set the NM Coordinator Sleep Ready bit in the Control Bit Vector.*/%0D
    Nm_BusNmSetSleepReadyBitFunctType           BusNmSetSleepReadyBitFunctPtr;%0D
    #endif%0D
    #if (NM_CAR_WAKE_UP_RX_ENABLED == STD_ON)%0D
    /*! @brief Defines the function to callout if Nm_CarWakeUpIndication() is called. */%0D
    Nm_BusNmCarWakeUpCalloutFunctType           BusNmCarWakeUpCalloutFunctPtr;%0D
    #endif%0D
}Nm_BusNmFunctConfigType;</_text>
