			<_name type="a">Com_FilterConfigType</_name>
			<_modifiedTimeWeak type="a">11.20.2024::12:13:37</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">typedef struct%0D
{%0D
    /*! @brief Defines the type of Com signal filter algorithm used .*/%0D
    Com_FilterAlgorithmType     FilterAlgorithmType;%0D
    /*! @brief Defines the filter mask buffer Id */%0D
    Com_FilterMaskBufferIdType  FilterMaskBufferId;%0D
    /*! @brief Defines the filter max value buffer Id */%0D
    Com_FilterMaxBufferIdType   FilterMaxBufferId;%0D
    /*! @brief Defines the filter min value buffer Id */%0D
    Com_FilterMinBufferIdType   FilterMinBufferId;%0D
    /*! @brief Defines the filter X value buffer Id */%0D
    Com_FilterXBufferIdType     FilterXBufferId;%0D
    /*! @brief Defines the offset value for the algorithm COM_FILTER_ALGORITHM_TYPE_ONE_EVERY_N */%0D
    uint32                      FilterOffset;%0D
    /*! @brief Defines the period value for the algorithm COM_FILTER_ALGORITHM_TYPE_ONE_EVERY_N */%0D
    uint32                      FilterPeriod;%0D
}Com_FilterConfigType;</_text>
