			<_name type="a">Com_RxSignalConfigType</_name>
			<_modifiedTimeWeak type="a">11.20.2024::12:13:37</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the type for the configuration of RX signals */%0D
typedef struct%0D
{%0D
    /*! @brief Defines the COM PduId to which the signal belongs */%0D
    PduIdType                               ComPduId;%0D
        /*! @brief This parameter defines that the respective signal's initial value shall%0D
    be put into the respective PDU but there will not be any update of the value%0D
    through the RTE*/%0D
    boolean                                 InitialValueOnly;%0D
    /*! @brief Defines the endianness of the signal's network representation */%0D
    Com_SignalEndiannessType                SignalEndiannessType;%0D
    /*! Defines the AUTOSAR type of the signal */%0D
    Com_SignalType                          SignalType;%0D
    /*! @brief Defines the action performed upon reception if invalid signal is received. */%0D
    Com_DataInvalidActionType               DataInvalidActionType;%0D
    /*! @brief Defines the action performed upon expiration of the reception dead-line monitoring timer */%0D
    Com_RxDataTimeoutActionType             RxDataTimeoutActionType;%0D
    /*! @brief Defines the MS Bit position in the I-PDU data MsBytePosition */%0D
    uint8                                   MsBitPosition;%0D
    /*! @brief Defines the LS Bit position in the I-PDU data LsBytePosition*/%0D
    uint8                                   LsBitPosition;%0D
    /*! @brief Defines the MS Byte position in the I-PDU data bytes*/%0D
    Com_BufferSizeType                      MsBytePosition;%0D
    /*! @brief Defines the LS Byte position in the I-PDU data bytes*/%0D
    Com_BufferSizeType                      LsBytePosition;%0D
    /*! @brief Defines the Size in bits, for integer signal types .%0D
    For ComSignalType UINT8_N and UINT8_DYN the size shall be configured%0D
    by ComSignalLength.For ComSignalTypes FLOAT32 and FLOAT64 the size is%0D
    already defined by the signal type and therefore may be omitted*/%0D
    Com_BitLengthSizeType                   BitSize;%0D
    /*! @brief Defines the Size in bytes */%0D
    PduLengthType                           ByteLength;%0D
#if(COM_RX_SIGNAL_UB_SUPPORT == STD_ON)%0D
    /*! @brief Defines the update-bit position for the signal in the I-PDU */%0D
    Com_UBPropsConfigIdType                 UBConfigId;%0D
#endif%0D
#if(COM_RX_SIGNAL_INVALID_DATA_SUPPORT == STD_ON)%0D
    /*! @brief Defines the Invalid value buffer end Id*/%0D
    Com_SignalValueBufferIdType             DataInitValueBufferIdStart; %0D
    /*! @brief Defines the Invalid value buffer end Id*/%0D
    Com_SignalValueBufferIdType             DataInitValueBufferIdStop;%0D
#endif%0D
#if(COM_RX_SIGNAL_FILTER_SUPPORT == STD_ON)%0D
    /*! @brief Defines the signal Com filter Id */%0D
    Com_RxSignalFilterIdType                FilterId;%0D
#endif%0D
#if(COM_RX_SIGNAL_TIMEOUT_COUNTER_SUPPORT == STD_ON)%0D
    /*! @brief Defines the Rx signal timeout counter configuration ID */%0D
    Com_SignalRxTimeoutCounterConfigIdType  RxSignalTimeoutCounterId;%0D
#endif%0D
#if(COM_RX_SIGNAL_ACK_CALLBACK_SUPPORT == STD_ON)%0D
    /*! @brief Defines the Rx Ack callout function ID*/%0D
    Com_CbkRxAckFunctIdType                 RxAckFunctId;%0D
#endif%0D
#if(COM_RX_SIGNAL_INVALID_CALLBACK_SUPPORT == STD_ON)%0D
    /*! @brief Defines the Rx Invalid callout function ID*/%0D
    Com_CbkRxInvFunctIdType                 RxInvFunctId;%0D
#endif%0D
#if(COM_RX_SIGNAL_TIMEOUT_CALLBACK_SUPPORT == STD_ON)%0D
    /*! @brief Defines the Rx Timeout callout function ID*/%0D
    Com_CbkRxToutFunctIdType                RxToutFunctId;%0D
#endif%0D
#if (COM_SIGNAL_GATEWAY_SUPPORT == STD_ON)%0D
    /*! @brief Defines the gateway configuration Id */%0D
    Com_GwDestinationConfigIdType           GwDestinationConfigId;%0D
#endif%0D
    /*! @brief Defines the signal init buffer index */%0D
    Com_RxRteBufferIdType                   InitBufferIdx;%0D
    /*! @brief Defines the signal buffer index */%0D
    Com_RxRteBufferIdType                   RteBufferIdx;%0D
#if (COM_RX_SIGNAL_GROUP_SUPPORT == STD_ON)%0D
    /*! @brief Defines the signal shadow buffer index */%0D
    Com_RxRteShadowBufferIdType             RteShadowBufferIdx;%0D
    /*! @brief Defines whether the signal is group signal or not */%0D
    boolean                                 IsGroupSignal ; %0D
#endif%0D
}Com_RxSignalConfigType;</_text>
			</IDescription>
