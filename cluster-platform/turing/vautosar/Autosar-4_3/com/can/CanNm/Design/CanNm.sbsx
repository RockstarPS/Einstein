		<IType type="e">
			<_id type="a">GUID c7a4add9-d506-4da9-aa50-d866fa3cbcaa</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanNm_PduPositionType</_name>
			<_modifiedTimeWeak type="a">5.27.2025::3:29:22</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the position of the control bit vector within the NM PDU . */%0D
typedef uint8 CanNm_PduPositionType;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">5.27.2025::3:29:22</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		<IType type="e">
			<_id type="a">GUID b8a86991-d1f7-4aca-b149-33aea35abb8b</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanNmTxConfirmation</_name>
			<_modifiedTimeWeak type="a">5.27.2025::3:29:53</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Function pointer to notify the Nm Message Tx confirmation */%0D
typedef void (*CanNmTxConfirmation)(void);</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">5.27.2025::3:29:53</_modifiedTime>
