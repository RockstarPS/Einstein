		<IType type="e">
			<_id type="a">GUID de901816-8a56-45b1-aae1-14edb78b2c8a</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanNm_ChannelConfigType</_name>
			<_modifiedTimeWeak type="a">5.27.2025::3:30:32</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the channel specific configuration type of the CanNm. */%0D
typedef struct%0D
{%0D
    /*! @brief It defines the NM channel reference of a CanNM channel */%0D
    NetworkHandleType NmChannelRef;%0D
    /*! @brief Timeout for Repeat Message State. It defines the time in millisecondsmilliseconds how long the NM shall stay in the%0D
        Repeat Message State. */%0D
    uint32 RepeatMessageTime;%0D
    /*! @brief Network Timeout for NM PDUs.It denotes the time in milliseconds how long the NM shall stay in the Ready Sleep%0D
        State before transition into the Prepare Bus-Sleep Mode is initiated */%0D
    uint32 TimeoutTime;%0D
    /*! @brief It denotes the time in milliseconds how long the NM shall stay in the Prepare Bus-Sleep Mode before%0D
        transition into Bus-Sleep Mode shall take place.*/%0D
    uint32 WaitBusSleepTime;%0D
    #if (CANNM_IMMEDIATE_RESTART_ENABLED == STD_OFF)%0D
    /*! @brief Defines the immediate NM PDU cycle time in milliseconds which is used for CanNmImmediateNmTransmissions%0D
        NM PDU transmissions. */%0D
    uint32 ImmediateNmCycleTime;%0D
    /*! @brief Defines the number of immediate NM PDUs which shall be transmitted.%0D
        If the value is zero no immediate NM PDUs are transmitted */%0D
    uint8 ImmediateNmTransmissionsCount;%0D
    #endif%0D
    /*! @brief Specifies if first message request in CanNm is repeated until accepted by CanIf. */%0D
    boolean RetryFirstMessageRequest;%0D
    /*! @brief Defines the position of the control bit vector within the NM PDU.%0D
        The value of the parameter represents the location of the Control Bit Vector in the NM PDU%0D
        (CanNmPduByte0 means byte 0, CanNmPduByte1 means byte 1, CanNmPduOff means source node identifier is not%0D
        part of the NM PDU) */%0D
    CanNm_PduPositionType PduCbvPosition;%0D
    /*! @brief Defines the position of the source node identifier within the NM PDU.%0D
        The value of the parameter represents the location of the source node identifier in the NM PDU%0D
        (CanNMPduByte0 means byte 0, CanNmPduByte1 means byte 1, CanNmPduOff means source node identifier is not part%0D
        of the NM PDU) */%0D
    CanNm_PduPositionType PduNidPosition;%0D
    /*! @brief Defines the unused value used for filling unused bytes in the CAN NM Transmit PDUs*/%0D
    uint8 UnusedDataByteVal;%0D
    #if ((CANNM_USER_DATA_ENABLED == STD_ON)|| (CANNM_COM_USER_DATA_SUPPORT == STD_ON))%0D
    /*! @brief Defines the user data length in bytes*/%0D
    uint8 UserDataLength;%0D
    #endif%0D
    #if (CANNM_PASSIVE_MODE_ENABLED == STD_OFF)%0D
    /*! Enables/Disables the handling of the Active Wakeup Bit in the CanNm module */%0D
    boolean ActiveWakeupBitEnabled;%0D
    /*! @brief Time offset in the periodic transmission node.%0D
        It determines the start delay of the transmission. Specified in milliseconds. */%0D
    uint32 MsgCycleOffset;%0D
    /*! @brief Period of a NM PDU in milliseconds. It determines the periodic rate in the &quot;periodic transmission mode with%0D
    bus load reduction&quot; and is the basis for transmit scheduling in the &quot;periodic transmission mode without bus load%0D
    reduction&quot; */%0D
    uint32 MsgCycleTime;%0D
    /*! @brief Transmission Timeout of NM PDU. If there is no transmission confirmation by the CAN Interface%0D
        within this timeout, the CANNM module shall give an error notification. */%0D
    uint32 MsgTimeoutTime;%0D
    #if (CANNM_BUS_LOAD_REDUCTION_ENABLED == STD_ON)%0D
    /*! @brief Node specific bus cycle time in the periodic transmission mode with bus load reduction. Specified in%0D
        milliseconds. */%0D
    uint32 MsgReducedTime;%0D
    /*! @brief This parameter defines if bus load reduction for the respective NM channel is active or not. */%0D
    boolean BusLoadReductionActive;%0D
    #endif%0D
    #endif%0D
    #if (CANNM_NODE_ID_ENABLED == STD_ON)%0D
    /*! @brief Defines the Node identifier of local node. */%0D
    uint8 NodeId;%0D
    #endif%0D
    #if(CANNM_REMOTE_SLEEP_IND_ENABLED == STD_ON)%0D
    /*! @brief Timeout for Remote Sleep Indication.%0D
        It defines the time in milliseconds how long it shall take to recognize that all other nodes are ready to sleep. */%0D
    uint32 RemoteSleepIndTime;%0D
    #endif%0D
    #if(CANNM_NM_TXCONFIRMATION_SUPPORT == STD_ON)%0D
    /*! @Callback for Tx confirmation for Nm messages*/%0D
    CanNmTxConfirmation CanNmTxConfirmationFunctPtr;%0D
    #endif%0D
    #if (CANNM_PN_ENABLED == STD_ON)%0D
    /*! @brief Enables or disables support of partial networking. */%0D
    boolean PnEnabled;%0D
    /*! @brief Specifies if CanNm calculates the PN request information for external requests. (ERA)%0D
        false: PN request are not calculated true: PN request are calculated */%0D
    boolean PnEraCalcEnabled;%0D
    /*! @brief Specifies if CanNm performs an additional transition from Network Mode to Repeat Message State (true)%0D
        or not (false). */%0D
    boolean PnHandleMultipleNetworkRequests;%0D
    /*! @brief Specifies if CanNm drops irrelevant NM PDUs.%0D
        false: Only NM PDUs with a PNI bit = true and containing a PN request for this ECU triggers the standard RX%0D
        indication handling true: Every NM PDU triggers the standard RX indication handling */%0D
    boolean AllNmMessagesKeepAwake;%0D
    /*! @brief Reference to a Pdu in the COM-Stack. The SduRef is required for every CanNm Channel, because ERA is%0D
        reported per channel. */%0D
    PduIdType PnEraRxNSduRef;%0D
    #endif%0D
    #if (CANNM_CAR_WAKEUP_RX_ENABLED == STD_ON)%0D
    /*! @brief Enables or disables support of CarWakeUp bit evaluation in received NM PDUs. */%0D
    boolean CarWakeUpRxEnabled;%0D
    /*! @brief Enables / Disables the CAR wakeup filter feature support .If CWU filtering is supported, only the CWU%0D
        bit within the NM PDU with source node identifier CanNmCarWakeUpFilterNodeId is considered as CWU request.*/%0D
    boolean CarWakeUpFilterEnabled;%0D
    /*! @brief Specifies the Bit position of the CWU within the NM PDU. */%0D
    uint8 CarWakeUpBitPosition;%0D
    /*! @brief Specifies the Byte position of the CWU within the NM PDU. */%0D
    uint8 CarWakeUpBytePosition;%0D
    /*! @brief Source node identifier for CWU filtering. If CWU filtering is supported, only the CWU bit within the NM%0D
        PDU with source node identifier CanNmCarWakeUpFilterNodeId is considered as CWU request. */%0D
    uint8 CarWakeUpFilterNodeId;%0D
    #endif%0D
}CanNm_ChannelConfigType;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">5.27.2025::3:30:32</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		<IType type="e">
			<_id type="a">GUID 33a450fc-ebea-4bfc-9e78-efd403dce4d2</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanNM_ChannelPduConfigType</_name>
			<_modifiedTimeWeak type="a">5.27.2025::3:30:47</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the PDU configuration type of the channel */%0D
typedef struct%0D
{%0D
    #if (CANNM_PASSIVE_MODE_ENABLED == STD_OFF)%0D
    /*! @brief Defines the CANNM Transmit message PDU length of this channel */%0D
    PduLengthType   CanNmTransmitMsgLength;%0D
    /*! @brief Defines the CANNM Transmit message PduId of this channel*/%0D
    PduIdType       CanNmTransmitMsgId;%0D
    /*! @brief Defines the CANNM Transmit message lower layer PduId of this channel*/%0D
    PduIdType       CanNmTransmitMsgLowerLayerId;%0D
    #endif%0D
    /*! @brief Defines the CANNM Receive message PDU length of this channel */%0D
    PduLengthType   CanNmReceiveMsgLength;%0D
    /*! @brief Defines the CANNM Receive message start PduId of this channel*/%0D
    PduIdType       CanNmReceiveMsgStartId;%0D
    /*! @brief Defines the CANNM Receive message end PduId of this channel*/%0D
    PduIdType       CanNmReceiveMsgEndId;%0D
    #if (CANNM_COM_USER_DATA_SUPPORT == STD_ON)%0D
    /*! @brief Defines the CanNmFiatB Transmit message COM user data PduId*/%0D
    PduIdType       CanNmTxUserDataPduId;%0D
    #endif%0D
}CanNM_ChannelPduConfigType;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">5.27.2025::3:30:47</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		
