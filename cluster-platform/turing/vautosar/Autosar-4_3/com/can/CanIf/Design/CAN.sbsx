		<IEnumerationLiteral type="e">
			<_id type="a">GUID 1d918b9d-f6f8-4e06-9963-38bff6fba8ea</_id>
			<_name type="a">BUFREQ_E_NOT_OK</_name>
			<_modifiedTimeWeak type="a">7.1.2024::8:12:53</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Buffer request not successful. Buffer cannot be accessed. This status shall have the value 1.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">11.20.2024::12:13:46</_modifiedTime>
			<_value type="a">0x01</_value>
		</IEnumerationLiteral>
		<IEnumerationLiteral type="e">
			<_id type="a">GUID a276895a-d30e-4ed6-a21a-c85861fefd82</_id>
			<_name type="a">BUFREQ_E_BUSY</_name>
			<_modifiedTimeWeak type="a">7.1.2024::8:12:58</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Temporarily no buffer available. It's up the requester to retry request for a certain time. This status shall have the value 2.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">11.20.2024::12:13:46</_modifiedTime>
			<_value type="a">0x02</_value>
		</IEnumerationLiteral>
