			<_id type="a">GUID 9a6464da-b2e7-43fd-9ee9-b2c6287b9003</_id>
			<_name type="a">BUFREQ_E_OVFL</_name>
			<_modifiedTimeWeak type="a">7.1.2024::8:13:1</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">No Buffer of the required length can be provided. This status shall have the value 3.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">11.20.2024::12:13:46</_modifiedTime>
			<_value type="a">0x03</_value>
