		<IEnumerationLiteral type="e">
			<_id type="a">GUID 2ab2623e-9146-4635-a637-190c183d22fb</_id>
			<_name type="a">BUFREQ_OK</_name>
			<_modifiedTimeWeak type="a">7.1.2024::8:12:48</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Buffer request accomplished successful.This status have the value 0.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">11.20.2024::12:13:46</_modifiedTime>
			<_value type="a">0x00</_value>
