		<IType type="e">
			<_id type="a">GUID 847807bd-f80d-4e8b-9855-a53c3eafa4bc</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">Lin_PduType</_name>
			<_modifiedTimeWeak type="a">11.20.2024::12:13:37</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/**%0D
* @brief          The LIN identifier (0..0x3F) with its parity bits.%0D
* @details        This Type is used to provide PID, checksum model,%0D
*                 data length and SDU pointer from the LIN Interface%0D
*                 to the LIN driver.%0D
* @implements     Lin_PduType_struct%0D
*/%0D
typedef struct%0D
{%0D
    Lin_FramePidType      Pid;     /**&lt; @brief LIN frame identifier.*/%0D
    Lin_FrameCsModelType  Cs;      /**&lt; @brief Checksum model type.*/%0D
    Lin_FrameResponseType Drc;     /**&lt; @brief Response type.*/%0D
    Lin_FrameDlType       Dl;      /**&lt; @brief Data length.*/%0D
    uint8*                SduPtr;  /**&lt; @brief Pointer to Sdu.*/%0D
}Lin_PduType;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.23.2024::10:52:29</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		<IType type="e">
			<_id type="a">GUID 3cee854b-b266-4a3b-89c7-f2f3d42f08c8</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">Lin_StatusType</_name>
			<_modifiedTimeWeak type="a">11.20.2024::12:13:37</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/**%0D
* @brief          LIN Frame and Channel states operation.%0D
* @details        LIN operation states for a LIN channel or frame, as returned%0D
*                 by the API service Lin_GetStatus().%0D
*                 part of the LIN frame.%0D
* @implements     Lin_StatusType_enumeration%0D
*/%0D
typedef enum%0D
{%0D
    LIN_NOT_OK = 0,     /**&lt; @brief Development or production error%0D
                                    occurred.*/%0D
    LIN_TX_OK,          /**&lt; @brief Successful transmission.*/%0D
    LIN_TX_BUSY,        /**&lt; @brief Ongoing transmission (Header or%0D
                                    Response).*/%0D
    LIN_TX_HEADER_ERROR,/**&lt; @brief Erroneous header transmission such%0D
                                    as:%0D
                                     - Mismatch between sent and read%0D
                                       back data%0D
                                     - Identifier parity error%0D
                                     - Physical bus error.*/%0D
    LIN_TX_ERROR,       /**&lt; @brief Erroneous transmission such as:%0D
                                     - Mismatch between sent and read%0D
                                       back data%0D
                                     - Physical bus error.*/%0D
    LIN_RX_OK,          /**&lt; @brief Reception of correct response.*/%0D
    LIN_RX_BUSY,        /**&lt; @brief Ongoing reception:%0D
                                    at least one response byte has%0D
                                    been received, but the checksum%0D
                                    byte has not been received.*/%0D
    LIN_RX_ERROR,       /**&lt; @brief Erroneous reception such as:%0D
                                     - Framing error%0D
                                     - Overrun error%0D
                                     - Checksum error%0D
                                     - Short response.*/%0D
    LIN_RX_NO_RESPONSE, /**&lt; @brief No response byte has been received%0D
                                    so far.*/%0D
                        /**&lt; @brief This is a mess !!%0D
                                   Frame status is mixed with channel%0D
                                   status but i kept it here only%0D
                                   because of LIN168.*/%0D
    LIN_OPERATIONAL,    /**&lt; @brief Normal operation;%0D
                                     - The related LIN channel is ready%0D
                                       to transmit next header%0D
                                     - No data from previous frame%0D
                                       available (e.g. after%0D
                                       initialization).*/%0D
    LIN_CH_SLEEP        /**&lt; @brief Sleep mode operation;%0D
                                     - In this mode wake-up detection%0D
                                       from slave nodes is enabled.*/%0D
}Lin_StatusType;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.23.2024::10:52:29</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
