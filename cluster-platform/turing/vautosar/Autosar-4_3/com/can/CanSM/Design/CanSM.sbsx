		<IType type="e">
			<_id type="a">GUID 86c8d3dc-57f1-43cb-9af4-2115b8d58179</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanSM_BusOffIdType</_name>
			<_modifiedTimeWeak type="a">8.6.2025::7:35:58</_modifiedTimeWeak>
			<_modifiedTime type="a">8.6.2025::7:35:58</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		<IType type="e">
			<_id type="a">GUID 466c0d7b-007c-4541-95df-8ac71ab41612</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanSM_BusOffConfigType</_name>
			<_modifiedTimeWeak type="a">8.6.2025::7:36:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the configuration for the Bus Off handling */%0D
typedef struct%0D
{%0D
    /*! @brief ID of the Bus off configuration . */%0D
    CanSM_BusOffIdType                      BusOffId;%0D
    /*! @brief This threshold defines the count of bus-offs until the bus-off recovery switches from%0D
        level 1 (short recovery time) to level 2 (long recovery time). */%0D
    uint8                                   BorCounterL1ToL2;%0D
    /*! @brief This time parameter defines in seconds the duration of the bus-off recovery time in level 1 %0D
        (short recovery time). */%0D
    uint32                                  BorTimeL1;%0D
    /*! @brief This time parameter defines in seconds the duration of the bus-off recovery time in level 2 %0D
        (long recovery time). */%0D
    uint32                                  BorTimeL2;%0D
    /*! @brief This parameter defines in seconds the duration of the bus-off event check.%0D
        This check assesses, if the recovery has been successful after the recovery re-enables the transmit path */%0D
    uint32                                  BorTimeTxEnsured;%0D
    /*! @brief This parameter shall configure, if the CanSM polls the CanIf_GetTxConfirmationState API to decide %0D
        the bus-off state to be recovered instead of using the CanSMBorTimeTxEnsured parameter for this decision. */%0D
    boolean                                 BorTxConfirmationPolling;%0D
    #if (CANSM_GET_BUS_OFF_DELAY_FUNCTION == STD_ON)%0D
    /*! @brief This parameter defines if the &lt;User_GetBusOffDelay&gt; shall be called for this network. */%0D
    boolean                                 EnableBusOffDelay;%0D
    /*! @brief This parameter defines the call out function which returns the number of CanSM base cycles to %0D
        wait additionally to L1/L2 after a BusOff occurred.  This can also be used for bus off begin with %0D
        delay time 0. */%0D
    CanSM_UserGetBusOffBeginDelayFunctType  UserGetBusOffDelayFunctPtr;%0D
    /*! @brief This parameter defines the call out function notifies the bus-off end */%0D
    CanSM_UserGetBusOffEndFunctType         UserGetBusOffEndFunctPtr;%0D
    #endif%0D
}CanSM_BusOffConfigType;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">8.6.2025::7:36:38</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		<IType type="e">
			<_id type="a">GUID 80885d1d-0a5b-439d-bed4-53a7f42eb3be</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanSM_UserGetBusOffBeginDelayFunctType</_name>
			<_modifiedTimeWeak type="a">8.6.2025::7:37:10</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the types for the call out function BusOffDelay which returns the number of CanSM base %0D
    cycles to wait additionally to L1/L2 after a BusOff occurred.*/%0D
typedef P2FUNC(void,CANSM_APPL_CODE,CanSM_UserGetBusOffBeginDelayFunctType)%0D
(%0D
    NetworkHandleType network,%0D
    P2VAR(uint8,AUTOMATIC,CANSM_APPL_DATA) delayCyclesPtr%0D
);</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">8.6.2025::7:37:10</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		<IType type="e">
			<_id type="a">GUID a5ae1e76-5452-44b7-bce2-1edf12af9bf9</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanSM_UserGetBusOffEndFunctType</_name>
			<_modifiedTimeWeak type="a">8.6.2025::7:37:27</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the types for the call out function BusOffEnd which notifies that BusOff recovered.This is used %0D
    for OSEK NM , not AUTOSAR API*/%0D
typedef P2FUNC(void,CANSM_APPL_CODE,CanSM_UserGetBusOffEndFunctType)(NetworkHandleType network);</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">8.6.2025::7:37:27</_modifiedTime>
			<_kind type="a">Language</_kind>
		</IType>
		<IType type="e">
			<_id type="a">GUID 97dbbf5d-703c-4f34-880b-83d0aab98f4b</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">CanSM_NetworkConfigType</_name>
			<_modifiedTimeWeak type="a">8.6.2025::7:37:50</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief Defines the network specific parameters of each CAN network */%0D
typedef struct%0D
{%0D
    /*! @brief Reference to the ComM Channel for the configured network. */%0D
    NetworkHandleType           ComMChannelRef;%0D
    /*! @brief ID of the CAN Controller assigned to the configured network handle.%0D
        Reference to one of the Controller managed by the CanIf module. */%0D
    CanSM_ControllerIdType      ControllerId;%0D
    /*! @brief ID of the CAN transceiver assigned to the configured network handle.%0D
        Reference to one of the transceivers managed by the CanIf module. */%0D
    CanSM_TransceiverIdType     TransceiverId;%0D
#if(CANSM_DEM_ERROR_REPORT == STD_ON)%0D
    /*! @brief This parameter defines the DEM event Id used to report bus off errors for this CAN network. %0D
        CANSM_E_BUS_OFF */%0D
    Dem_EventIdType                         BoEventId;%0D
    /*! @brief This parameter defines the DEM event Id used to report bus off errors for this CAN network. %0D
        CANSM_E_MODE_REQUEST_TIMEOUT */%0D
    Dem_EventIdType                         TimeoutEventId;%0D
    /*! @brief This parameter defines if the DEM event for bus off errors is enabled for this CAN network. */%0D
    boolean                                 BoEventEnabled;%0D
    /*! @brief This parameter defines if the DEM event for mode request timeout is enabled for this CAN network. */%0D
    boolean                                 TimeoutEventEnabled;%0D
#endif%0D
}CanSM_NetworkConfigType;</_text>
