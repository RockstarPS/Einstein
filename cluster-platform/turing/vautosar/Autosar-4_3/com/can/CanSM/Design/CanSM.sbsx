			<_description type="p"><IDescription type="e">
				<_text type="a">/*! @brief  This type contains the implementation-specific post build configuration structure of CanSM */%0D
typedef struct%0D
{%0D
    const CanSM_BusOffConfigType            * const pBusOffConfig;%0D
    const CanSM_NetworkConfigType           * const pNetworkConfig;%0D
    CanSM_NetworkInfoType                   * pNetworkInfo;%0D
#if (CANSM_GET_BUS_OFF_DELAY_FUNCTION == STD_ON)%0D
    uint8                                   * pUserBusOffDelay;%0D
#endif%0D
    const uint8                             BusOffConfigSize;%0D
    const uint8                             NetworkConfigSize;%0D
    const uint8                             NetworkInfoSize;%0D
    const uint8                             UserBusOffDelaySize;%0D
}CanSM_ConfigType;</_text>
			</IDescription>
