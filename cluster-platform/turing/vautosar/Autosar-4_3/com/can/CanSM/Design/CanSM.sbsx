			<_name type="a">Can_ControllerStateType</_name>
			<_modifiedTimeWeak type="a">8.6.2025::7:33:13</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">typedef enum%0D
{%0D
    CAN_CS_UNINIT,%0D
    /**&lt; CAN controller transition value to request state STARTED. */%0D
    CAN_CS_STARTED,%0D
    /**&lt; CAN controller transition value to request state STOPPED. */%0D
    CAN_CS_STOPPED,%0D
    /**&lt; CAN controller transition value to request state STOPPED. */%0D
    CAN_CS_SLEEP%0D
    /**&lt; CAN controller transition value to request state SLEEP%0D
      *  from state SLEEP. */%0D
} Can_ControllerStateType;</_text>
			</IDescription>
			</_description>
