				<_text type="a">/*! @brief Defines the type for BusoffRecoveryState */%0D
typedef enum%0D
{%0D
    /*! @brief Bus off Recovery No Busoff */%0D
    CANSM_BOR_NO_BUS_OFF = 0,%0D
    /*! @brief Bus off Recovery L1 Wait State */%0D
    CANSM_BOR_TXOFF_L1,%0D
    /*! @brief Bus off Recovery L1 Check State */%0D
    CANSM_BOR_CHECK_L1,%0D
    /*! @brief Bus off Recovery L2 Wait State */%0D
    CANSM_BOR_TXOFF_L2,%0D
    /*! @brief Bus off Recovery L2 Check State */%0D
    CANSM_BOR_CHECK_L2%0D
}CanSM_BusoffRecoveryType;</_text>
