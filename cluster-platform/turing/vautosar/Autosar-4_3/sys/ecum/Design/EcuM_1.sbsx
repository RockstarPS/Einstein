			<_id type="a">GUID 6a977c10-00af-4d57-b278-db588d79cb1b</_id>
			<_myState type="a">8192</_myState>
			<_rmmServerID type="a">-1</_rmmServerID>
			<_name type="a">EcuM_StateType</_name>
			<_modifiedTimeWeak type="a">9.25.2024::11:20:13</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">/*----------------- Range of EcuM_StateType ------------------------- */%0D
#define ECUM_SUBSTATE_MASK                                  (0x0Fu)%0D
#define ECUM_STATE_STARTUP                                  (0x10u)%0D
#define ECUM_STATE_STARTUP_ONE                              (0x11u)%0D
#define ECUM_STATE_STARTUP_TWO                              (0x12u)%0D
#define ECUM_STATE_STARTUP_TWO_WAIT                         (0x13u)%0D
#define ECUM_STATE_WAKEUP                                   (0x20u)%0D
#define ECUM_STATE_WAKEUP_ONE                               (0x21u)%0D
#define ECUM_STATE_WAKEUP_VALIDATION                        (0x22u)%0D
#define ECUM_STATE_WAKEUP_REACTION                          (0x23u)%0D
#define ECUM_STATE_WAKEUP_TWO                               (0x24u)%0D
#define ECUM_STATE_WAKEUP_WAKESLEEP                         (0x25u)%0D
#define ECUM_STATE_WAKEUP_TTII                              (0x26u)%0D
#define ECUM_STATE_RUN                                      (0x30u)%0D
#define ECUM_STATE_APP_RUN                                  (0x32u)%0D
#define ECUM_STATE_APP_POST_RUN                             (0x33u)%0D
#define ECUM_STATE_SHUTDOWN                                 (0x40u)%0D
#define ECUM_STATE_PREP_SHUTDOWN                            (0x44u)%0D
#define ECUM_STATE_GO_SLEEP                                 (0x49u)%0D
#define ECUM_STATE_GO_OFF_ONE                               (0x4Du)%0D
#define ECUM_STATE_GO_OFF_TWO                               (0x4Eu)%0D
/* State OFF, RESET AND SLEEP are defined by the RTE */%0D
#define ECUM_STATE_SLEEP                                    (0x50u)%0D
#define ECUM_STATE_OFF                                      (0x80u)%0D
#define ECUM_STATE_RESET                                    (0x90u)%0D
#define ECUM_STATE_ERROR                                    (0xFFu)</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">5.23.2024::16:34:19</_modifiedTime>
