			<_modifiedTimeWeak type="a">9.25.2024::11:20:13</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">typedef struct%0D
{                                                           /** INIT/UINIT **|*********************Description*******************/%0D
    EcuM_WakeupSourceType   EnabledWakeupSource;            /*  INIT:0       | Holds the enabled wakeup sources                 */%0D
    EcuM_WakeupSourceType   ValidatedWakeups;               /*  INIT:0       | Holds the validated wakeup sources               */%0D
    EcuM_WakeupSourceType   PostedWakeups;                  /*  INIT:0       | Holds the posted wakeup sources                   */%0D
    EcuM_WakeupSourceType   ClearedPostedWakeups;           /*  INIT:0       | Holds the posted wkp sources, that were cleared  */%0D
    EcuM_WakeupSourceType   ExpiredPostedWakeups;           /*  INIT:0       | Holds the posted wkp sources, that were expired  */%0D
    EcuM_WakeupSourceType   ComM_BufferedWakeups;           /*  INIT:0       | Holds wakeups that happened before ComM_Init     */%0D
    uint16                  Timer;                          /*  INIT:FFFFh   | 16-bit Timer variable for EcuM                   */%0D
    EcuM_UserType           Users[ECUM_MAX_CFG_USERS];      /*  INIT:0       | Table of EcuM configured users                   */%0D
    EcuM_StateType          ModuleState;                    /*  INIT:11h     | Holds the current state of the EcuMgr            */%0D
    EcuM_StateType          LastShutdownTarget;             /*  UNITIALIZED  | Shutdown Target that was executed previous       */%0D
    EcuM_StateType          CurrentShutdownTarget;          /*  DEFAULT CFG  | Shutdown Target that has to be executed now      */%0D
    uint8                   LastShutdownMode;               /*  UNITIALIZED  | Shutdown Mode of previous shutdown operation     */%0D
    uint8                   CurrentShutdownMode;            /*  DEFAULT CFG  | Current Shutdown Mode                            */%0D
    uint8                   ShutdownCause;                  /*  INIT:0       | Reason for the last Shutdown                     */%0D
    uint8                   RunRequestCounter;              /*  INIT:0       | Number of users requested for RUN                */%0D
    uint8                   PostRunRequestCounter;          /*  INIT:0       | Number of users requested for POST RUN           */%0D
    uint8                   KillAllRequestStatus;           /*  INIT:0       | Kill All request status                          */%0D
    uint8                   NvMServiceId;                   /*  INIT:0       | NvM Service Id: WriteAll, CancelAll, ReadAll     */%0D
    uint8                   NvMWriteAllStatus;              /*  INIT:IDLE:0  | Status of NvM WriteAll request                   */%0D
    NvM_RequestResultType   NvMJobResult;                   /*  INIT:NOT_OK  | Result of NvM request placed by EcuMgr           */%0D
    boolean                 NvMCbkNotified;                 /*  INIT:FALSE   | Flag to indicate if the NvM callback is issued?  */%0D
    boolean                 NvMCbkReadAllNotified;          /*  INIT:FALSE   | Flag to indicate if the NvM Read All callback    */%0D
}EcuM_ParamType;</_text>
