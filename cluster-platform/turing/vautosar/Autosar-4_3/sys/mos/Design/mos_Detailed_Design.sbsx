		<IPrimitiveOperation type="e">
			<_id type="a">GUID cb4bb4b6-3737-44f7-946f-41599698153b</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">OsMemProt_MpuSwitchFromISR</_name>
			<_modifiedTimeWeak type="a">7.2.2025::12:8:53</_modifiedTimeWeak>
			<_modifiedTime type="a">7.2.2025::12:8:53</_modifiedTime>
			<_virtual type="a">0</_virtual>
			<Args type="c">
				<IRPYRawContainer type="e">
				</IRPYRawContainer>
			</Args>
			<_returnType type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hsubsystem type="a">PredefinedTypesCpp</_hsubsystem>
					<_hname type="a">void</_hname>
					<_hid type="a">GUID c6b70728-b655-45a0-abb7-8ea5d3da94be</_hid>
				</IHandle>
			</_returnType>
			<_abstract type="a">0</_abstract>
			<_final type="a">0</_final>
			<_concurrency type="a">Sequential</_concurrency>
			<_protection type="a">iPublic</_protection>
			<_static type="a">0</_static>
			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">    OsObjConfigRefType pPrevObj = OsCtrlParam.pLastObjRef; /*MISRA RULE 8.13 VIOLATION: This is the reason why the MISRA rule could not be followed in this special case*/%0D
    OsObjConfigRefType pNextObj = OsCtrlParam.pActiveObjRef;%0D
%0D
%0D
    //Do not switch if we are in OS State%0D
    if(OsMemProt_MPUState != OS_MPU_OS_STATE)%0D
    {%0D
        if(pPrevObj != NULL_PTR)%0D
        {%0D
            if((OsAppRefListDyn[pPrevObj-&gt;pAppRef-&gt;AppId]-&gt;AccessId != OsAppRefListDyn[pNextObj-&gt;pAppRef-&gt;AppId]-&gt;AccessId))%0D
            {%0D
                /* If App access check is required */%0D
                %0D
                // OsMemProtPrv_AppMpuSwitch(pPrevObj-&gt;pAppRef-&gt;AccessId,pNextObj-&gt;pAppRef-&gt;AccessId);%0D
                OsMemProtPrv_AppMpuSwitch(OsAppRefListDyn[pPrevObj-&gt;pAppRef-&gt;AppId]-&gt;AccessId,OsAppRefListDyn[pNextObj-&gt;pAppRef-&gt;AppId]-&gt;AccessId);%0D
%0D
                /* If Obj level access switch is enabled */%0D
                OsMemProtPrv_ObjMpuSwitch(pPrevObj-&gt;AccessId,pNextObj-&gt;AccessId);%0D
            }%0D
        }%0D
        else%0D
        {%0D
            OsErr_osApplicationErrorHook(OsDlt_OsInternalService, NULL, E_OS_ILLEGAL_ADDRESS);%0D
        }%0D
    }</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
