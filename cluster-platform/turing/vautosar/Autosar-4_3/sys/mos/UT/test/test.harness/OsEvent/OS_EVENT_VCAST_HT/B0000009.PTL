               /**
                * @brief SetEvent - The service may be called from an interrupt service routine and from the task level, but not from hook routines.
                *
                * @param TaskIndex
                * @param EventMask
                * @return StatusType
                */
               StatusType osSetEvent ( TaskType TaskIndex, EventMaskType EventMask )
               {
1 0     ( )    osSetEvent
                   StatusType Status = (0x01U);
1 1     ( )( ) if(TaskIndex < 21U)
                   {
                   osuint8 CurrentTasksType = TcbTaskRefConfig[TaskIndex]->TasksType;
1 2     ( )( )   if (CurrentTasksType != (uint8)1)
                   {
                       OsErr_osApplicationErrorHook(0x36U,&Status, 1);
                   }
                   else
                   {
                       OsPrvEnterCriticalSection();
                       OsTaskParamRefType pTaskParam = TcbTaskRefConfig[TaskIndex]->TaskParamRef;
                       pTaskParam->SetEventMask |= EventMask;
1 3     ( )( )     if(pTaskParam->State == 2U)
                       {
1 4     ( )( )       if(0U != (pTaskParam->SetEventMask & pTaskParam->WaitEventMask))
                           {
                               pTaskParam->State = 3;
                               osSchedInsertTask(TaskIndex);
1 5     ( )( )         if(0 != (Os_GetContext() & ((uint16)0x0001 | (uint16)0x0002)))
                               {
1 6     ( )( )           if(0U != OsCtrlParam.RequestScheduler)
                                   {
1 7     ( )( )             if(0U == OsCtrlParam.LockDispatcher)
                                       {
                                           OsPrvExitCriticalSection();
                                           OsStartDispatchMetric(); osDispatchAsm();
                                       }
                                   }
                               }
                           }
                           Status = (0x00U);
                       }
                       else 
1 8     ( )( )       if(pTaskParam->State == 4U)
                       {
                           OsErr_osApplicationErrorHook(0x36U, &Status, 7);
                       }
                       else
                       {
                           Status = (0x00U);
                           //Log this as we didnt do anything here
                           //todo
                       }
                       OsPrvExitCriticalSection();
                   }
                   }
                   else
                   {
                       OsErr_osApplicationErrorHook(0x36U, &Status, 3);
                   }
                   return Status;
               }
               /**
                * @brief SysSetEvent - Internal Function
                *
                * @param TaskIndex
                * @param EventMask
                * @return StatusType
                */
               StatusType osSysSetEvent ( TaskType TaskIndex, EventMaskType EventMask )
               {
2 0     ( )    osSysSetEvent
                   StatusType Status = (0x01U);
2 1     ( )( ) if(TaskIndex < 21U)
                   {
                   osuint8 CurrentTasksType = TcbTaskRefConfig[TaskIndex]->TasksType;
2 2     ( )( )   if (CurrentTasksType != (uint8)1)
                   {
                       OsErr_osApplicationErrorHook(0x36U,&Status, 1);
                   }
                   else
                   {
                       OsPrvEnterCriticalSection();
                       OsTaskParamRefType pTaskParam = TcbTaskRefConfig[TaskIndex]->TaskParamRef;
                       pTaskParam->SetEventMask |= EventMask;
2 3     ( )( )     if(pTaskParam->State == 2U)
                       {
2 4     ( )( )       if(0U != (pTaskParam->SetEventMask & pTaskParam->WaitEventMask))
                           {
                               pTaskParam->State = 3;
                               osSchedInsertTask(TaskIndex);
                           }
                           Status = (0x00U);
                       }
                       else 
2 5     ( )( )       if(pTaskParam->State == 4U)
                       {
                           OsErr_osApplicationErrorHook(0x36U, &Status, 7);
                       }
                       else
                       {
                           Status = (0x00U);
                           /*Log this as we didnt do anything here*/
                           /*todo*/
                       }
                       OsPrvExitCriticalSection();
                   }
                   }
                   else
                   {
                       OsErr_osApplicationErrorHook(0x36U,&Status, 3);
                   }
                   /*todo: api fail status to be updated*/
                   return Status;
               }
               /**
                * @brief ClearEvent - The events of the extended task calling ClearEvent are cleared according to the event mask <Mask>.
                *
                * @param EventMask
                * @return StatusType
                */
               StatusType osClearEvent ( EventMaskType EventMask )
               {
3 0     ( )    osClearEvent
                   StatusType Status = (0x01U);
                   TaskType TaskIndex = 0;
3 1     ( )( ) if(OsCtrlParam.ActiveTaskIndex < 21U)
                   {
                   osuint8 CurrentTasksType = TcbTaskRefConfig[OsCtrlParam.ActiveTaskIndex]->TasksType;
                   OsPrvEnterCriticalSection();
3 2     ( )( )   if(OsCtrlParam.CurrentContext == (uint16)0x0002)
                   {
                       OsErr_osApplicationErrorHook(0x37U, &Status, 2);
                   }
                   else 
3 3     ( )( )     if (CurrentTasksType != (uint8)1)
                   {
                       OsErr_osApplicationErrorHook(0x37U,&Status, 1);
                   }
                   else
                   {
                       TaskIndex = OsCtrlParam.ActiveTaskIndex;
3 4     ( )( )       if(TaskIndex < 21U)
                       {
                           TcbTaskRefConfig[TaskIndex]->TaskParamRef->SetEventMask &= (EventMaskType)(~EventMask);
                       }
                       else
                       {
                       ;
                       }
                       Status = (0x00U);
                   }
                   OsPrvExitCriticalSection();
                   }
                   return Status;
               }
               /**
                * @brief GetEvent - This service returns the current state of all event bits of the task <TaskID>, not the events that the task is waiting for
                *
                * @param TaskIndex
                * @param EventMask
                * @return StatusType
                */
               StatusType osGetEvent ( TaskType TaskIndex, EventMaskRefType Event )
               {
4 0     ( )    osGetEvent
                   StatusType Status = (0x01U);
4 1     ( )( ) if(TaskIndex < 21U)
                   {
                   osuint8 CurrentTasksType = TcbTaskRefConfig[TaskIndex]->TasksType;
4 2     ( )( )   if(((void *)0) == Event)
                   {
                       Status = 10;
                       OsErr_osApplicationErrorHook(0x38U, &Status, 10);
                   }
                   else 
4 3     ( )( )     if (CurrentTasksType != (uint8)1)
                   {
                       OsErr_osApplicationErrorHook(0x38U,&Status, 1);
                   }
                   else
                   {
                       OsTaskParamRefType pTaskParam = TcbTaskRefConfig[TaskIndex]->TaskParamRef; /*MISRA RULE 8.13 VIOLATION: This is the reason why the MISRA rule could not be followed in this special case*/
4 4     ( )( )       if(pTaskParam->State == 4U)
                       {
                           OsErr_osApplicationErrorHook(0x38U, &Status, 7);
                       }
                       else
                       {
                           *Event = pTaskParam->SetEventMask;
                           Status = (0x00U);
                       }
                   }
                   }
                   else
                   {
                       OsErr_osApplicationErrorHook(0x38U, &Status, 3);
                   }
                   return Status;
               }
               /**
                * @brief WaitEvent - The state of the calling task is set to waiting, unless at least one of the events specified in <Mask> has already been set.
                *
                * @param EventMask
                * @return StatusType
                */
               StatusType osWaitEvent ( EventMaskType EventMask )
               {
5 0     ( )    osWaitEvent
                   StatusType Status = (0x01U);
                   TaskType TaskIndex = 0;
                   TaskIndex = OsCtrlParam.ActiveTaskIndex;
5 1     ( )( ) if((TaskIndex < 21U) && (OsCtrlParam.ActiveTaskIndex < 21U))
                   {
                   osuint8 CurrentTasksType = TcbTaskRefConfig[TaskIndex]->TasksType;
                   OsTaskParamRefType pTaskPrm = TcbTaskRefConfig[OsCtrlParam.ActiveTaskIndex]->TaskParamRef; /*MISRA RULE 8.13 VIOLATION: This is the reason why the MISRA rule could not be followed in this special case*/
5 2     ( )( )   if(0U == osCheckInterruptsEnabled())
                   {
                       ;
                       /*SWS_Os_00239
                       Enable Interrupts*/
                       osEnableAllInterrupts();
                       OsErr_osApplicationErrorHook(0x39U, &Status, 12);
                   }
                   OsPrvEnterCriticalSection();
5 3     ( )( )   if(OsCtrlParam.CurrentContext == (uint16)0x0002)
                   {
                       OsErr_osApplicationErrorHook(0x39U, &Status, 2);
                   }
                   else 
5 4     ( )( )     if(pTaskPrm->ResCnt > 0U)
                   {
                       OsErr_osApplicationErrorHook(0x39U,&Status, 6);
                   }
                   else 
5 5     ( )( )       if (CurrentTasksType != (uint8)1)
                   {
                       OsErr_osApplicationErrorHook(0x39U,&Status, 1);
                   }
                   else
                   {
                       /* WaitEvent Implementation Here */
                       OsTaskParamRefType pTaskParam = TcbTaskRefConfig[TaskIndex]->TaskParamRef;
                       pTaskParam->WaitEventMask = EventMask;
5 6     ( )( )         if( 0U == (pTaskParam->SetEventMask & EventMask ))
                       {
                           pTaskParam->State = 2U;
                           osTaskStopHook();
                           osSchedRemoveTask();
                           OsPrvExitCriticalSection();
                           OsStartDispatchMetric(); osDispatchAsm();
                       }
                       Status = (0x00U);
                   }
                   }
                   else
                   {
                       ;
                   }
                   OsPrvExitCriticalSection();
                   return Status;
               }
               /**
                * @brief osSysWaitEvent - The state of the calling task is set to waiting, unless at least one of the events specified in <Mask> has already been set.
                *
                * @param EventMask
                * @return StatusType
                */
               StatusType osSysWaitEvent ( EventMaskType EventMask )
               {
6 0     ( )    osSysWaitEvent
                   StatusType Status = (0x01U);
                   TaskType TaskIndex = 0;
                   TaskIndex = OsCtrlParam.ActiveTaskIndex;
6 1     ( )( ) if((TaskIndex < 21U) && (OsCtrlParam.ActiveTaskIndex < 21U))
                   {
                       osuint8 CurrentTasksType = TcbTaskRefConfig[TaskIndex]->TasksType;
                       OsTaskParamRefType pTaskPrm = TcbTaskRefConfig[OsCtrlParam.ActiveTaskIndex]->TaskParamRef; /*MISRA RULE 8.13 VIOLATION: This is the reason why the MISRA rule could not be followed in this special case*/
                       OsPrvEnterCriticalSection();
6 2     ( )( )   if(OsCtrlParam.CurrentContext == (uint16)0x0002)
                       {
                           OsErr_osApplicationErrorHook(0x39U, &Status, 2);
                       }
                       else 
6 3     ( )( )     if(pTaskPrm->ResCnt > 0U)
                       {
                           OsErr_osApplicationErrorHook(0x39U,&Status, 6);
                       }
                       else 
6 4     ( )( )       if (CurrentTasksType != (uint8)1)
                       {
                           OsErr_osApplicationErrorHook(0x39U,&Status, 1);
                       }
                       else
                       {
                           /* WaitEvent Implementation Here */
                           OsTaskParamRefType pTaskParam = TcbTaskRefConfig[TaskIndex]->TaskParamRef;
                           pTaskParam->WaitEventMask = EventMask;
6 5     ( )( )         if( 0U == (pTaskParam->SetEventMask & EventMask ))
                           {
                               pTaskParam->State = 2U;
                               osTaskStopHook();
                               osSchedRemoveTask();
                               OsCtrlParam.LockDispatcher = 0U;
                           }
                           Status = (0x00U);
                       }
                       OsPrvExitCriticalSection();
                   }
                   else
                   {
                       ;
                   }
                   return Status;
               }
