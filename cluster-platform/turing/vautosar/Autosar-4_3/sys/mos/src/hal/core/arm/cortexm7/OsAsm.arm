;-+--------------------------------------------------------------------------
; macros ;
; ** temp solution as global define is not picked by GHS assembler
;----------------------------------------------------------------------------
.macro OS_CPU_HAL_ASM_SWITCH_STACK pObjRef, StackAddr
    .if osdMPUProtection == 1
        ;Switch Mpu setting for Active Task
        ; Load MPU region number for stack into r1
        ldr    r1, =osdMPUStackRegNum
        ; Write region number to MPU_RNR
        ldr    r2, =OS_INT_MPU_MPU_RNR               ; MPU_RNR
        str    r1, [r2]
        ; Disable the region first
        ldr    r2, =OS_INT_MPU_MPU_RASR              ; MPU_RASR
        mov    r1, #0x0                              ; Region disabled
        str    r1, [r2]
        ; Load StackStartAddress into R1
        ldr    r1, [pObjRef, OffsetOf(OsObjConfigType,StackStartAddress)]
        ; Write base address to MPU_RBAR
        ldr    r2, =OS_INT_MPU_MPU_RBAR              ; MPU_RBAR
        str    r1, [r2]
        ; Load StackRegAttribute into R1
        ldr    r1, [pObjRef, OffsetOf(OsObjConfigType,StackRegAttribute)]
        ; Load StackRegnSizeAndEnable into R3
        ldr    r2, [pObjRef, OffsetOf(OsObjConfigType,StackRegnSizeAndEnable)]
        ; Combine attribute and size/enable
        orr    r1, r1, r2
        ; Write final RASR value
        ldr    r2, =OS_INT_MPU_MPU_RASR              ; MPU_RASR
        str    r1, [r2]
    .endif
    ;switch stack pointer
    mov sp, StackAddr
    dsb    ;data barrier sync
    isb    ;instruction barrier sync
.endm

