asm void osAsmSetISPR(osIntLevelType prioLevel) /* PRQA S 1503 */
{                           /* PRQA S 3406 */
%reg% prioLevel
    mov     1,r10
    ldsr    r10,INTCFG
    stsr    ISPR,r10
    mov     prioLevel,r11
    and     r11,r10
    ldsr    r10,ISPR
%mem prioLevel
    mov     1,r10
    ldsr    r10,INTCFG
    stsr    ISPR,r10
    mov     prioLevel,r11
    and     r11,r10
    ldsr    r10,ISPR
%error
}



