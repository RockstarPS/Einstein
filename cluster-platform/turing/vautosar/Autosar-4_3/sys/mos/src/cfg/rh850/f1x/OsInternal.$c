#ifndef OS_INTERNAL_C
#define OS_INTERNAL_C

#include "OsPrivate.h"
#include "OsInternal.h"
#include "intvect.h"


#pragma ghs section text      =".oscode"
void osIntArchInitialize (void)
{
    osuint32 i;
    osuint32 channel;
    
    /*Assuming exceptions will utilize the system stack - To check */
    
    /*setup interrupt controller & IRQs*/
    osSYSREG_EBASE((osuint32)&osExceptionVectorTab);
    osSYSREG_PSW(osGetPSW() | (osuint32)0x00008000UL);
    osSYSREG_INTBP((osuint32)&osIrqVecTab);
    osSYSREG_SCCFG((osuint32)3/* osdSysCallTableMax */);
    osSYSREG_SCBP((osuint32)&OsSysCallVectorTable);

    (*(volatile osuint32*)(0xFFC4C000)) = 0x07FFFFFF;
    
    /* Setup all IRQs */
    for (i=0; i<osdNumberOfConfiguredIRQs; i++)
    {
        channel = osIRQPrioTable[i].osIPNumber;
        if(channel < 32)
        {
          /*max of 16 priority levels bits 0 - 3*/
          osINTC1_EIC(channel) = (osuint16)(0x00C0) | osIRQPrioTable[i].osIPLevel;
        }
        else
        {
          /*max of 16 priority levels bits 0 - 3*/
          channel = channel - 32;
          osINTC2_EIC(channel) = ((osuint16)(0x00C0) | osIRQPrioTable[i].osIPLevel);
        }
        
    }
   
}

void osSetupAndEnableConfiguredInterrupts (void)
{
   osSetupConfiguredInterrupts();
}


void osStartArchTimer (void)
{
    osuint32 channel;
    //#if osdHwTimerNeeded0_OSTM
    osdOSTM_CTL(0) = 0x00; /* configure interval timer mode, no interrupt on timer start */
    osdOSTM_CMP(0) = osdReloadValue; /* set the reload value */
    //#endif
    /*max of 16 priority levels bits 0 - 3*/
    channel = osIRQPrioTable[0].osIPNumber;
    channel = channel - 32;
    osINTC2_EIC(channel) &= (osuint16)~(0x0080);

    osdOSTM_TS(0)  = 0x01; /* start the timer */   
    
    /* No need to activate the interrupt at the IUNIT, this is already 
      done in osInitISRs */
}


void osISRUnhandledException (void)
{
    while(1)
    {
        ;
    }
}

void osUnhandledException (void)
{
    osErrorHook(E_OS_SYS_ABORT);
}


void osMemProtectionFault (void)
{
    osErrorHook(E_OS_SYS_ABORT);
}

void osDataAbortHandler (void)
{
    osErrorHook(E_OS_SYS_ABORT);
}

void osUnhandledDirectBranchException (void)
{
    osErrorHook(E_OS_SYS_ABORT);
}

#pragma ghs section text     = default

#endif
