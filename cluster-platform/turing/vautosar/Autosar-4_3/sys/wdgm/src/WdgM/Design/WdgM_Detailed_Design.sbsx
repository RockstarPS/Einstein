					</IRPYRawContainer>
				</Subjects>
			</IPropertyContainer>
			</_properties>
			<_rmmServerID type="a">-1</_rmmServerID>
			<m_type type="a">90</m_type>
			<m_pModelObject type="r">
				<IHandle type="e">
				</IHandle>
			</m_pModelObject>
			<m_pParent type="s">GUID c4a4fb39-ae03-4256-b646-a74397f587b4</m_pParent>
			<m_name type="p">
				<CGIText type="e">
					<m_str type="a">WdgM will support%0D
1. Alive Supervision%0D
2. Deadline Supervision%0D
Logical monitoring will not be supported. However the component will be designed flexible to accomodate Logical Monitoring in Future based on need.%0D
In Turing A once vector supports Logical Monitoring in WdgM, the WdgExt in Turing A will be obsolete. In case of Turing B WdgM component can be expanded to support Logical Monitoring when need arises.%0D
Alive Supervision and Deadline Supervision logics will be referred from Turing A WdgM and Gen2.%0D
%0D
WdgM will support below configurations%0D
1. Internal Watchdog%0D
2. External Watchdog%0D
3. Internal and External Watchdog.</m_str>
					<m_style type="a">Arial; 10 0 0 0 1 </m_style>
					<m_color type="p">
						<IColor type="e">
							<m_fgColor type="a">0</m_fgColor>
							<m_bgColor type="a">0</m_bgColor>
							<m_bgFlag type="a">0</m_bgFlag>
						</IColor>
					</m_color>
					<m_position type="a">1 0 0  </m_position>
					<m_nIdent type="a">0</m_nIdent>
					<m_bImplicitSetRectPoints type="a">0</m_bImplicitSetRectPoints>
					<m_nOrientationCtrlPt type="a">5</m_nOrientationCtrlPt>
				</CGIText>
			</m_name>
			<m_drawBehavior type="a">4096</m_drawBehavior>
			<m_transform type="a">0.442804 0 0 0.175182 384 203.47 </m_transform>
			<m_bIsPreferencesInitialized type="a">1</m_bIsPreferencesInitialized>
			<m_AdditionalLabel type="p">
				<CGIText type="e">
					<m_style type="a">Arial; 10 0 0 0 1 </m_style>
					<m_color type="p">
						<IColor type="e">
							<m_fgColor type="a">0</m_fgColor>
							<m_bgColor type="a">0</m_bgColor>
							<m_bgFlag type="a">0</m_bgFlag>
						</IColor>
					</m_color>
					<m_position type="a">1 0 0  </m_position>
					<m_nIdent type="a">0</m_nIdent>
					<m_bImplicitSetRectPoints type="a">0</m_bImplicitSetRectPoints>
					<m_nOrientationCtrlPt type="a">1</m_nOrientationCtrlPt>
				</CGIText>
			</m_AdditionalLabel>
			<m_polygon type="a">4 0 3  0 1099  1084 1099  1084 3  </m_polygon>
			<m_nNameFormat type="a">0</m_nNameFormat>
			<m_nIsNameFormat type="a">0</m_nIsNameFormat>
			<_iTempdisplayTextFlag type="a">1</_iTempdisplayTextFlag>
			<m_bIsBoxStyle type="a">0</m_bIsBoxStyle>
			<m_pNoteText type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\froman\fprq10\fcharset0 Tahoma;}}%0D
\viewkind4\uc1\pard\ltrpar\f0\fs16 WdgM will support\par%0D
1. Alive Supervision\par%0D
2. Deadline Supervision\par%0D
Logical monitoring will not be supported. However the component will be designed flexible to accomodate Logical Monitoring in Future based on need.\par%0D
In Turing A once vector supports Logical Monitoring in WdgM, the WdgExt in Turing A will be obsolete. In case of Turing B WdgM component can be expanded to support Logical Monitoring when need arises.\par%0D
Alive Supervision and Deadline Supervision logics will be referred from Turing A WdgM and Gen2.\par%0D
\par%0D
WdgM will support below configurations\par%0D
1. Internal Watchdog\par%0D
2. External Watchdog\par%0D
3. Internal and External Watchdog.\par%0D
}%0D
</_textRTF>
			</IDescription>
			</m_pNoteText>
		</CGIAnnotation>
