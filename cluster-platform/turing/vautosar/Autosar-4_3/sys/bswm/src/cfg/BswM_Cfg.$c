void BswM_Init_Gen(void)
{
	  BswM_Switch_BswM_SfdaRole_MG_SfdARole = 0xFF;
	  BswM_Switch_BswM_SfdaMode_MG_SfdAMode = 0xFF;
	  Request_SwcModeRequest_MG_SfdARole_Role = SFDC_NO_ROLE;
	  Request_SwcModeRequest_BswM_MDGP_MDG_Sfd_NvmBlockStatus_requestedMode = SFD_BLOCKS_NOT_INITIALIZED;
	  BswM_Mode_Notification_currentMode_currentMode = RTE_MODE_EcuM_Mode_STARTUP;  //BswMSwcModeNotification container
}

void BswM_ModeNotificationFct(void)
{
  if(BswM_Switch_BswM_SfdaMode_MG_SfdAMode != 0xFF)
  {
    if(Rte_Switch_Switch_BswM_SfdaMode_MG_SfdAMode(BswM_Switch_BswM_SfdaMode_MG_SfdAMode) == RTE_E_OK)
    {
      BswM_Switch_BswM_SfdaMode_MG_SfdAMode = 0xFF;
    }
  }
  if(BswM_Switch_BswM_SfdaRole_MG_SfdARole != 0xFF)
    {
      if(Rte_Switch_Switch_BswM_SfdaRole_MG_SfdARole(BswM_Switch_BswM_SfdaRole_MG_SfdARole) == RTE_E_OK)
      {
        BswM_Switch_BswM_SfdaRole_MG_SfdARole = 0xFF;
      }
    }
}

void BswM_SwcModeRequestUpdateFct(void)
{
	  uint32 mode;
	  mode = Rte_Mode_Notification_currentMode_currentMode();
	  if (mode != RTE_TRANSITION_EcuM_Mode)
	  {
	    BswM_Mode_Notification_currentMode_currentMode = (Rte_ModeType_EcuM_Mode)mode;
	  }
	  (void)Rte_Read_Request_SwcModeRequest_BswM_MDGP_MDG_Sfd_NvmBlockStatus_requestedMode(&Request_SwcModeRequest_BswM_MDGP_MDG_Sfd_NvmBlockStatus_requestedMode);
	  (void)Rte_Read_Request_SwcModeRequest_MG_SfdARole_Role(&Request_SwcModeRequest_MG_SfdARole_Role);
	  (void)Rte_Read_Request_BswM_Postrun_Ivd_Request_Receive_Request(&Request_BswM_Postrun_Ivd_Request_Receive_Request);
 
} 

BswM_HandleType BswM_Rule_BswMRule_InitSfda(void)
{
  BswM_HandleType retVal = BSWM_NO_ACTION;
  if((BswM_Mode_Notification_currentMode_currentMode == RTE_MODE_EcuM_Mode_RUN) && ((Request_SwcModeRequest_BswM_MDGP_MDG_Sfd_NvmBlockStatus_requestedMode == SFD_BLOCKS_INITIALIZED)))
  {
    if( BswM_DRuleState[BSWM_ID_BswMRule_InitSfda] != BSWM_TRUE )
    {
      BswM_DRuleState[BSWM_ID_BswMRule_InitSfda] = BSWM_TRUE;
      /* Return triggered action list BswM_ActionList_ECUM_1. */
      retVal = BSWM_ID_AL_ECUM_1;
    }
  }
  else
  {
    BswM_DRuleState[BSWM_ID_BswMRule_InitSfda] = BSWM_FALSE;
    /* No false action list configured. */
  }
  return retVal;
}

BswM_HandleType BswM_Rule_BswMRule_UninitSfda(void)
{
  BswM_HandleType retVal = BSWM_NO_ACTION;
  if(BswM_Mode_Notification_currentMode_currentMode == RTE_MODE_EcuM_Mode_POST_RUN)
  {
    if( BswM_DRuleState[BSWM_ID_BswMRule_UninitSfda] != BSWM_TRUE )
    {
      BswM_DRuleState[BSWM_ID_BswMRule_UninitSfda] = BSWM_TRUE;
