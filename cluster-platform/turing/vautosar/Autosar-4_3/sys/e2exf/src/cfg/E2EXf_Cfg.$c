  E2E_UserProfile4BitCheckSumConfigType *ConfigPtr = &InputConfig;
  E2E_UserProfile4BitCheckSumProtectStateType *StatePtr = &InputState_06CD5554;
  uint8 *DataPtr = buffer;
  uint16 index = 0UL;
  Std_ReturnType ret;
  uint8 Data_ID_value = 0U;
  for (index = 0UL; index < inputBufferLength; index++)
  {
    DataPtr[index] = inputBuffer[index];
  }
  ConfigPtr->MinDataLength = E2EXF_EXTENDED_MIN_LENGTH;
  ConfigPtr->MaxDataLength = E2EXF_EXTENDED_MAX_LENGTH;
  ConfigPtr->Framtype = EXTENDED_FRAME_TYPE;
  Data_ID_value = DataPtr[EXTENDED_FRAME_MASK_INDEX];
  DataPtr[EXTENDED_FRAME_MASK_INDEX] |= EXTENDED_FRAME_MASK_VALUE;
  ret = E2E_ProtectUserProfile4BitCheckSumProtect(ConfigPtr, StatePtr, DataPtr, inputBufferLength);
  /*Copy Data to output buffer*/
  DataPtr[EXTENDED_FRAME_MASK_INDEX] = Data_ID_value;
  *bufferLength = inputBufferLength;
  return ret;
}
