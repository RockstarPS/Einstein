Std_ReturnType SecLevel5GetSeed(Dcm_MsgType Buff, Dcm_NegativeResponseCodeType *NegRes)
{
  /*Commented code removed - MISRA snaray12*/
	uint16 clockValue;
	  clockValue = clock();
	  clockValue = (clockValue + 0x17061981u) ^ (clockValue + 0x30101978u);
	  Buff[0] = (clockValue >> 8) & 0xFF;
	  Buff[1] = clockValue & 0xFF;
	  Buff[2] = Buff[0] + Buff[1];
	  *NegRes = DCM_E_POSITIVERESPONSE;
  return DCM_E_OK;
}

Std_ReturnType SecLevel5CmpKey(Dcm_MsgType Buff, Dcm_NegativeResponseCodeType *NegRes)
{
  /*Commented code removed - MISRA snaray12*/
	uint32 key;
	  Std_ReturnType ret_val;
	  static uint32 SecurityLevel5_SeedSend;
	  /*key = 0x69340009 */
	  key = (SecurityLevel5_SeedSend + 0x17061981u) ^ (SecurityLevel5_SeedSend + 0x30101978u);
	  if ((Buff[0] == (uint8) (key >> 24)) && (Buff[1] == (uint8) (key >> 16)) && (Buff[2] == (uint8) (key >> 8))
	      && (Buff[3] == (uint8) (key >> 0)))
	  {
	    ret_val = DCM_E_OK;
	    *NegRes = DCM_E_POSITIVERESPONSE;
	  }
	  else
	  {
	    ret_val = DCM_E_NOT_OK;
	  }
	  SecurityLevel5_SeedSend = 0;
  return DCM_E_OK;
}

