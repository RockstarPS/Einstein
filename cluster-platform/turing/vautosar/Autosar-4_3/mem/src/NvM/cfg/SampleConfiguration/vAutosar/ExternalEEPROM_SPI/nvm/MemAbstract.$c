void MemAbstractMdl_Set_Sample_Element_1(const UInt8 *Ptr)
{
    Arr_u8_15 ElementVal;
    Rte_Read_Sample_Element_1_Value( (UInt8*)ElementVal);
    uint8 Status = 0;
    Rte_Read_rp_SR_MeetMode_MeetModeStatus(&Status);
    if(Status!=1)
    {
        if(FALSE == MemLib_MemCmp(Ptr,(UInt8*)ElementVal,sizeof(Arr_u8_15)))
        {
            Rte_Write_Sample_Element_1_Value(Ptr);
            Rte_Write_pp_SR_JobStatus_JobStatus_Sample_Element_1(2);
            if(MemAbstractManagement[0].WriteState == WRITE_IDLE)
            {
                MemAbstractManagement[0].WriteState = WRITE_PROGRESS;
            }
            else if(MemAbstractManagement[0].WriteState == WRITE_PROGRESS)
            {
                MemAbstractManagement[0].WriteState = WRITE_PENDING;
            }
            else
            {
                /*Do nothing*/
            }
        }
    }
    else
    {
        Rte_Write_pp_SR_JobStatus_JobStatus_Sample_Element_1(1);
    }
}


Std_ReturnType MemAbstractMdl_Get_Sample_Element_1(UInt8* Ptr)
{
     Std_ReturnType status = E_NOT_OK;
     Rte_Read_Sample_Element_1_Value(Ptr);
     if(FALSE != MemAbstractManagement[0].ValidData)
     {
         status = E_OK;
     }
     return (status);
}


