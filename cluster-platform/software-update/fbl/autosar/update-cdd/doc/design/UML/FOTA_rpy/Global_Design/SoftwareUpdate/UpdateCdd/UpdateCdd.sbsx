			<m_name type="p">
				<CGIText type="e">
					<m_str type="a">Activation is asynchronous, the first call will return &quot;busy&quot;. When the activation is done, Activate() return Ok, the system need to restarted.</m_str>
					<m_style type="a">Arial; 10 0 0 0 1 </m_style>
					<m_color type="p">
						<IColor type="e">
							<m_fgColor type="a">0</m_fgColor>
							<m_bgColor type="a">0</m_bgColor>
