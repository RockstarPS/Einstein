; UDS Core configuration parameters

; INI configuration file for UDSCore . 
; fileName : uds_core.ini
; filePath : The configuration file should be in "/tmp/" or "/etc/uds/" . If the file path needs to be changed , update mUdsCoreIniFilePath1 in CUdsCoreComp class.

; /*! udsCore is the container for the configuration values for the uds core. */
[udsCore]

; /*! P2 Server timer - Performance requirement for the server to start with the response message after the reception of a request message . This value is the P2 Server time of default session */
; /*! Range -  1.. 4294967296*/
; /*! Units - milliseconds */
udsP2TimeCountInMs = 50

; /*! P2*Server  timer - Performance requirement for the server to start with the response message after the transmission of a negative response message (indicated via T_Data.con) with negative response code 0x78 (enhanced response timing). This value is the P2*Server  timer of default session*/
; /*! Range -  1.. 4294967296*/
; /*! Units - milliseconds */
udsP2StarTimeCountInMs=4000

; /*! P4 Server timer - The timing parameter P4Server is the time between the reception of a request (T_Data.indication) and the start of transmission of the final response. This value is the P4 Server time of default session */
; /*! Range -  1.. 4294967296*/
; /*! Units - milliseconds */
udsP4TimeCountInMs=300000

; /*! S3Timer - Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message.*/
; /*! Range -  1.. 4294967296*/
; /*! Units - milliseconds */
udsS3TimeCountInMs=5000

; /*! UDS core periodic task time */
; /*! Range -  10..65535 */
; /*! Units - milliseconds */
udsCoreMainFunctionPeriodInMs = 20

; /*! udsCore is the container for the configuration values for the UDS - DoIP TP interface. */
[udsTpDoip]

; /*! ecuSourceAddress  - It defines the logical source address of the ECU */
; /*! Range - 0x0000 - 0xFFFF */
ecuSourceAddress = 0x006F

; /*! Below configuration defines the logical physical address of the client to be accepted by the ECU*/
; /*! noOfPhysicalAddressSupported  - It defines the total number of logical physical address of the client to be accepted by the ECU */;
; /*! Range - 1..255 */ 
noOfPhysicalAddressSupported = 3

; /*! physicalAddress_n -It defines the logical physical address of the client to be accepted by the ECU . "n" - reprents the index of the number of address . range ( 0 .. noOfPhysicalAddressSupported -1) */
; /*! Value : 0x0000 - 0xFFFE . The value 0xFFFF is considered as an Invalid value and if configured the request will not be accepted */
physicalAddress_0 = 0x0F02
physicalAddress_1 = 0x0E80
physicalAddress_2 = 0x0F00

; /*! Below configuration defines the logical functional address of the client to be accepted by the ECU*/
; /*! noOfFunctionalAddressSupported - It defines the total number of logical functional address of the client to be accepted by the ECU */;
; /*! Range - 1..255 */ 
noOfFunctionalAddressSupported = 2

; /*! functionalAddress_n -It defines the logical physical address of the client to be accepted by the ECU . "n" - reprents the index of the number of address . range ( 0 .. noOfFunctionalAddressSupported -1) */
; /*! Value : 0x0000 - 0xFFFE . The value 0xFFFF is considered as an Invalid value and if configured the request will not be accepted */

functionalAddress_0 = 0xE401
functionalAddress_1 = 0xE402

ftoolAddress = 0x0F02
dtoolAddress = 0x0E80
rdiagAddress = 0x0F00
