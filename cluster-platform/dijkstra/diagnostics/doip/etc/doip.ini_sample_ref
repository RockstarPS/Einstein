[NetworkConfiguration]
; ///@brief Network Protocol Supported
; ///@param 0  Disable
; ///@param 1  Enable	
; ///@brief TransportProtocol TCP/IP
TransportProtocolTCP=1		
; ///@brief TransportProtocol UDP
TransportProtocolUDP=1		
		
;
[DoIPRoutingActivation]
; ///@brief Routing Activation Request required from tester tool
; ///@param 0  Not required (Without Routing activation, Directly send Diagnostic message)
; ///@param 1  required (Routing activation should be done before sending Diagnostic message)
DoIPRoutingActivationRequired=1  		
; ///@brief Alive Check required for multiple tester
; ///@param 0  Not required (Alive Check request not required (Single Tester))
; ///@param 1  required (Alive Check request required (Multiple Tester)
DoIPAliveCheckRequired=1	
; ///@brief Routing Activation Type supported by ECU
; ///@param 0  Default Routing Activation Type
DoIPRoutingactivationType=0		
; ///@brief Authentication required for Routing Activation 
; ///@param 0  Not Required (Without Authentication Routing activation will be done)
; ///@param 1  Required (Authentication needs to be verified before Routing activation done - No support Right now)
DoIPAuthenticationRequired=0		
; ///@brief Confirmation required for Routing Activation 
; ///@param 0  Not Required (Without Confirmation Routing activation will be done)
; ///@param 1  Required (Confirmation needs to be verified before Routing activation done - No support Right now)
DoIPConfirmationRequired=0		
;
[DoIPTimers]
; ///@brief Alive Check response timeout in ms
DoIPAliveCheckResponseTimoutMs=10000  		
; ///@brief General_inactivity timeout in ms,If no transmit from PC tool to DOIP stack for the configured time period, the socket will be closed
DoIPGeneralInActivityTimoutMs=10000	
; ///@brief Initial activity timeout in ms 
DoIPInitialInActivityTimoutMs=5000	
; ///@brief VehicleAnnounce timeout in ms 	
DoIPVehicleAnnounceWaitTimeMs=500
; ///@brief VehicleAnnounce Interval timeout in ms 	
DoIPVehicleAnnounceIntervalTimeMs=500

