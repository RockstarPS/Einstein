PROBE_ID: 10
PROBE_UNIT: res_mon_procfs
PROBE_FUNCTION: ResMonProcFs_ProcessInfo
PROBE_LINE: if ( ( membufs[i].flags & 0x00001000 ) == 0x00001000
PROBE_CODE:
if (vcast_test_name_equals("09_nmembuf_def"))
{
    membufs[0].flags = 0;
}

if (vcast_test_name_equals("10_nmembuf_PROT_READ"))
{
    membufs[0].flags = 0x00000100;
}

if (vcast_test_name_equals("11_nmembuf_PROT_READ_WRITE"))
{
    membufs[0].flags = 0x00000100 | 0x00000200;
}

if (vcast_test_name_equals("12_nmembuf_PROT_EXEC"))
{
    membufs[0].flags = 0x00000400;
}

if (vcast_test_name_equals("13_nmembuf_MAP_STACK"))
{
    membufs[0].flags = 0x00001000;
}

if (vcast_test_name_equals("14_nmembuf_MAP_STACK_PG_HWMAPPED"))
{
    membufs[0].flags = 0x00001000 | 0x00400000;
}
END_PROBE_CODE:
