#ifndef _GLIBCXX_VECTOR
#define _GLIBCXX_VECTOR 1

namespace std {

	template <class T>
	class vector {
		public:
			int size()
			{
				return mSize;
			};
			T operator[] (int) {
			
			};
			vector (T *obj) {
				object = obj;
			}
			vector () {
				object = NULL;
			}
			
			int mSize;
			T *object;
	};
}

#endif /* _GLIBCXX_VECTOR */