                  <DESC>
                    <L-2 L="FOR-ALL">///
/// @brief  Close an UCL Channel
///
/// @param[in]  fd  File descriptor returned by the open call
/// @param[out]  ret  UCL_E_OK Successfully closed the channel
///                              @ref UCL_ERR 
///




</L-2>
