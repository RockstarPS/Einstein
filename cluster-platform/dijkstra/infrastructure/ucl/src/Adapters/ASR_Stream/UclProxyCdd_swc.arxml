/// @brief  Close an UCL Channel
///
/// @param[in]  fd  File descriptor returned by the open call
/// @param[out]  ret  UCL_E_OK Successfully closed the channel
///                              @ref UCL_ERR 
///




</L-2>
          </DESC>
          <IS-SERVICE>false</IS-SERVICE>
          <OPERATIONS>
            <CLIENT-SERVER-OPERATION UUID="37F2B28E-D498-4B79-AE2B-02DCE2C1B141">
              <SHORT-NAME>close</SHORT-NAME>
