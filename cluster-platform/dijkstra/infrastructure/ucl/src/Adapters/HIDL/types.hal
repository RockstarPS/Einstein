package android.hardware.ucl@2.0;

typedef int32_t ucl_fd_t;              
typedef uint8_t ucl_ch_t;             

struct ucl_ioctl_notify_info_t
{ 
    struct event_info
    {
        uint8_t  enabled;               
        uint8_t  reserved;             
        uint16_t comp_id;               
        uint32_t event_mask;          
    };   
  event_info[4] event_infoList;

};

struct ucl_ioctl_channel_param_t
{
    uint8_t priority_level;           
    uint8_t security_level;             
    uint16_t time_to_live_ms;           
};


struct  ucl_ioctl_channel_stats_t
{
    struct dl
    {
        uint32_t tx_bytes;              
        uint32_t rx_bytes;              
        uint32_t tx_msgs;               
        uint32_t rx_msgs;             
        uint32_t tx_kbps;               
        uint32_t rx_kbps;               
        uint32_t avg_ack_latency;       
    }dL;                               

    struct il
    {
        uint32_t num_open_channels;     
        uint32_t num_open_fds;          
    }iL;                              
};
