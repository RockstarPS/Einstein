package android.hardware.ucl@2.0;


interface IUclCallback
{

	///
	/// @brief  LinkStatusChanged
	/// 
	/// @param[in]  linkStatus of Ucl @ref UCL_DEFINES
	/// @param[in]  fd File descriptor of the subscribed callback
	///
    oneway LinkStatusChanged(ucl_fd_t fd, int32_t linkStatus);
	///
	/// @brief  DataReceivedNotification
	/// 
	/// @param[in]  fd File descriptor of the subscribed callback
	///
    oneway DataReceivedNotification(ucl_fd_t fd);
	
	///
	/// @brief  MessageTransmitStatus
	/// 
	/// @param[in]  fd File descriptor of the subscribed callback
	/// @param[in] reqId Reqid of the transmitted message
	/// @param[in] txStatus transmit confirmation status @ref UCL_DEFINES
	
     oneway MessageTransmitStatus(ucl_fd_t fd,uint8_t reqId, int32_t txStatus ); 
	 
	///
	/// @brief  ErrorNotification
	/// 
	/// @param[in]  fd File descriptor of the subscribed callback
	/// @param[in] errorCode error status of uckl @ref UCL_DEFINES
	
    oneway ErrorNotification(ucl_fd_t fd, int32_t errorCode);
};

