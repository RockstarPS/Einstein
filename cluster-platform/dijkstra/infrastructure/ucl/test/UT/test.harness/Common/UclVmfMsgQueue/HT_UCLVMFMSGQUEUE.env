const SUclVmfMsgQueueConfig UclVmfMsgQueueConfig[UclVmfMsgQueueCount] =
{
    {
        .pBuffer = Txodi_eventBuffer_new,
        .msgSize = 4,
        .maxMessages = 250
    },
    {
        .pBuffer = Txodi_unsubscriptionBuffer_new,
        .msgSize = 9,
        .maxMessages = 250
    },
    {
        .pBuffer = Txodi_rx_arrayBuffer_new,
        .msgSize = 256,
        .maxMessages = 10
    },
    {
        .pBuffer = Txodi_actionBuffer_new,
        .msgSize = 10,
        .maxMessages = 250
    },
    {
        .pBuffer = Txodi_dyn_dataBuffer_new,
        .msgSize = 10,
        .maxMessages = 10
    },
    {
        .pBuffer = Txodi_tx_arrayBuffer_new,
        .msgSize = 256,
        .maxMessages = 10
    },
    {
        .pBuffer = Txodi_subscriptionBuffer_new,
        .msgSize = 9,
        .maxMessages = 250
    },
    {
        .pBuffer = Txodi_activationBuffer_new,
        .msgSize = 1,
        .maxMessages = 10
    }
};

//---------------------------------------------------------------------------------------------------------------------
/// @brief  Runtime data for all transmit messages with queues
//---------------------------------------------------------------------------------------------------------------------
SUclVmfMsgQueueRuntime UclVmfMsgQueueRuntime[UclVmfMsgQueueCount];


