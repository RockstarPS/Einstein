static uint8 Txodi_dyn_dataBuffer_new[10 * 10] = { 0x00 };
static uint8 Txodi_tx_arrayBuffer_new[10 * 256] = { 0x00 };
static uint8 Txodi_subscriptionBuffer_new[250 * 9] = { 0x00 };
static uint8 Txodi_activationBuffer_new[10 * 1] = { 0x00 };

#define UclVmfMsgQueueCount	8

//---------------------------------------------------------------------------------------------------------------------
/// @brief  Static configuration for all transmit messages with queues
