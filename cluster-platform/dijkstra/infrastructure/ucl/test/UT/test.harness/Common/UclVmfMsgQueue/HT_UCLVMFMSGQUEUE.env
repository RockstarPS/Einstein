static uint8 Txodi_eventBuffer_new[250 * 4] = { 0x00 };
static uint8 Txodi_unsubscriptionBuffer_new[250 * 9] = { 0x00 };
static uint8 Txodi_rx_arrayBuffer_new[10 * 256] = { 0x00 };
