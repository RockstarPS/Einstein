 Ucl_ReturnType UclALOs_Memcpy( uint8 InstId, void *pDst, void *pSrc, uint32 Size );

 Ucl_ReturnType UclALOs_Memcpy( uint8 InstId, void *pDst, void *pSrc, uint32 Size )
{

Ucl_ReturnType Ret=UCL_E_OK;
 while( Size!=0)
{
*((uint8 *)pDst)=*((uint8 *)pSrc);
Size-=1;
pDst++;
pSrc++;
}
return Ret;
}

uint8 UclGen_Read_Signal1(uint8 *pMsgBuff, uint16 *pBytesCopied, EUclILAdapterDataType returnType);
uint8 UclGen_Read_Signal2(uint8 *pMsgBuff, uint16 *pBytesCopied, EUclILAdapterDataType returnType);
uint8 UclGen_Read_Signal3(uint8 *pMsgBuff, uint16 *pBytesCopied, EUclILAdapterDataType returnType);

uint8 UclGen_Read_Signal1(uint8 *pMsgBuff, uint16 *pBytesCopied, EUclILAdapterDataType returnType)
{
    uint16 data = 0;
  *(&pMsgBuff[0])=0xA1;
  *(&pMsgBuff[1])=0xA2;
  *(&pMsgBuff[2])=0xA3;
  *(&pMsgBuff[3])=0xA4;
  *(&pMsgBuff[4])=0xA5;
  *(&pMsgBuff[5])=0xA6;
  *pBytesCopied+=6;
    return TRUE;
}

uint8 UclGen_Read_Signal2(uint8 *pMsgBuff, uint16 *pBytesCopied, EUclILAdapterDataType returnType)
{
    uint16 data = 0;

 *(&pMsgBuff[0])=0x0;
if(RetAdapterFunc==TRUE)
{
  *(&pMsgBuff[0])=0xA1;


}

  *pBytesCopied+=1;

    return RetAdapterFunc;
}

uint8 UclGen_Read_Signal3(uint8 *pMsgBuff, uint16 *pBytesCopied, EUclILAdapterDataType returnType)
{
    uint16 data = 0;


  *(&pMsgBuff[0])=0xA1;
  *(&pMsgBuff[1])=0xA2;

  *pBytesCopied+=2;


    return TRUE;
}



