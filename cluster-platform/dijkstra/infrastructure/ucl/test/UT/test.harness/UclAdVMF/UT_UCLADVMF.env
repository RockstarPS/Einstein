#include <map>
#include <set>
#include <vector>
#include <Ucl_Types.h>
#include <UclVmfConfig.hpp>

#define UclGen_GxExToDbIdxTableLength    ((uint16)1U)


#define Gx_PowerSystemState_Tx    0xA0
#define Ex_PowerSystemState_Tx    0x00


#define Gx_PowerExtendShutdownTime_Tx    0xA1
#define Ex_PowerExtendShutdownTime_Tx    0x00


#define Gx_PowerKeepSystemAwake_Tx    0xA1
#define Ex_PowerKeepSystemAwake_Tx    0x01

#define Gx_HealthDomainHeartbeat_Tx    0xB0
#define Ex_HealthDomainHeartbeat_Tx    0


#define Gx_HealthDomainFatalError_Tx    0xB0
#define Ex_HealthDomainFatalError_Tx    1
//---------------------------------------------------------------------------------------
// Create an array with Group Ids for all transmit messages, without repetition
//---------------------------------------------------------------------------------------
static const std::set<uint8> TxMessagesGxSet({
    {Gx_PowerSystemState_Tx},
    {Gx_PowerExtendShutdownTime_Tx},
    {Gx_PowerKeepSystemAwake_Tx},
    {Gx_HealthDomainHeartbeat_Tx},
    {Gx_HealthDomainFatalError_Tx},
});
static const std::vector<uint8> TxMessagesGxVector(TxMessagesGxSet.begin(), TxMessagesGxSet.end());
uint8 const * UclGen_GxList = &TxMessagesGxVector[0];    // Group ID list
const uint16 UclGen_GxListLength = static_cast <uint16> (TxMessagesGxVector.size());    // Size of Group ID list



