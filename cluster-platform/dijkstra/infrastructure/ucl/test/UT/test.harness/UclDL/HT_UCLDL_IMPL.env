 Ucl_ReturnType UclALOs_Memcpy( uint8 InstId, void *pDst, void *pSrc, uint32 Size )
{

Ucl_ReturnType Ret=UCL_E_OK;
 while( Size!=0)
{
*((uint8 *)pDst)=*((uint8 *)pSrc);
Size-=1;
pDst++;
pSrc++;
}
return Ret;
}

