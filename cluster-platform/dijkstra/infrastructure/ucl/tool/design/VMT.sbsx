			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_modifiedTime type="a">1.2.1990::0:0:0</_modifiedTime>
			<_value type="a">A2TFalse</_value>
		</ILiteralSpecification>
		<ITag type="e">
			<_id type="a">GUID 7cfd300e-679a-465b-84b6-76777a4f73a3</_id>
			<_name type="a">DATA_SND_IMPLICIT_SEND</_name>
			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 This group attribute defines whether the RTE makes the latest value of the data element available to the receivers implicitly. This attribute may define a default value for all data elements with the stereotype \i &lt;Data&gt;\i0  defined in the \i TransportedInterface.\i0  The value defined can be overwritten by the value defined for a specific data element. The configuration of this attribute\i  \i0 is optional.\par%0D
\par%0D
\b Related References:\b0\par%0D
- AUTOSAR Specifiaction Virtual Functional Bus\par%0D
- Tag &lt;SND_IMPLICIT_SEND&gt; defined for the stereotype \i &lt;data&gt;\i0\par%0D
\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">1.2.1990::0:0:0</_modifiedTime>
