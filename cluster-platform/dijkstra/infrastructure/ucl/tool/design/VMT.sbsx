\viewkind4\uc1\pard\lang1033\f0\fs20 This attribute indicates the thread in which the \i RunnableEx \i0 is supposed to be executed.\lang1031\f1\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
