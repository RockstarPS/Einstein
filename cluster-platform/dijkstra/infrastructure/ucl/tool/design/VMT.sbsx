		<ITag type="e">
			<_id type="a">GUID 17483d55-e67c-459f-9967-dec0bd857cf1</_id>
			<_name type="a">RCV_INIT_VALUE</_name>
			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}%0D
\viewkind4\uc1\pard\fs20 This communication attribute defines the receivers' initial value of the data element. The configuration of this attribute is optional for each data element defined in the \i TransportedInterface\i0 . The value specified her is valid for every receiver as long as the receivers don't overwrite it.\par%0D
\par%0D
\b Related References:\b0\par%0D
- AUTOSAR Specifiaction Virtual Functional Bus\par%0D
- Tag &lt;DATA_RCV_INIT_VALUE&gt; defined for the stereotype \i &lt;TransportedInterface&gt;\i0\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">1.2.1990::0:0:0</_modifiedTime>
			<_typeOf type="r">
				<IHandle type="e">
					<_hm2Class type="a">IType</_hm2Class>
					<_hid type="a">GUID cce07483-f75f-4253-be3e-fbfb8246d2fb</_hid>
				</IHandle>
			</_typeOf>
			<_isOrdered type="a">0</_isOrdered>
