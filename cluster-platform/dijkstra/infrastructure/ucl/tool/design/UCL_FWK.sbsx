\viewkind4\uc1\pard\cf1\f0\fs20 ///\cf0\par%0D
\cf1 /// @brief Ucl Data Layer Message Structure\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// Ucl Message Header \\n\cf0\par%0D
\cf1 /// Bit[7:6] - Security Level \\n\cf0\par%0D
\cf1 /// Bit[5:4] - Priority Level \\n\cf0\par%0D
\cf1 /// Bit[3:1] - Destination Node ID or P2P Message Type \\n\cf0\par%0D
\cf1 /// Bit[0]   - Message Type: Normal Message or P2P Message\cf0\par%0D
\cf1 ///\cf0\f1\par%0D
}%0D
</_textRTF>
			</IDescription>
