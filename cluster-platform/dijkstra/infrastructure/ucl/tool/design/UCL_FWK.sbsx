\viewkind4\uc1\pard\cf1\f0\fs20 ///\cf0\par%0D
\cf1 /// @brief Requested operation completed successfully\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_OK\tab\tab\tab\tab (0u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Requested operation failed\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_NOK\tab\tab\tab\tab (1u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Requested operation cannot be done due to Invalid State\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_INVALID_STATE\tab\tab\tab (2u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Requested operation cannot be done due to Invalid Arguments\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_INVALID_ARGS\tab\tab\tab (3u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Resource Busy\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_BUSY\tab\tab\tab\tab (4u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Buffer Full Error\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_BUFFER_FULL\tab\tab\tab (5u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Requested Operation is not supported\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_NOT_SUPPORTED\tab\tab\tab (6u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Fatal error has happened\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_FATAL\tab\tab\tab\tab (7u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Security Violation. Time Synchronized Counter mismatch\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_SEC_TSC\tab\tab\tab (8u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Security Violation. CMAC mismatch\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_SEC_CMAC\tab\tab\tab (9u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Security Violation. Key negotiation failed\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_SEC_NEGO\tab\tab\tab (10u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief UCL Message transmit request is pending\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_MSG_PENDING\tab\tab\tab (25u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief Expected UCL Message is not received within timeout\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_MSG_MISSING\tab\tab\tab (26u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief UCL Message is acknowledged by the remote peer\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_MSG_ACK\tab\tab\tab (27u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief UCL Message is negatively acknowledged by the remote peer\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_MSG_NACK\tab\tab\tab (28u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief UCL Message \ul acknowledgement\ulnone  is not received within timeout\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_MSG_ACK_TMO\tab\tab\tab (29u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief UCL Link Up\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_LINK_UP\tab\tab\tab (50u)\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf1 /// @brief UCL Link Down\cf0\par%0D
\cf1 ///\cf0\par%0D
\cf2\b #define\cf3\b0  UCL_E_LINK_DOWN\tab\tab\tab (51u)\par%0D
\cf0\f1\par%0D
